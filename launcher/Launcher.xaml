<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Hunt" Width="1160" Height="800" MinWidth="1000" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#111214" Foreground="#D7D5CE"
        FontSize="14">
  <Window.Resources/>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#17181A" BorderBrush="#343436" BorderThickness="0,0,1,0">
      <DockPanel Margin="24,30">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="THE HUNT" FontSize="23" Foreground="#BDBBB3"/>
          <TextBlock Text="无缝联机启动器" FontSize="9" Foreground="#7F8284" Margin="0,10,0,36"/>
          <RadioButton x:Name="HomeNav" GroupName="Navigation" Content="开始游戏" Style="{StaticResource NavigationButton}" IsChecked="True" Margin="0,0,0,8"/>
          <RadioButton x:Name="SettingsNav" GroupName="Navigation" Content="游戏与联机" Style="{StaticResource NavigationButton}" Margin="0,0,0,8"/>
          <RadioButton x:Name="FeatureNav" GroupName="Navigation" Content="功能与玩法" Style="{StaticResource NavigationButton}" Margin="0,0,0,8"/>
          <RadioButton x:Name="ServerNav" GroupName="Navigation" Content="本地与云端开服" Style="{StaticResource NavigationButton}" Margin="0,0,0,8"/>
          <RadioButton x:Name="TrophyNav" GroupName="Navigation" Content="奖杯" Style="{StaticResource NavigationButton}" Margin="0,0,0,8"/>
          <RadioButton x:Name="SaveNav" GroupName="Navigation" Content="存档" Style="{StaticResource NavigationButton}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Height="1" Background="#343B3F" Margin="0,0,0,20"/>
          <TextBlock Text="iytq" FontStyle="Italic" FontSize="21" Foreground="#BDBBB3" Margin="0,0,0,14"/>
          <TextBlock Text="BBport 1.9.6" Foreground="#A8B1B4"/>
          <TextBlock Text="中文 · 独立运行环境" Style="{StaticResource Caption}" Margin="0,8,0,8"/>
          <TextBlock Text="0.1.0-preview.17" FontSize="11" Foreground="#68767D"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,28,34,24">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="HomePage">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="244"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border CornerRadius="9" BorderBrush="#434048" BorderThickness="1" ClipToBounds="True">
<Grid><Grid.Background><ImageBrush ImageSource="@assets/artwork/home-hunter.png" Stretch="UniformToFill" Viewbox="0,0,1,1"/></Grid.Background>
<Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F2111214" Offset="0"/><GradientStop Color="#B2111214" Offset="0.45"/><GradientStop Color="#10111214" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<StackPanel VerticalAlignment="Center" Margin="30,0"><TextBlock Text="B L O O D B O R N E" Foreground="#B0A895" FontSize="11"/>
<TextBlock Text="THE HUNT" FontSize="44" Foreground="#EEE7D9" Margin="0,18,0,12"/>
<TextBlock Text="无缝联机" Foreground="#CBC1AD" FontSize="16"/>
</StackPanel></Grid></Border>
        <Grid Grid.Row="1" Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="#191A1C" BorderBrush="#37383A" BorderThickness="1" CornerRadius="6" Padding="20">
            <StackPanel>
              <TextBlock Text="画面与操作" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="GraphicsSummary" Text="选择本机普通版配置" FontSize="19" Margin="0,10,0,9"/>
              <TextBlock Text="同步本机画质、帧率与按键设置" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#191A1C" BorderBrush="#37383A" BorderThickness="1" CornerRadius="6" Padding="20">
            <StackPanel>
              <TextBlock Text="联机身份" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="AccountSummary" Text="尚未设置" FontSize="19" Margin="0,10,0,9"/>
              <TextBlock x:Name="ServerSummary" Text="填写自己的 BBSC 服务器" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="2,26,2,0">
          <Button x:Name="HomeTrophies" Content="奖杯 · 正在读取" HorizontalAlignment="Left" Margin="0,0,0,18"/>
          <TextBlock Text="准备事项" Foreground="#B4B0A6" Margin="0,0,0,10"/>
          <TextBlock Text="首次启动会复制本机存档。之后无缝版的进度独立保存。&#x0a;两位猎人使用不同的账号，并连接同一个 BBSC 服务。"
                     Foreground="#9CA9AF" TextWrapping="Wrap" LineHeight="24"/>
          <TextBlock x:Name="KitStatus" Text="猎具将在游戏启动时提前准备。" Foreground="#8B8E86" Margin="0,16,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="FeatureSummary" Foreground="#8B8E86" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        </Grid>
        </ScrollViewer>
      </Grid>

<Grid x:Name="TrophyPage" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,18">
<DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="TestTrophyToast" Content="测试提示" ToolTip="预览右上角提示，不修改奖杯记录；游戏运行时返回游戏即可看到。" Margin="0,0,8,0"/><Button x:Name="RefreshTrophies" Content="刷新奖杯"/></StackPanel><TextBlock Text="奖杯" FontSize="28"/></DockPanel>
<TextBlock Text="当前无缝环境 · 包含此环境的所有角色" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
<TextBlock x:Name="TrophySummary" Text="正在读取记录…" FontSize="18" Foreground="#BBA47A"/>
<ProgressBar x:Name="TrophyProgress" Maximum="40" Height="4" Foreground="#BBA47A" Background="#292826" Margin="0,14,0,14"/>
<WrapPanel><RadioButton x:Name="TrophyAll" Content="全部" GroupName="TrophyFilter" IsChecked="True" Margin="0,0,24,0"/>
<RadioButton x:Name="TrophyEarned" Content="已解锁" GroupName="TrophyFilter" Margin="0,0,24,0"/>
<RadioButton x:Name="TrophyLocked" Content="未解锁" GroupName="TrophyFilter"/></WrapPanel>
<TextBlock x:Name="TrophyNotice" TextWrapping="Wrap" Foreground="#A6AAA8" Margin="0,12,0,0"/>
<TextBlock x:Name="TrophySession" Foreground="#CDB789" TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TrophyItems" Margin="0,0,14,0"/></ScrollViewer>
</Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border CornerRadius="8" BorderBrush="#3D3B40" BorderThickness="1" Margin="0,0,0,18" Height="128" ClipToBounds="True">
<Grid><Grid.Background><ImageBrush ImageSource="@assets/artwork/hosting-messengers.png" Stretch="UniformToFill" Viewbox="0,0,1,1"/></Grid.Background>
<Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F8111214" Offset="0"/><GradientStop Color="#CA111214" Offset="0.5"/><GradientStop Color="#20111214" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<StackPanel VerticalAlignment="Center" Margin="24,0"><TextBlock Text="游戏与联机" FontSize="28" Foreground="#E4DDD0"/><TextBlock Text="选择本机游戏与配置，连接同一个无缝服务。" Foreground="#ADA9A0" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
          <StackPanel>
            <TextBlock Text="普通版启动程序  ·  Bloodborne.exe" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickInstall" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="InstallPath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="游戏文件  ·  CUSA03173 1.09 / eboot.bin" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickGame" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="GamePath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="本机画质配置  ·  普通版 bbport.ini" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickGraphics" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="GraphicsPath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="在普通版「高级 → bbport.ini」中找到此文件。" Style="{StaticResource Caption}" Margin="0,6,0,8"/>
            <Border Height="1" Background="#30383C" Margin="0,10,0,0"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="shadNet 合作服务器  ·  主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Shadnet"/>
                <TextBlock Text="BBSC 游戏服务  ·  http(s)://主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Community"/>
                <TextBlock Text="联机账号" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Account"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="shadNet WebAPI  ·  http(s)://主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Webapi"/>
                <TextBlock Text="BBSC Relay  ·  主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Relay"/>
                <TextBlock Text="密码  ·  已保存时留空即可" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="Password"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="以上地址由服务器管理员提供。密码使用当前 Windows 用户加密保存在本机。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,8"/>
            <Button x:Name="SaveSettings" Content="保存设置" HorizontalAlignment="Left" Margin="0,8,0,18"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="FeaturePage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
          <TextBlock Text="功能与玩法" FontSize="26"/>
          <TextBlock Text="保存后下次启动生效。难度数值跟随房主；进度合并会写入客机存档。"
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <TextBlock Text="无缝版暂不支持人偶洗点。请在普通版完成洗点及全部等级分配，正常保存退出后，再导入普通版存档；导入会替换无缝版全部角色进度。"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button x:Name="SaveFeatures" Content="保存功能设置" Margin="0,0,10,8"/>
            <Button x:Name="RecommendFeatures" Content="恢复推荐" Margin="0,0,10,8"/>
            <Button x:Name="ExpandFeatures" Content="展开全部" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock x:Name="FeatureStatus" Text="推荐保留完整合作功能，暂时关闭永久共享进度与敌对 NPC 猎人强化。"
                     Foreground="#B8B2A2" TextWrapping="Wrap" LineHeight="22"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
          <StackPanel x:Name="FeatureItems"/>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="ServerPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border CornerRadius="8" BorderBrush="#3D3B40" BorderThickness="1" Margin="0,0,0,18" Height="128" ClipToBounds="True">
<Grid><Grid.Background><ImageBrush ImageSource="@assets/artwork/hosting-messengers.png" Stretch="UniformToFill" Viewbox="0,0,1,1"/></Grid.Background>
<Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F8111214" Offset="0"/><GradientStop Color="#CA111214" Offset="0.5"/><GradientStop Color="#20111214" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<StackPanel VerticalAlignment="Center" Margin="24,0"><TextBlock Text="本地与云端开服" FontSize="28" Foreground="#E4DDD0"/><TextBlock Text="本机使用内置管理窗口，云端使用已有 SSH 连接。" Foreground="#ADA9A0" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
          <StackPanel>
            <Border BorderBrush="#474644" BorderThickness="1" Padding="18" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="本地无缝开服" FontSize="20" Foreground="#D4D0C2"/>
                <TextBlock Text="打开内置管理窗口，选择本机地址、启动服务并创建账号。退出游戏或关闭启动器不会自动停服；结束开服请在管理窗口停止服务。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="OpenLocalServer" Content="打开本地开服管理" Margin="0,0,10,8"/>
                  <Button x:Name="UseLocalServer" Content="填入本机服务地址" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock Text="按钮读取开服窗口已保存的监听地址。127.0.0.1 仅限同机；同伴使用局域网或 VPN 地址，并使用自己的账号。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="22"/>
              </StackPanel>
            </Border>
            <TextBlock Text="云端服务器管理" FontSize="20"/>
            <Button x:Name="AdminRefresh" Content="刷新云端状态与账号" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <StackPanel x:Name="AdminFields">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="SSH 别名或 用户@主机" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AdminTarget"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="SSH 端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AdminPort" Text="22"/></StackPanel>
              </Grid>
              <TextBlock Text="BBSC Compose 部署目录 · 服务器上的 /opt 路径" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="AdminDirectory"/>
              <TextBlock Text="本机 SSH 私钥路径 · 留空使用 SSH 配置／代理" Style="{StaticResource FieldLabel}"/>
              <DockPanel><Button x:Name="PickAdminIdentity" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="AdminIdentity"/></DockPanel>
              <TextBlock Text="可信 known_hosts 文件 · 留空使用 SSH 默认记录" Style="{StaticResource FieldLabel}"/>
              <DockPanel><Button x:Name="PickAdminKnownHosts" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="AdminKnownHosts"/></DockPanel>
              <CheckBox x:Name="AdminSudo" Content="远端使用 sudo -n（root 通常无需勾选）" Foreground="#D7D5CE" Margin="0,12,0,4"/>
              <TextBlock Text="首次使用请先在终端连接并核对主机指纹。加密私钥需先加入 ssh-agent。不会自动接受未知或变化的指纹。"
                         Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="22" Margin="0,6,0,0"/>
              <TextBlock Text="账号名 · 3–16 位字母、数字、下划线或连字符" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="AdminName"/>
              <TextBlock Text="密码 · 仅用于本次新建／验证，不保存" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="AdminPassword"/>
              <TextBlock Text="邮箱标识 · 新建账号时填写，不能与已有账号重复" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="AdminEmail"/>
            </StackPanel>
            <WrapPanel Margin="0,18,0,0">
              <Button x:Name="AdminCreate" Content="新建账号" Margin="0,0,10,8"/>
              <Button x:Name="AdminVerify" Content="验证账号密码" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="本版支持查看、新建和验证。暂不提供删号、改名或重置密码；验证前请退出该账号的所有游戏。"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="22"/>
            <TextBlock x:Name="AdminStatus" Text="尚未连接服务器。查看状态不会修改服务或账号。"
                       Foreground="#B8B2A2" TextWrapping="Wrap" LineHeight="22" Margin="0,18,0,12"/>
            <Border Background="#191A1C" BorderBrush="#37383A" BorderThickness="1" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="联机账号 · ID / 名称 / 状态" Foreground="#D3D0C5" Margin="0,0,0,8"/>
                <TextBlock x:Name="AdminAccounts" Text="刷新后显示；不读取密码、盐值或令牌。" TextWrapping="Wrap" Foreground="#A6AAA8" LineHeight="24"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="SavePage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
          <TextBlock Text="存档" FontSize="26"/>
          <TextBlock Text="导入普通版进度，或离线转换回普通版。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
          <StackPanel>
            <Expander Header="无缝版 → 普通版" Foreground="#D3D0C5" IsExpanded="True" Margin="0,0,0,24">
              <StackPanel Margin="16,14,16,8">
                <TextBlock Text="自动备份两边存档，在副本中离线转换并检查。可直接导出存档包，或完整备份旧原版后替换。"
                           TextWrapping="Wrap" LineHeight="23" Foreground="#C2C6C5"/>
                <TextBlock Text="当前范围：同一角色，无缝五件各一件。按原版备份逐件恢复原先持有的联机道具，未持有的不补发。已恢复的历史记录及已保存的客机拾取可核对；尚待恢复的世界记录、无可确认道具及仓库存放暂不支持。"
                           TextWrapping="Wrap" LineHeight="22" Foreground="#A6AAA8" Margin="0,8,0,10"/>
                <TextBlock Text="替换原版会回写整份存档目录，包含其他角色；不会合并两个分支的进度。旧原版会完整备份。"
                           TextWrapping="Wrap" LineHeight="22" Foreground="#A6AAA8" Margin="0,0,0,8"/>
                <CheckBox x:Name="ConversionSameRole" Foreground="#D3D0C5" Margin="0,8,0,8">
                  <TextBlock Text="两份存档对应同一角色；本次只验证这个角色，不自动处理其他槽位。" TextWrapping="Wrap"/>
                </CheckBox>
                <WrapPanel>
                  <Button x:Name="ConversionStartExport" Content="导出普通版存档" Margin="0,0,10,10"/>
                  <Button x:Name="ConversionStartReplace" Content="转换并替换原版" Margin="0,0,10,10"/>
                </WrapPanel>
                <TextBlock Text="全程离线，不打开游戏。自动清理两栏中的无缝道具引用；恢复的原版联机道具只放背包，其他装备保持原样。"
                           TextWrapping="Wrap" LineHeight="22" Foreground="#9DA5A8" Margin="0,2,0,8"/>
                <TextBlock Text="导出包保留本次无缝版进度，联机道具已转换为普通版状态。"
                           TextWrapping="Wrap" Foreground="#9DA5A8" Margin="0,0,0,10"/>
                <WrapPanel>
                  <Button x:Name="ConversionOpen" Content="打开本次转换目录" Margin="0,0,8,8"/>
                  <Button x:Name="ConversionOpenOrdinaryBackup" Content="打开原版备份" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock x:Name="ConversionStatus" Text="请确认角色，再选择离线导出或替换。" TextWrapping="Wrap"
                           LineHeight="23" Foreground="#C7C3B6" Margin="0,8,0,6"/>
                <TextBlock x:Name="ConversionPath" TextWrapping="Wrap" FontSize="11" Foreground="#8B9CA4"/>
                <Expander Header="分步诊断（旧任务／排错）" Foreground="#A6AAA8" Margin="0,16,0,0">
                  <StackPanel>
                <CheckBox x:Name="ConversionClearSlots" Foreground="#D3D0C5" Margin="0,6,0,10">
                  <TextBlock Text="已在无缝检查副本中确认：五件道具没有装备在快捷栏或随身物品里。" TextWrapping="Wrap"/>
                </CheckBox>
                <WrapPanel>
                  <Button x:Name="ConversionConvert" Content="4  转换副本" Margin="0,0,8,8"/>
                </WrapPanel>
                <CheckBox x:Name="ConversionConfirmed" Foreground="#D3D0C5" Margin="0,6,0,10">
                  <TextBlock Text="已重载验证：五件无缝道具消失、四件原版道具正常，等级、装备和较新进度均正确。" TextWrapping="Wrap"/>
                </CheckBox>
                <WrapPanel>
                  <Button x:Name="ConversionExport" Content="6  导出存档包" Margin="0,0,8,8"/>
                </WrapPanel>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="ConversionNew" Content="新建诊断任务" Margin="0,0,8,8"/>
                    <Button x:Name="ConversionBaseline" Content="首次检查原版" Margin="0,0,8,8"/>
                    <Button x:Name="ConversionInspect" Content="检查无缝副本" Margin="0,0,8,8"/>
                    <Button x:Name="ConversionVerify" Content="普通版重载验证" Margin="0,0,8,8"/>
                  </WrapPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>
            <Border Background="#191A1C" BorderBrush="#37383A" BorderThickness="1" Padding="20">
              <StackPanel>
                <TextBlock Text="普通版 → 无缝版" FontSize="18" Foreground="#D3D0C5"/>
                <TextBlock Text="首次启动会自动复制普通版存档；之后两边的进度独立保存。普通版进度增加后，可以在这里重新导入。"
                           Foreground="#A6AAA8" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Text="来源 · 普通版存档" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="SourceSavePath" Text="请先在「游戏与联机」选择普通版启动程序。" Foreground="#B8BCB8" TextWrapping="Wrap" LineHeight="22"/>
            <TextBlock Text="目标 · 无缝版独立存档" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="DestinationSavePath" Text="等待读取无缝版存档位置。" Foreground="#B8BCB8" TextWrapping="Wrap" LineHeight="22"/>
            <Border Height="1" Background="#30383C" Margin="0,22,0,20"/>
            <TextBlock Text="导入前请退出两边游戏。" Foreground="#D3D0C5"/>
            <TextBlock Text="导入会替换无缝版的全部角色与进度，不会合并。已有无缝存档会先自动备份，普通版存档保持原样。"
                       Foreground="#A6AAA8" TextWrapping="Wrap" LineHeight="23" Margin="0,8,0,0"/>
            <TextBlock x:Name="SaveSummary" Text="选择普通版程序后，将显示可导入的存档。" Foreground="#B8B5A9"
                       TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,12"/>
            <WrapPanel Margin="0,4,0,12">
              <Button x:Name="ImportSaves" Content="从普通版导入" Background="#7D2837" Foreground="#F4EBDF"
                      BorderBrush="#A24B55" FontWeight="SemiBold" Margin="0,0,10,10"/>
              <Button x:Name="RefreshSaves" Content="刷新状态" Margin="0,0,10,10"/>
              <Button x:Name="OpenSaveBackups" Content="打开备份目录" Margin="0,0,0,10"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="1" BorderBrush="#343D42" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="StatusText" Text="欢迎回来。请先完成游戏与联机设置。" TextWrapping="Wrap" Foreground="#B1BEC4"/>
            <WrapPanel>
              <Button x:Name="OpenLogs" Content="打开日志目录 ↗" Background="Transparent" BorderThickness="0" Padding="0,8,0,0" FontSize="11" Foreground="#8B9CA4"/>
            </WrapPanel>
          </StackPanel>
          <Button x:Name="CheckUpdates" Grid.Column="1" Content="检查更新" Height="38" Padding="16,0" FontSize="13"
                  Background="#282C30" BorderBrush="#727B80" Foreground="#E0E3E2" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="Launch" Grid.Column="2" Content="启动游戏  →" Background="#7D2837" Foreground="#F4EBDF"
                  BorderBrush="#A24B55" Padding="27,16" FontSize="16" FontWeight="SemiBold"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
