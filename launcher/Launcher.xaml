<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Hunt · by iytq" Width="1040" Height="740" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#111214" Foreground="#D7D5CE"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#141517"/><Setter Property="Foreground" Value="#D7D5CE"/>
      <Setter Property="BorderBrush" Value="#3D3E40"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#B5B3AA"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#141517"/><Setter Property="Foreground" Value="#D7D5CE"/>
      <Setter Property="BorderBrush" Value="#3D3E40"/><Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#D1CFC8"/><Setter Property="Background" Value="#202124"/>
      <Setter Property="BorderBrush" Value="#444548"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="NavigationButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#91928F"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="Hover" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="1"/>
            <Border x:Name="SelectedMark" Width="3" HorizontalAlignment="Left" Background="#D0CDC2"
                    Margin="0,8" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="KeyboardFocus" BorderBrush="#AAA89F" BorderThickness="1" Margin="4"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Background" Value="#2C2D30"/><Setter Property="Foreground" Value="#ECE9DF"/>
              <Setter Property="BorderBrush" Value="#4C4D4D"/><Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.05"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyboardFocus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#17181A"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Background="#555653" Margin="2,0">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="3"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#85857E"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#B7B5AD"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9DA5A8"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,16,0,7"/><Setter Property="Foreground" Value="#C2C6C5"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#17181A" BorderBrush="#343436" BorderThickness="0,0,1,0">
      <DockPanel Margin="24,30">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="THE HUNT" FontFamily="Georgia" FontSize="23" Foreground="#BDBBB3"/>
          <TextBlock Text="B B S C   L A U N C H E R" FontSize="9" Foreground="#7F8284" Margin="0,10,0,36"/>
          <RadioButton x:Name="HomeNav" GroupName="Navigation" Content="启动" Style="{StaticResource NavigationButton}" IsChecked="True" Margin="0,0,0,8"/>
          <RadioButton x:Name="SettingsNav" GroupName="Navigation" Content="游戏与联机" Style="{StaticResource NavigationButton}" Margin="0,0,0,8"/>
          <RadioButton x:Name="SaveNav" GroupName="Navigation" Content="存档" Style="{StaticResource NavigationButton}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Height="1" Background="#343B3F" Margin="0,0,0,20"/>
          <TextBlock Text="iytq" FontFamily="Georgia" FontStyle="Italic" FontSize="21" Foreground="#BDBBB3" Margin="0,0,0,14"/>
          <TextBlock Text="BBport 1.9.2" Foreground="#A8B1B4"/>
          <TextBlock Text="中文 · 独立运行环境" Style="{StaticResource Caption}" Margin="0,8,0,8"/>
          <TextBlock Text="0.1.0-preview.2" FontSize="11" Foreground="#68767D"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,28,34,24">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="HomePage">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="244"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Border BorderBrush="#474644" BorderThickness="0,1,0,1" Margin="0,11,0,13"/>
          <Path Data="M 0,0 L 6,6 0,12 -6,6 Z" Fill="#7B7972" Width="12" Height="12"
                Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
          <Path Data="M 0,0 L 6,6 0,12 -6,6 Z" Fill="#7B7972" Width="12" Height="12"
                Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
          <Viewbox Width="226" Height="216" HorizontalAlignment="Right" Margin="0,10,20,10">
            <!-- Original line artwork: bell, orbital rings and engraved hatching. -->
            <Canvas x:Name="BellEmblem" Width="220" Height="220">
              <Ellipse Width="184" Height="184" Canvas.Left="18" Canvas.Top="18" Stroke="#76766F" StrokeThickness="0.65" Opacity="0.65"/>
              <Ellipse Width="170" Height="170" Canvas.Left="25" Canvas.Top="25" Stroke="#555650" StrokeThickness="0.6" StrokeDashArray="1,5"/>
              <Path Data="M110,2 L110,26 M110,194 L110,218 M2,110 L27,110 M193,110 L218,110
                          M42,42 L50,50 M170,170 L178,178 M42,178 L50,170 M170,50 L178,42"
                    Stroke="#6D6D66" StrokeThickness="0.7"/>
              <Path Data="M110,10 L114,16 110,22 106,16 Z M110,198 L114,204 110,210 106,204 Z"
                    Fill="#9C998D" Opacity="0.8"/>
              <Path Data="M99,60 C94,40 126,40 121,60 M103,59 C100,47 120,47 117,59
                          M103,60 L117,60 122,69 98,69 Z"
                    Stroke="#C3C0B4" StrokeThickness="1.1" Fill="#191A1B"/>
              <Path Data="M98,69 C78,78 83,118 64,143 L59,148
                          C78,163 142,163 161,148 L156,143
                          C137,118 142,78 122,69 Z"
                    Stroke="#C3C0B4" StrokeThickness="1.25" Fill="#1C1D1F"/>
              <Path Data="M65,143 C91,153 129,153 155,143
                          M72,136 C94,144 128,144 148,136
                          M84,112 C98,117 125,117 136,111
                          M88,91 C101,96 121,96 132,91
                          M94,77 C104,81 116,81 126,77"
                    Stroke="#8B8C82" StrokeThickness="0.8"/>
              <Path Data="M96,78 C91,99 94,122 78,139 M102,82 C98,106 98,124 87,142
                          M108,84 C107,108 108,126 102,145 M116,83 C120,108 119,128 128,144
                          M123,81 C130,105 127,122 139,141"
                    Stroke="#6C6D65" StrokeThickness="0.65"/>
              <Path Data="M86,100 L91,95 M85,108 L92,101 M84,116 L94,106 M82,125 L94,113
                          M79,133 L94,119 M76,140 L91,126
                          M129,102 L134,106 M127,108 L136,116 M128,116 L140,127 M131,126 L146,138"
                    Stroke="#A09F94" StrokeThickness="0.55" Opacity="0.75"/>
              <Ellipse Width="98" Height="13" Canvas.Left="61" Canvas.Top="145" Stroke="#ACA99E" StrokeThickness="0.9" Fill="#121315"/>
              <Path Data="M106,150 L106,164 C102,171 118,171 114,164 L114,150"
                    Stroke="#C3C0B4" StrokeThickness="1" Fill="#43443D"/>
              <Path Data="M44,99 C36,116 40,137 52,149 M176,99 C184,116 180,137 168,149
                          M36,94 C24,119 32,145 49,159 M184,94 C196,119 188,145 171,159"
                    Stroke="#7D7E74" StrokeThickness="0.6" Opacity="0.85"/>
              <Path Data="M81,183 L139,183 M92,188 L128,188 M103,193 L117,193"
                    Stroke="#A09D92" StrokeThickness="0.65"/>
            </Canvas>
          </Viewbox>
          <StackPanel VerticalAlignment="Center" Margin="5,0,238,0">
            <TextBlock Text="B L O O D B O R N E" FontFamily="Georgia" Foreground="#898B87" FontSize="11"/>
            <TextBlock Text="THE HUNT" FontFamily="Georgia" FontSize="49" Foreground="#D3D0C5" Margin="0,17,0,10"/>
            <TextBlock Text="S E A M L E S S   C O - O P" Foreground="#9D9E97" FontSize="10"/>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Border Width="24" Height="1" Background="#807C70" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="by iytq" FontFamily="Georgia" FontStyle="Italic" Foreground="#B5AFA0" FontSize="14"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="#191A1C" BorderBrush="#37383A" BorderThickness="1" CornerRadius="1" Padding="20">
            <StackPanel>
              <TextBlock Text="画面与操作" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="GraphicsSummary" Text="选择本机普通版配置" FontSize="19" Margin="0,10,0,9"/>
              <TextBlock Text="同步本机画质与帧率设置" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#191A1C" BorderBrush="#37383A" BorderThickness="1" CornerRadius="1" Padding="20">
            <StackPanel>
              <TextBlock Text="联机身份" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="AccountSummary" Text="尚未设置" FontSize="19" Margin="0,10,0,9"/>
              <TextBlock x:Name="ServerSummary" Text="填写自己的 BBSC 服务器" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="2,26,2,0">
          <TextBlock Text="准备事项" Foreground="#B4B0A6" Margin="0,0,0,10"/>
          <TextBlock Text="首次启动会复制本机存档。之后无缝版的进度独立保存。&#x0a;两位猎人使用不同的账号，并连接同一个 BBSC 服务。"
                     Foreground="#9CA9AF" TextWrapping="Wrap" LineHeight="24"/>
          <TextBlock x:Name="KitStatus" Text="猎具将在游戏启动时提前准备。" Foreground="#8B8E86" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        </Grid>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="游戏与联机" FontSize="26"/>
          <TextBlock Text="一次设置，之后从这里直接启动游戏。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
          <StackPanel>
            <TextBlock Text="普通版启动程序  ·  Bloodborne.exe" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickInstall" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="InstallPath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="游戏文件  ·  CUSA03173 1.09 / eboot.bin" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickGame" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="GamePath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="本机画质配置  ·  普通版 bbport.ini" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickGraphics" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="GraphicsPath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="在普通版「高级 → bbport.ini」中找到此文件。" Style="{StaticResource Caption}" Margin="0,6,0,8"/>
            <Border Height="1" Background="#30383C" Margin="0,10,0,0"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="shadNet 合作服务器  ·  主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Shadnet"/>
                <TextBlock Text="BBSC 游戏服务  ·  http(s)://主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Community"/>
                <TextBlock Text="联机账号" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Account"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="shadNet WebAPI  ·  http(s)://主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Webapi"/>
                <TextBlock Text="BBSC Relay  ·  主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Relay"/>
                <TextBlock Text="密码  ·  已保存时留空即可" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="Password"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="以上地址由服务器管理员提供。密码使用当前 Windows 用户加密保存在本机。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,8"/>
            <Button x:Name="SaveSettings" Content="保存设置" HorizontalAlignment="Left" Margin="0,8,0,18"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="SavePage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
          <TextBlock Text="存档" FontSize="26"/>
          <TextBlock Text="把普通版的新进度带入无缝版。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
          <StackPanel>
            <Border Background="#191A1C" BorderBrush="#37383A" BorderThickness="1" Padding="20">
              <StackPanel>
                <TextBlock Text="普通版 → 无缝版" FontSize="18" Foreground="#D3D0C5"/>
                <TextBlock Text="首次启动会自动复制普通版存档；之后两边的进度独立保存。普通版进度增加后，可以在这里重新导入。"
                           Foreground="#A6AAA8" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Text="来源 · 普通版存档" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="SourceSavePath" Text="请先在「游戏与联机」选择普通版启动程序。" Foreground="#B8BCB8" TextWrapping="Wrap" LineHeight="22"/>
            <TextBlock Text="目标 · 无缝版独立存档" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="DestinationSavePath" Text="等待读取无缝版存档位置。" Foreground="#B8BCB8" TextWrapping="Wrap" LineHeight="22"/>
            <Border Height="1" Background="#30383C" Margin="0,22,0,20"/>
            <TextBlock Text="导入前请退出两边游戏。" Foreground="#D3D0C5"/>
            <TextBlock Text="导入会替换无缝版的全部角色与进度，不会合并。已有无缝存档会先自动备份，普通版存档保持原样。"
                       Foreground="#A6AAA8" TextWrapping="Wrap" LineHeight="23" Margin="0,8,0,0"/>
            <TextBlock x:Name="SaveSummary" Text="选择普通版程序后，将显示可导入的存档。" Foreground="#B8B5A9"
                       TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,12"/>
            <WrapPanel Margin="0,4,0,12">
              <Button x:Name="ImportSaves" Content="从普通版导入" Background="#B7B5AD" Foreground="#151618"
                      BorderBrush="#D5D2C8" FontWeight="SemiBold" Margin="0,0,10,10"/>
              <Button x:Name="RefreshSaves" Content="刷新状态" Margin="0,0,10,10"/>
              <Button x:Name="OpenSaveBackups" Content="打开备份目录" Margin="0,0,0,10"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="1" BorderBrush="#343D42" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="StatusText" Text="欢迎回来。请先完成游戏与联机设置。" TextWrapping="Wrap" Foreground="#B1BEC4"/>
            <Button x:Name="OpenLogs" Content="打开日志目录 ↗" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,8,0,0" FontSize="11" Foreground="#8B9CA4"/>
          </StackPanel>
          <Button x:Name="Launch" Grid.Column="1" Content="启动游戏  →" Background="#B7B5AD" Foreground="#151618"
                  BorderBrush="#D5D2C8" Padding="27,16" FontSize="16" FontWeight="SemiBold"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
