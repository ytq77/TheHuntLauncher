<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBSC Launcher · 共赴猎夜" Width="1040" Height="740" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#101315" Foreground="#EBE7DE"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#13181B"/><Setter Property="Foreground" Value="#EBE7DE"/>
      <Setter Property="BorderBrush" Value="#394043"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#D1B47C"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#13181B"/><Setter Property="Foreground" Value="#EBE7DE"/>
      <Setter Property="BorderBrush" Value="#394043"/><Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DED8CB"/><Setter Property="Background" Value="#242A2D"/>
      <Setter Property="BorderBrush" Value="#40474A"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9DA5A8"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,16,0,7"/><Setter Property="Foreground" Value="#C2C6C5"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#151A1D" BorderBrush="#2A3033" BorderThickness="0,0,1,0">
      <DockPanel Margin="24,30">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="BBSC" FontFamily="Georgia" FontSize="37" Foreground="#D1B47C"/>
          <TextBlock Text="S E A M L E S S   C O - O P" FontSize="9" Foreground="#8E999E" Margin="0,8,0,36"/>
          <Button x:Name="HomeNav" Content="狩猎准备" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
          <Button x:Name="SettingsNav" Content="游戏与联机" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Height="1" Background="#343B3F" Margin="0,0,0,20"/>
          <TextBlock Text="BBport 1.9.2" Foreground="#A8B1B4"/>
          <TextBlock Text="中文 · 独立运行环境" Style="{StaticResource Caption}" Margin="0,8,0,8"/>
          <TextBlock Text="0.1.0-preview.1" FontSize="11" Foreground="#68767D"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,28,34,24">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="HomePage">
        <Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border CornerRadius="8" BorderBrush="#3A4245" BorderThickness="1">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#293338" Offset="0"/><GradientStop Color="#171D21" Offset="1"/>
          </LinearGradientBrush></Border.Background>
          <Grid Margin="28">
            <Path Data="M 0,120 L 35,70 60,92 85,30 110,92 135,70 170,120 M 85,30 L 85,0 M 60,45 L 110,45"
                  Stroke="#BD9F68" StrokeThickness="1" Opacity="0.16" Width="190" Height="160"
                  Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="共 赴 猎 夜" FontFamily="Microsoft YaHei UI" FontSize="35" FontWeight="Light"/>
              <TextBlock Text="一场狩猎，不因离别而终止。" Foreground="#B0BBBF" Margin="0,17,0,20"/>
              <TextBlock Text="无缝同行  /  独立存档  /  本机画质" Foreground="#D1B47C" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="#1B2125" BorderBrush="#30383C" BorderThickness="1" CornerRadius="7" Padding="20">
            <StackPanel>
              <TextBlock Text="画面与操作" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="GraphicsSummary" Text="选择本机普通版配置" FontSize="19" Margin="0,10,0,9"/>
              <TextBlock Text="每次启动同步原启动器设置" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#1B2125" BorderBrush="#30383C" BorderThickness="1" CornerRadius="7" Padding="20">
            <StackPanel>
              <TextBlock Text="联机身份" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="AccountSummary" Text="尚未设置" FontSize="19" Margin="0,10,0,9"/>
              <TextBlock x:Name="ServerSummary" Text="填写自己的 BBSC 服务器" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="2,26,2,0">
          <TextBlock Text="猎前须知" Foreground="#D1B47C" Margin="0,0,0,10"/>
          <TextBlock Text="首次启动会复制本机存档。之后无缝版的进度独立保存。&#x0a;两位猎人使用不同的账号，并连接同一个 BBSC 服务。"
                     Foreground="#9CA9AF" TextWrapping="Wrap" LineHeight="24"/>
          <TextBlock x:Name="KitStatus" Text="道具初始化优化版 · 等待实测" Foreground="#83969D" Margin="0,16,0,0"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="游戏与联机" FontSize="26"/>
          <TextBlock Text="一次设置，之后从这里直接开始狩猎。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
          <StackPanel>
            <TextBlock Text="普通版启动程序  ·  Bloodborne.exe" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickInstall" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="InstallPath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="游戏文件  ·  CUSA03173 1.09 / eboot.bin" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickGame" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="GamePath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="本机画质配置  ·  普通版 bbport.ini" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button x:Name="PickGraphics" DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="GraphicsPath" IsReadOnly="True"/></DockPanel>
            <TextBlock Text="在普通版「高级 → bbport.ini」中找到此文件。" Style="{StaticResource Caption}" Margin="0,6,0,8"/>
            <Border Height="1" Background="#30383C" Margin="0,10,0,0"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="shadNet 合作服务器  ·  主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Shadnet"/>
                <TextBlock Text="BBSC 游戏服务  ·  http(s)://主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Community"/>
                <TextBlock Text="联机账号" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Account"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="shadNet WebAPI  ·  http(s)://主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Webapi"/>
                <TextBlock Text="BBSC Relay  ·  主机:端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Relay"/>
                <TextBlock Text="密码  ·  已保存时留空即可" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="Password"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="以上地址由服务器管理员提供。密码使用当前 Windows 用户加密保存在本机。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,8"/>
            <Button x:Name="SaveSettings" Content="保存设置" HorizontalAlignment="Left" Margin="0,8,0,18"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="1" BorderBrush="#343D42" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="StatusText" Text="欢迎回来。请先完成游戏与联机设置。" TextWrapping="Wrap" Foreground="#B1BEC4"/>
            <Button x:Name="OpenLogs" Content="打开日志目录 ↗" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,8,0,0" FontSize="11" Foreground="#8B9CA4"/>
          </StackPanel>
          <Button x:Name="Launch" Grid.Column="1" Content="开始狩猎  →" Background="#C7AA72" Foreground="#16191B"
                  BorderBrush="#E0C48D" Padding="27,16" FontSize="16" FontWeight="SemiBold"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
