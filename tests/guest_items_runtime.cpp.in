#include <array>
#include <cassert>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <string>
#include <string_view>
#include <vector>
using u8=std::uint8_t; using u16=std::uint16_t; using u32=std::uint32_t;
using u64=std::uint64_t; using s32=std::int32_t; using s64=std::int64_t;
#define PS4_SYSV_ABI __attribute__((sysv_abi))
#define LOG_INFO(...) ((void)0)
namespace fmt { template<class... T> std::string format(const char*, T...){return {};}}
constexpr u64 ItemEnableOffset=0x017D9E70, ItemManagerPointerOffset=4, EventFlagManPointerOffset=8;
std::array<u8,0x50> manager{};
std::array<std::array<u8,0xc0>,5> items{};
std::vector<std::pair<u32,u32>> calls;
bool guest=true;
s64 now=2000;
u64 image_base;
template<class T> void put(void* p,size_t o,T v){std::memcpy(static_cast<u8*>(p)+o,&v,sizeof(v));}
template<class T> T ReadValue(u64 p,size_t o){
    if(p==image_base+ItemManagerPointerOffset)return static_cast<T>(reinterpret_cast<u64>(manager.data()));
    if(p==image_base+EventFlagManPointerOffset)return static_cast<T>(1);
    T v{};std::memcpy(&v,reinterpret_cast<void*>(p+o),sizeof(v));return v;
}
bool ReadablePointer(u64 p,size_t n){
    if(p==reinterpret_cast<u64>(manager.data()))return n<=manager.size();
    for(const auto& item:items)if(p==reinterpret_cast<u64>(item.data()))return n<=item.size();
    return false;
}
s64 SteadyNowMs(){return now;}
bool BbscGuestInHostWorld(){return guest;}
bool EnvFlagEnabled(const char*){return true;}
bool BbscGuestCorpseClaimed(u32){return false;}
bool BbscEventFlag(u32 f){return f==500;}
u32 GetCurrentPackedMap(){return 0x19000000;}
u64 PS4_SYSV_ABI EnableItem(u64, u32* id,u32 on){
    calls.emplace_back(*id,on);
    for(auto& item:items)if(ReadValue<u32>(reinterpret_cast<u64>(item.data()),0x20)==*id){
        const auto flags=ReadValue<u16>(reinterpret_cast<u64>(item.data()),0x48);
        put<u16>(item.data(),0x48,static_cast<u16>((flags&~0x40)|(on?0x40:0)));
    }
    return 1;
}
// ACTUAL_FUNCTION
void setup(){
    manager.fill(0);for(auto& i:items)i.fill(0);calls.clear();now+=2000;
    image_base=reinterpret_cast<u64>(&EnableItem)-ItemEnableOffset;
    for(size_t i=0;i<items.size();++i){
        put<u32>(items[i].data(),0x20,static_cast<u32>((i<<4)|3));
        if(i+1<items.size())put<u64>(items[i].data(),0,reinterpret_cast<u64>(items[i+1].data()));
    }
    put<u64>(manager.data(),0x28,reinterpret_cast<u64>(items[0].data()));
}
bool called(u32 id,u32 on){for(auto c:calls)if(c==std::pair{id,on})return true;return false;}
int main(int argc,char** argv){
    assert(argc==2);setup();const std::string_view mode=argv[1];
    if(mode=="closed"){
        // Two closed chests, an open chest, a disabled loose item and a taken chest.
        put<u16>(items[0].data(),0x48,0x101);put<u16>(items[1].data(),0x48,0x101);
        put<u16>(items[2].data(),0x48,0x141);put<u16>(items[3].data(),0x48,1);
        put<u16>(items[4].data(),0x48,0x141);put<s32>(items[4].data(),0x28,500);
        TickBbscGuestItemsPickable();
        assert(!called(0x3,1)&&!called(0x13,1));
        assert(!called(0x23,1)&&called(0x33,1)&&called(0x43,0));
        assert(ReadValue<u16>(reinterpret_cast<u64>(items[0].data()),0x48)==0x101);
        // The native opening action enables the chest: the repair leaves it on.
        put<u16>(items[0].data(),0x48,0x141);calls.clear();now+=2000;
        TickBbscGuestItemsPickable();
        assert(!called(0x3,0)&&!called(0x3,1));
    }else if(mode=="drops"){
        // A loose/enemy drop is still repaired; the corpse path has its own list.
        put<u64>(manager.data(),0x28,0);put<u64>(manager.data(),0x38,reinterpret_cast<u64>(items[0].data()));
        put<u16>(items[0].data(),0x48,1);TickBbscGuestItemsPickable();assert(called(0x3,1));
    }else if(mode=="home"){
        guest=false;TickBbscGuestItemsPickable();assert(calls.empty());
    }else return 2;
    std::cout<<"PASS guest item repair: "<<mode<<'\n';
}
