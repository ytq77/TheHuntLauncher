#include <algorithm>
#include <array>
#include <atomic>
#include <cassert>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <map>
#include <mutex>
#include <ranges>
#include <span>
#include <string_view>
#include <vector>
#define PS4_SYSV_ABI __attribute__((sysv_abi))
#define LOG_INFO(...) ((void)0)
using u8=std::uint8_t;using s8=std::int8_t;using u32=std::uint32_t;
using s32=std::int32_t;using u64=std::uint64_t;using s64=std::int64_t;
struct GuestRegisterSnapshot {u64 rax{},rdi{},rsi{},rdx{},r15{},rbp{},rsp{};};
enum class MemoryProt {CpuRead};
constexpr u64 ItemManagerPointerOffset=0x0553D6E0;
constexpr u64 ItemManPointerOffset=ItemManagerPointerOffset;
constexpr u64 AwardItemLotOffset=0x017DDC50;
u64 image_base=0,manager_address=0;
bool guest=true,filter_patched=true;int awarded=0;s64 event_id=5500;
std::array<u8,32> global{};
std::array<u8,125> own_badges{};
std::vector<std::pair<u64,std::size_t>> regions;
template<std::size_t N>u64 address(std::array<u8,N>& value){
    auto at=reinterpret_cast<u64>(value.data());regions.push_back({at,N});return at;
}
bool ReadablePointer(u64 at,std::size_t bytes){
    for(auto [begin,size]:regions)if(at>=begin && at-begin<=size && bytes<=size-(at-begin))return true;
    return false;
}
bool HasMemoryAccess(u64 at,std::size_t size,MemoryProt){return ReadablePointer(at,size);}
template<class T>T ReadValue(u64 at,std::size_t offset){
    if(at==image_base+0x017DD764)return static_cast<T>(filter_patched?(offset==0?0x90:0xE9):0x0F);
    if(at+offset==image_base+ItemManagerPointerOffset)return static_cast<T>(manager_address);
    assert(ReadablePointer(at+offset,sizeof(T)));T value;std::memcpy(&value,reinterpret_cast<void*>(at+offset),sizeof(T));return value;
}
template<class T>void WriteValue(u64 at,std::size_t offset,T value){assert(ReadablePointer(at+offset,sizeof(T)));std::memcpy(reinterpret_cast<void*>(at+offset),&value,sizeof(T));}
bool BbscGuestInHostWorld(){return guest;}
s32 GetSessionState(){return guest?6:0;}
s32 GetLocalPlayerType(){return 1;}
u64 GetLocalPlayerCharacter(){return 0;}
u64 GetGlobalState(){return reinterpret_cast<u64>(global.data());}
s32 GetCharacterHp(u64){return 100;}
u32 GetCurrentPackedMap(){return 0x17000000;}
bool EnvFlagEnabled(const char*){return true;}
bool InstallGuestCodeHook(void*,std::span<const u8>,u64,void PS4_SYSV_ABI(*)(u64,const GuestRegisterSnapshot*)){return true;}
s64 BbscEventIdOf(u64){return event_id;}
void NoteBbscBossRewardEvent(s64){}
const u8* BbscOwnDreamBaseline(u32 key,const u8*){return key==12101?own_badges.data():nullptr;}
u64 fake_info=0;
u64 PS4_SYSV_ABI Lookup(u64){return fake_info;}
bool IsEbootCodeAddress(u64 at){return at==reinterpret_cast<u64>(&Lookup);}
void PS4_SYSV_ABI Award(u64,s32,u32){++awarded;}
#include "bbsc_personal_rewards.inc"
u8 bbsc_dream_type_skip=0;
std::size_t bbsc_dream_type_next=0;
std::atomic<u64> bbsc_pickup_action_runs{0};
s32 BbscItemFlags(u32){return 0x41;}
// ACTUAL_DECLARATIONS
// ACTUAL_FUNCTIONS

int main(){
    image_base=reinterpret_cast<u64>(&Award)-AwardItemLotOffset;
    filter_patched=false;InstallBbscPersonalDropHook();assert(!bbsc_guest_drop_roll_hook);
    filter_patched=true;InstallBbscPersonalDropHook();assert(bbsc_guest_drop_roll_hook);
    std::array<u8,0x80> manager{};manager_address=address(manager);
    address(global);
    std::array<u8,0x200> actor{},vtable{},row{},info{};
    const auto chr=address(actor),vt=address(vtable),npc=address(row),inf=address(info);
    fake_info=inf;
    WriteValue<u64>(chr,0,vt);WriteValue<u32>(chr,8,123);
    WriteValue<u64>(vt,0x168,reinterpret_cast<u64>(&Lookup));WriteValue<u64>(inf,8,npc);
    WriteValue<s32>(npc,0x2C,10302200);WriteValue<s32>(npc,0x30,-1);
    bbsc_guest_drop_roll_hook=bbsc_guest_drop_pickup_hook=true;
    NoteBbscGuestEnemyDeath(chr);NoteBbscGuestEnemyDeath(chr);
    assert(bbsc_guest_drop_queue.size()==1);
    TickBbscGuestDrops();assert(awarded==1);assert(BbscGuestCorpseClaimed(123));
    TickBbscGuestDrops();assert(awarded==1);
    // The exact real pickup hook substitutes the no-item argument for a duplicate.
    std::array<u8,0x60> corpse{};const auto item=address(corpse);
    WriteValue<u64>(manager_address,0x38,item);WriteValue<u32>(item,0x20,0x12);WriteValue<u32>(item,0x2C,123);
    std::array<u8,4> input_id{};const auto id_ptr=address(input_id);WriteValue<u32>(id_ptr,0,0x12);
    GuestRegisterSnapshot pickup{};pickup.rsi=id_ptr;
    BbscPickupHook(2,&pickup);
    assert(pickup.rsi!=id_ptr && *reinterpret_cast<u32*>(pickup.rsi)==0);
    assert(ReadValue<u32>(id_ptr,0)==0x12);
    // A native lottery reaching its real call boundary, including RNG-empty,
    // prevents fallback; do not infer eligibility from whether a glow exists.
    ResetBbscGuestDrops();std::array<u8,0x300> frame{};const auto fp=address(frame);
    WriteValue<u32>(fp,0,123);GuestRegisterSnapshot native{};native.rbp=fp+0x264;
    BbscNativeCorpseRollHook(0,&native);NoteBbscGuestEnemyDeath(chr);TickBbscGuestDrops();
    assert(awarded==1 && !BbscGuestCorpseClaimed(123));
    pickup.rsi=id_ptr;BbscPickupHook(2,&pickup);assert(pickup.rsi==id_ptr);
    // Late native path cancels an uncommitted fallback.
    ResetBbscGuestDrops();NoteBbscGuestEnemyDeath(chr);BbscNativeCorpseRollHook(0,&native);
    TickBbscGuestDrops();assert(awarded==1);
    // Personal NPC/quest reward, such as the host's historical Djura kill,
    // never reaches generic compensation regardless of the guest missing it.
    ResetBbscGuestDrops();WriteValue<s32>(npc,0x2C,33010);
    NoteBbscGuestEnemyDeath(chr);TickBbscGuestDrops();assert(awarded==1);
    assert(!BbscGuestCorpseClaimed(123));
    WriteValue<s32>(npc,0x2C,10302200);
    // Bosses and failed hooks also leave their existing reward paths untouched.
    WriteValue<u8>(npc,329,0x10);NoteBbscGuestEnemyDeath(chr);assert(bbsc_guest_drop_queue.empty());
    WriteValue<u8>(npc,329,0);bbsc_guest_drop_roll_hook=false;
    NoteBbscGuestEnemyDeath(chr);assert(bbsc_guest_drop_queue.empty());bbsc_guest_drop_roll_hook=true;
    // Session reset retires claims without persisting anything to the character.
    NoteBbscGuestEnemyDeath(chr);guest=false;TickBbscGuestDrops();guest=true;
    assert(!BbscGuestCorpseClaimed(123));assert(bbsc_guest_drop_queue.empty());

    // The actual 5500 type hook must reach weapon checks, while other common
    // quest events remain untouched and a host is never overridden.
    std::array<u8,0x40> condition{};std::array<u8,0xC0> context{};
    const auto cond=address(condition),ctx=address(context);
    WriteValue<s32>(cond,0x28,10000);WriteValue<s8>(cond,0x2C,0);
    GuestRegisterSnapshot check{};check.rdi=cond;check.rdx=ctx;
    BbscDreamTypeCheckHook(0,&check);assert(bbsc_dream_type_skip==1 && (condition[0x10]&1));
    condition[0x10]=0;bbsc_dream_type_skip=0;event_id=5501;
    BbscDreamTypeCheckHook(0,&check);assert(bbsc_dream_type_skip==0 && condition[0x10]==0);
    event_id=5500;guest=false;BbscDreamTypeCheckHook(0,&check);assert(condition[0x10]==0);guest=true;

    // Run the actual map-copy lambda: badge shelves use the guest prejoin
    // baseline, while starter sales and unrelated quest/lamp bits stay intact.
    constexpr std::size_t BbscWorldGroupBytes=125;
    // ACTUAL_BADGE_GUARD
    std::array<u8,125> before{},live{};live.fill(0xFF);own_badges.fill(0);
    keep_own_dream_messengers(12101,before.data(),live.data());
    assert(live[0]==0);assert((live[1]&0x40)==0);assert((live[1]&0x80)!=0); // bit 8 is unrelated
    assert(live[8]==0xFF); // untouched map events
    own_badges[0]=0x20;live.fill(0xFF);
    keep_own_dream_messengers(12101,before.data(),live.data());assert((live[0]&0x20)!=0);
    before[0]=0x5A;keep_own_dream_messengers(72101,before.data(),live.data());assert(live==before);
    std::cout<<"Actual prepared shop, native-lottery, reward queue, quest exclusion, pickup argument and reset hooks passed.\n";
}
