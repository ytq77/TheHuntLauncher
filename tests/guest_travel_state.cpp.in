template<class T>T ReadValue(u64 p,size_t offset=0,T fallback={}){
    const auto it=fields.find(p+offset);return it==fields.end()?fallback:static_cast<T>(it->second);
}
template<class T>bool WriteValue(u64 p,size_t offset,T value){fields[p+offset]=static_cast<u64>(value);return true;}
constexpr u64 guest_actor=0x30000, guest_vtable=0x31000;
u64 current_actor=guest_actor;
bool ReadablePointer(u64 p,size_t){return p==global||p==flag_man||p==reinterpret_cast<u64>(bank.data())||
    p==guest_actor||p==guest_vtable;}
