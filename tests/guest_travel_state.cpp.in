    u64 serial{}, room{}, role_epoch{};
    u32 owner{};
    s64 started{};
    bool leaving{};
};
BbscLoadProtectionState landing_scope;
int native_landings=0, position_warps=0, transform_reads=0;
bool native_transform_ready=true;
BbscLoadProtectionState ReadBbscLoadProtection(){return landing_scope;}
bool BbscLoadProtectionSameRole(const BbscLoadProtectionState& scope,u64 current_global){
    return current_global==global && active && scope.role_epoch==active->lineage;
}
u32 BbscRelayHostForPackets(){return auth_owner;}
std::optional<int> ReadCharacterTransform(u64 chr){
    ++transform_reads;
    return native_transform_ready && chr==current_actor ? std::optional{1} : std::nullopt;
}
u64 ArmBbscLoadProtection(BbscLoadProtectionKind kind) {
    if(kind!=BbscLoadProtectionKind::Travel) return 0;
    landing_scope={landing_scope.serial+1,auth_room,active->lineage,auth_owner,now_ms};
    return landing_scope.serial;
}
u64 BbscLoadProtectionTicket() { return 0; }
void MarkBbscLoadProtectionPlaced(u64, u32) {}
void MarkBbscLoadProtectionPlaced(u64 ticket,u32 map,u64 actor,u64 generation){
    require(ticket==landing_scope.serial&&ticket!=0,"arrival used the wrong transition ticket");
    require(generation==bbsc_character_reload_generation.load(),"arrival used the wrong reload generation");
    require(map==current_map&&actor==GetLocalPlayerCharacter(),"arrival used the wrong map or actor");
    ++native_landings;
}
