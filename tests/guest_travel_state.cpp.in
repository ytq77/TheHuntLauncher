void EndBbscLoadCover(std::string_view){}
void BbscAnnounce(const char16_t*,std::string_view){}
void NativePositionWarp(u64,float*,float*,u32){++position_warps;}
bool IsEbootCodeAddress(u64 p){return p==reinterpret_cast<u64>(&NativePositionWarp);}
