namespace MemoryProt {constexpr int CpuRead=1,CpuWrite=2;}
template<class T> void Put(void* p,size_t at,T x) {std::memcpy(static_cast<u8*>(p)+at,&x,sizeof x);}
template<class T> T Get(const void* p,size_t at) {T x;std::memcpy(&x,static_cast<const u8*>(p)+at,sizeof x);return x;}
bool HasMemoryAccess(u64 p,size_t n,int) {
    if(!p||!n||p+n<p)return false;
    if(denied_pointer&&p<denied_pointer+denied_size&&p+n>denied_pointer)return false;
    MEMORY_BASIC_INFORMATION m{};
    return VirtualQuery(reinterpret_cast<void*>(p),&m,sizeof m)&&m.State==MEM_COMMIT&&
        !(m.Protect&(PAGE_NOACCESS|PAGE_GUARD))&&p+n<=reinterpret_cast<u64>(m.BaseAddress)+m.RegionSize;
}
bool ReadablePointer(u64 p,size_t n){return HasMemoryAccess(p,n,MemoryProt::CpuRead);}
template<class T> T ReadValue(u64 p,size_t at){return ReadablePointer(p+at,sizeof(T))?Get<T>(reinterpret_cast<void*>(p),at):T{};}
template<class T> bool WriteValue(u64 p,size_t at,T x){if(!HasMemoryAccess(p+at,sizeof(T),MemoryProt::CpuWrite))return false;Put(reinterpret_cast<void*>(p),at,x);return true;}
