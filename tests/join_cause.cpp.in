CloseBbscJoinCauseWindow(1);auto oldlogs=logs.load();CloseBbscJoinCauseWindow(1);CloseBbscJoinCauseWindow(0);assert(logs==oldlogs&&bbsc_join_cause_used==1);
window(2);std::vector<std::thread>threads;for(int i=0;i<8;i++)threads.emplace_back([&,i]{auto r=original;for(int j=0;j<100;j++){r.rsi=i*100+j;BbscJoinCauseHook(1,&r);}});for(auto&t:threads)t.join();assert(bbsc_join_cause_windows[1].count<=32);CloseBbscJoinCauseWindow(2);
for(u64 i=3;i<=8;i++){window(i);BbscJoinCauseHook(0,&original);CloseBbscJoinCauseWindow(i);}window(9);reads=0;BbscJoinCauseHook(0,&original);assert(!reads&&bbsc_join_cause_used==8);
