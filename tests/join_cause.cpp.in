std::array<u8,0xC58>root{};std::array<u8,0x194>timer{};u64 rootptr=(u64)root.data();memcpy(image.data()+0x553B120,&rootptr,8);put(root,0x9E8,u32(2));put(root,0xC50,(u64)timer.data());put(timer,0x190,30.0f);
