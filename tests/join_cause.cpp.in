BbscJ4Diag::activeWindows=0;reads=0;auto start=std::chrono::steady_clock::now();for(int i=0;i<1000000;i++)BbscJoinCauseHook(0,&original);auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();assert(!reads);std::cout<<"actual helper/adapter PASS; disabled/no-window callback ns="<<double(ns)/1000000<<"; fixture stubs hook allocator/log sink only; trampoline reviewed separately\n";
