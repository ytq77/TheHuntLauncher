SetLastError(12345);errno=EDOM;BbscJoinCauseHook(0,&reg);assert(GetLastError()==12345&&errno==EDOM);assert(!memcmp(&reg,&original,sizeof reg));assert(bbsc_join_cause_windows[0].count==1);assert(ReadBbscJoinCausePolicy().create_ms==30000);
BbscJoinCauseHook(0,&reg);assert(bbsc_join_cause_windows[0].count==1);put(obj,0xB4,u32(13));BbscJoinCauseHook(0,&reg);put(obj,0xB4,u32(11));BbscJoinCauseHook(0,&reg);assert(bbsc_join_cause_windows[0].count==3);
auto activeStart=std::chrono::steady_clock::now();for(int i=0;i<100000;i++)BbscJoinCauseHook(0,&reg);
