const auto count=bbsc_join_cause_windows[0].count;fail_copy=true;BbscJoinCauseHook(0,&reg);fail_copy=false;short_copy=true;BbscJoinCauseHook(0,&reg);short_copy=false;reg.rdi=1;BbscJoinCauseHook(0,&reg);reg=original;assert(bbsc_join_cause_windows[0].count==count);
put(obj,0xA8,s32(77));BbscJoinCauseHook(0,&reg);put(obj,0xA8,s32(7));assert(bbsc_join_cause_windows[0].count==count);
