namespace MemoryProt {constexpr int CpuRead=1,CpuWrite=2;}
bool HasMemoryAccess(u64 p,size_t n,int){
 if(!p||!n||p+n<p)return false;
 if(denied_pointer && p<denied_pointer+denied_size && p+n>denied_pointer)return false;
 const auto contains=[&](const auto& memory){const u64 at=reinterpret_cast<u64>(memory.data());return p>=at&&p+n<=at+memory.size();};
 return contains(global)||contains(rules)||contains(actor_storage)||contains(desc)||contains(second_desc)||contains(synthetic_image);
}
bool ReadablePointer(u64 p,size_t n){return HasMemoryAccess(p,n,MemoryProt::CpuRead);}
template<class T>T ReadValue(u64 p,size_t n){if(!ReadablePointer(p+n,sizeof(T)))throw std::runtime_error("invalid read");return Get<T>(reinterpret_cast<void*>(p),n);}
template<class T>bool WriteValue(u64 p,size_t n,const T& x){if(!write_ok||!HasMemoryAccess(p+n,sizeof(T),MemoryProt::CpuWrite))return false;++writes;Put(reinterpret_cast<void*>(p),n,x);return true;}
u64 GetGlobalState(){return active_global;}u64 GetLocalPlayerCharacter(){return actor;}s32 GetCharacterHp(u64 p){return p==actor?hp:-1;}
s32 GetSessionState(){return session;}s32 GetLocalPlayerType(){return type;}u32 GetCurrentPackedMap(){return current_map;}
s64 SteadyNowMs(){return now;}u64 BbscLoadProtectionTicket(){return ticket;}u64 BbscLoadProtectionRoleEpoch(){return role;}
bool IsUsablePackedMap(u32 map){return map && map!=0xffffffff;}bool ResolveLampPoint(s32){return resolve;}bool BbscOwnWorldReadyForGuest(){return own_ready;}
namespace BbscMod {
std::mutex send_mutex;bool private_auth=true;u64 auth_context_ms=1;
struct FakeClient {bool Visibility(){return authenticated;}TheHuntVisibility::Context VisibilityContext(){++auth_reads;if(change_context_read==auth_reads)++context.room;return context;}} auth_client;
