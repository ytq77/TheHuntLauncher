// No executable game bytes: all descriptor inputs here are synthetic.
std::vector<u8> synthetic_image(0x1945000);
u64 GetTickCount64(){return 100000;}
template<class T>void Put(void* p,size_t at,T x){std::memcpy(static_cast<u8*>(p)+at,&x,sizeof(x));}
template<class T>T Get(const void* p,size_t at){T x;std::memcpy(&x,static_cast<const u8*>(p)+at,sizeof(x));return x;}
alignas(16) std::array<u8,0x1800> global{};
alignas(16) std::array<u8,0x100> rules{},slots{},actor_storage{};
alignas(16) std::array<u8,0x80> flag_manager{};
alignas(16) std::array<u8,0x40> sentinel{};
alignas(16) std::array<u8,0xa0> desc{},second_desc{};
u64 image_base{},active_global{},actor{};s64 now=100000;
s32 session=6,type=1,hp=0;u32 current_map=0x19000000;u64 role=4,ticket=20;
bool authenticated=true,resolve=true,own_ready=true,write_ok=true,summon_reload_state_hook_installed=true,bbsc_spectate_active=true;
u64 denied_pointer{};size_t denied_size{};int writes{},auth_reads{},change_context_read{},stage_calls{},covers{};bool stage_select_ok=true,stage_fail=false;
std::atomic<u64> bbsc_character_reload_generation{7};
TheHuntVisibility::Context context;
struct SummonPlacementDescriptor {u32 packed_region{};float x{},y{},z{},heading{};};
struct BbscFollowMessage {u32 packed_map{};float x{},y{},z{},heading{};u32 sequence{};s32 lamp_point{-1};s64 received_ms{};};
std::mutex bbsc_follow_mutex;BbscFollowMessage bbsc_follow_latest;
