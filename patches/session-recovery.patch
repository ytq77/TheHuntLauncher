+        announced = true;
+        BbscAnnounce(u"正在核对世界恢复与游戏备份。\n保存确认完成后，即可继续鸣铃。",
+                     "world recovery awaits a complete native backup save");
+    } else if (!blocked) announced = false;
+    std::scoped_lock lock{bbsc_kit_rows_mutex};
+    for (u32 id : {4016u,4121u,11201u}) {
+        const auto row = BbscParamRow(table, id, GoodsRowSize);
+        if (!row) continue;
+        if (blocked) {
+            if (!saved.contains(id)) saved[id] = ReadValue<u8>(row, 68);
+            WriteValue<u8>(row, 68, 0);
+        } else if (const auto old = saved.find(id); old != saved.end()) {
+            WriteValue<u8>(row, 68, old->second); saved.erase(old);
+        }
+    }
+}
