+void TickBbscRecoveryBellGuard() {
+    if (!BbscWorldRecoveryEnabled()) return;
+    const auto table = BbscActiveGoodsTable();
+    if (!table) return;
+    static std::map<u32,u8> saved;
+    static bool announced = false;
+    const bool blocked = BbscWorldRecoveryWaiting() || bbsc_recovery_title_exit || BbscRecoveryHasPendingSave() ||
+                         (BbscHomeForOwnWorld() && !bbsc_own_world.empty());
