new file mode 100644
--- /dev/null
+++ b/src/loader01.inc
@@ -0,0 +1,41 @@
+/* Included only in the dedicated diagnostic probe.c. */
+#include "startup01.h"
+
+_Noreturn static void th01_stop(const char *reason) {
+    fprintf(stderr, "TH_WIPE_STARTUP_01 refused: %s\n", reason);
+    fflush(stderr);
+    /* A timed-out Worker may still be installing. Do not run CRT/DLL teardown on partial state. */
+    TerminateProcess(GetCurrentProcess(), 78);
+    _exit(78);
+}
+
+static ThWipeStartupFn01 th01_bind(void) {
+    wchar_t expected[32768], actual[32768];
+    HMODULE mod = NULL;
+    if (!Th01PackageModulePath(expected, 32768)) th01_stop("core package path");
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_PIN, expected, &mod))
+        th01_stop("package mod/bbsc.dll is not loaded");
+    DWORD n = GetModuleFileNameW(mod, actual, 32768);
+    if (!n || n >= 32768 || _wcsicmp(actual, expected)) th01_stop("loaded module path");
+    FARPROC proc = GetProcAddress(mod, TH01_EXPORT);
+    if (!proc) th01_stop("fixed R2/01 export missing");
+    MEMORY_BASIC_INFORMATION owner;
+    if (VirtualQuery((const void *)proc, &owner, sizeof(owner)) != sizeof(owner) ||
+        owner.Type != MEM_IMAGE || owner.AllocationBase != mod)
+        th01_stop("fixed export belongs to a different module");
+    return (ThWipeStartupFn01)proc;
+}
+
+static void th01_before_guest(ThWipeStartupFn01 startup, int mode, int preflight,
+                              uint64_t base, uint64_t bytes) {
+    ThWipeReceipt01 receipt = {0};
+    const uint32_t stages = Th01RequiredStages(mode, preflight);
+    if (Th01Mode() != mode || Th01Preflight() != preflight) th01_stop("mode changed before startup");
+    if (startup(base, bytes, stages, &receipt) != 1) th01_stop("Worker refused or timed out");
+    if (receipt.identity != TH01_ID || receipt.image_base != base || receipt.image_bytes != bytes ||
+        receipt.mode != (uint32_t)mode || receipt.stages != stages ||
+        Th01Mode() != mode || Th01Preflight() != preflight)
+        th01_stop("incomplete or mismatched Worker receipt");
+    printf("TH_WIPE_STARTUP_01 ready mode=%d base=0x%" PRIx64 " bytes=%" PRIu64
+           " stages=0x%x\n", mode, base, bytes, (unsigned)receipt.stages);
+}
