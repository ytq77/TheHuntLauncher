+    bbsc_spectate_name = "repeat wipe";
+    bbsc_spectate_since_ms = now;
+    bbsc_spectate_chr = e.local.actor;
+    bbsc_spectate_alone_since_ms = bbsc_spectate_host_back_ms = bbsc_boss_cleared_since_ms = 0;
+    bbsc_spectate_logged_wait = bbsc_spectate_wipe_warped = false;
+    bbsc_spectate_saw_wipe = bbsc_spectate_active = true;
+    bbsc_death_mode = BbscDeathMode::Spectate;
+    LOG_INFO(Debug,"BBSC repeat guest: waiting for owner death reload (episode {}, dead seq {})",e.id,e.evidence.seq);
+    return true;
+}
+
+void Retire() {
