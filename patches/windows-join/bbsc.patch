diff --git a/emulator/src/core/primary.inc b/emulator/src/core/primary.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/primary.inc
@@ -0,0 +1,143 @@
+// Local CUSA03173 1.09 death evaluator and OnEvent_4000. Read only.
+// The saved RBP at each inner site must describe the exact observed entry.
+struct EvalCall {
+    uint64_t frame{}, condition{}, event{}, actor{};
+    uint32_t type{}, mode{};
+    int32_t selector{};
+    uint8_t bit{}, status{};
+    bool send{};
+};
+struct HandlerCall {
+    uint64_t frame{}, event{}, third{}, vm{};
+    bool flagPath{}, flagKnown{}, flag{}, requestPath{};
+};
+template<class T> struct PrimaryStack {
+    T frames[6]{};
+    size_t size{};
+    T* find(uint64_t frame) {
+        return size && frames[size - 1].frame == frame ? &frames[size - 1] : nullptr;
+    }
+    T* start(uint64_t frame) {
+        while (size && frames[size - 1].frame <= frame) {
+            --size;
+            lost("primary-unwind");
+        }
+        if (size == std::size(frames)) { lost("primary-depth"); return nullptr; }
+        auto& f = frames[size++];
+        f = {};
+        f.frame = frame;
+        return &f;
+    }
+};
+struct EvalSummary {
+    uint64_t condition{}, event{}, actor{}, state{}, epoch{}, window{}, written{};
+    uint32_t count{};
+};
+thread_local struct PrimaryLocal {
+    PrimaryStack<EvalCall> evals;
+    PrimaryStack<HandlerCall> handlers;
+    EvalSummary summaries[2];
+    uint64_t generation{};
+} primary;
+
+void primaryPoint(Site point, const GuestRegisterSnapshot& r) {
+    if (!roomActive()) return;
+    const auto generation = epoch();
+    if (primary.generation != generation) {
+        primary = {};
+        primary.generation = generation;
+    }
+    if (point == Site::EVAL) {
+        // One guarded read selects the two local death conditions. All other
+        // entities and modes share the evaluator but need no detailed reads.
+        struct Conditions { int32_t key, type, pad0, pad1, entity, pad2, pad3, mode; } c{};
+        if (!read(r.rdi + 0x10, c)) { lost("eval-read"); return; }
+        if (c.key != 99999 || c.entity != 10000 ||
+            !((c.type == 14 && c.mode == 1) || (c.type == 13 && c.mode == 0))) return;
+        if (c.type == 14) queueEvent(r.rsi);
+        if (auto* f = primary.evals.start(r.rsp - 8)) {
+            f->condition = r.rdi; f->event = r.rsi;
+            f->type = c.type; f->mode = c.mode;
+        }
+        return;
+    }
+    if (point == Site::RESOLVED || point == Site::PRIMARY_MODE ||
+        point == Site::PRIMARY_SEND || point == Site::EVAL_EXIT) {
+        auto* f = primary.evals.find(r.rbp);
+        if (!f || r.r15 != f->condition) return;
+        if (point == Site::RESOLVED) {
+            f->actor = r.rax; f->status = 1;
+        } else if (point == Site::PRIMARY_MODE) {
+            uint64_t modules{}, node{};
+            f->selector = int32_t(r.rdi); f->status = 2;
+            if (!read(r.r13 + 0x18, modules) || !read(modules + 0x30, node) ||
+                (node && !read(node + 0x18, f->bit))) { lost("eval-node"); return; }
+            if (node) { f->status = 3; f->bit &= 1; }
+        } else if (point == Site::PRIMARY_SEND) {
+            f->send = true;
+            emit("primary-send", f->condition, f->event, r.r13, uint32_t(r.rdx), uint32_t(r.rcx), r.rbp);
+        } else {
+            const uint64_t signature = (uint64_t(uint32_t(f->selector)) << 32) |
+                (uint64_t(f->status) << 24) | (uint64_t(f->bit) << 16) |
+                (uint64_t(f->send) << 8) | (r.rax & 0xff);
+            auto& s = primary.summaries[f->type == 14];
+            const auto win = windowId(), now = GetTickCount64();
+            const bool changed = s.condition != f->condition || s.event != f->event ||
+                s.actor != f->actor || s.state != signature || s.epoch != generation || s.window != win;
+            if (changed || now - s.written >= 400 || f->send) {
+                // Count belongs to the preceding summary when the signature changes.
+                if (s.count) emit("eval-repeat", s.condition, s.event, s.state, s.count, s.epoch, s.window);
+                emit(f->type == 14 ? "eval14" : "eval13", f->condition, f->event, f->actor, signature);
+                s = {f->condition, f->event, f->actor, signature, generation, win, now, 0};
+            } else {
+                ++s.count;
+            }
+            --primary.evals.size;
+        }
+        return;
+    }
+    if (point == Site::HANDLER) {
+        if (auto* f = primary.handlers.start(r.rsp - 8)) {
+            f->event = r.rsi; f->third = r.rdx; f->vm = queueVmAt(r.rsi,r.rbp);
+            uint8_t third{};
+            const bool ok = read(r.rdx + 8, third);
+            emit("handler", f->event, f->frame, f->vm, f->third, ok, third);
+        }
+        return;
+    }
+    if (!primary.handlers.size) return;
+    if (point == Site::FLAG_RESULT) {
+        uint64_t caller{}, parent{};
+        if (!read(r.rbp + 8, caller)) { lost("flag-caller-read"); return; }
+        if (caller != base + 0x1381402) return;
+        if (!read(r.rbp, parent)) { lost("flag-parent-read"); return; }
+        auto* f = primary.handlers.find(parent);
+        if (!f || !f->flagPath) { lost("flag-frame"); return; }
+        f->flagKnown = true; f->flag = (r.rax & 0xff) != 0;
+        emit("flag-result", f->event, f->frame, f->flag);
+        return;
+    }
+    auto* f = primary.handlers.find(r.rbp);
+    if (!f) return;
+    if (point == Site::FLAG_PATH) {
+        f->flagPath = true;
+        emit("flag-tested", f->event, f->frame);
+    } else if (point == Site::REQUEST_PATH) {
+        f->requestPath = true;
+        uint64_t manager{}; int32_t request{};
+        const bool ok = read(r.rax + 0x10, manager) && read(manager + 8, request);
+        emit("request-tested", f->event, f->frame, ok, uint32_t(request));
+    } else if (point == Site::EARLY || point == Site::ACCEPT) {
+        // Native taken edges decide the reason. 0 is incomplete provenance,
+        // 1 means flag 4000, 2 means third argument, 3 means signed request.
+        unsigned reason = 0;
+        if (point == Site::EARLY) {
+            if (f->requestPath) reason = 3;
+            else if (f->flagKnown && f->flag) reason = 1;
+            else if (!f->flagPath || f->flagKnown) reason = 2;
+        }
+        emit(point == Site::EARLY ? "handler-reject" : "handler-accept",
+             f->event, f->frame, f->vm, reason, f->flagPath, f->flagKnown);
+        --primary.handlers.size;
+    }
+}
diff --git a/emulator/src/core/return_observer.inc b/emulator/src/core/return_observer.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/return_observer.inc
@@ -0,0 +1,183 @@
+// Included inside ThWipe01 in the generated field unit. Only the admitted game thread owns rwPending.
+std::atomic<DWORD> rwGameThread{};
+std::atomic<uint64_t> rwVersion{}, rwLive{};
+std::atomic<unsigned> rwClosed{}; // 1 after menu/leave, 2 after the following unauthenticated tick
+std::atomic<bool> rwMenuReady{};
+struct RwPending {
+    Identity host{};
+    u64 id{}, task{}, wrapper{}, lamp{}, bornAt{}, lastFrame{}, lastRead{};
+    bool worldSeen{}, admitted{};
+};
+RwPending rwPending{};
+
+void rwMenuInstalled(bool ok) { rwMenuReady.store(ok); }
+
+u64 rwAdvance(u32 reason, u64 site) {
+    const u64 old = rwVersion.fetch_add(1);
+    auto current = old;
+    if (old && rwLive.compare_exchange_strong(current,0))
+        emit("rw-unknown",old,reason,site);
+    return old + 1;
+}
+void rwCut(u32 reason, u64 site) {
+    if (!running.load(std::memory_order_relaxed)) return;
+    if (reason == 5 || reason == 6) {
+        rwClosed.store(1);
+        RepeatHost::cancel();
+    }
+    rwAdvance(reason,site);
+}
+void rwScopeLost() {
+    if (rwLive.load()) rwCut(3,0);
+}
+void rwOutside() {
+    unsigned closed = 1;
+    rwClosed.compare_exchange_strong(closed,2);
+    rwScopeLost();
+}
+bool rwPointer(u64 p) { return p >= 0x10000 && p <= UINTPTR_MAX - 0x4000; }
+bool rwEqual(u64 p, u64 wanted) {
+    u64 value{};
+    return read(p,value) && value == wanted;
+}
+
+// The factory runs between actor-specific field scopes. Authenticate this new observation directly.
+bool rwHost(Identity& id, u64 world, u64 actor, u32 targetMap) {
+    const auto room = BbscMod::RelayAuthRoom();
+    const auto owner = BbscMod::RelayAuthOwner();
+    u8 own{};
+    s32 slot{};
+    const u64 global = GetGlobalState();
+    if (rwClosed.load() || GetSessionState()!=3 || !room || !owner || owner!=BbscMod::RelayAuthOwnId() ||
+        !BbscMod::RelayAuthPrivate() || GetLocalPlayerType()!=0 || !rwPointer(global) ||
+        !rwPointer(world) || !rwPointer(actor) || !IsUsablePackedMap(targetMap) ||
+        !rwEqual(base+CandidateLocalStatePointerOffset,world) || !rwEqual(world+0x60,actor) ||
+        !read(global+0x1592,own) || own!=1 || !read(global+0x1490,slot) || slot<0 || slot>9) return false;
+    std::unique_lock lock(bbsc_active_save_mutex,std::try_to_lock);
+    if (!lock) return false;
+    id = {room,owner,world,global,actor,bbsc_relay_selection_generation.load(),
+          uint64_t(bbsc_leave_event_ms.load()),bbsc_character_reload_generation.load(),
+          bbsc_active_save_generation,targetMap,slot};
+    return true;
+}
+bool rwDispatch(u64 stageFrame, u64 task, u64& wrapper, u64& stepRet, u64& dispatchRet) {
+    u64 dispatcher{};
+    return rwPointer(stageFrame) && rwPointer(task) && read(stageFrame+8,stepRet) && stepRet==base+0x1938752 &&
+           read(stageFrame,dispatcher) && rwPointer(dispatcher) && read(dispatcher+8,dispatchRet) && dispatchRet==base+0x1955c6e &&
+           rwEqual(stageFrame-8,task) && read(stageFrame-0x10,wrapper) && rwPointer(wrapper) &&
+           rwEqual(wrapper+0x20,task) && rwEqual(task,base+0x5330480) && rwEqual(task+0x20,base+0x53be170);
+}
+bool rwTask(u64 task, u32 state, u32& map, s32& lamp) {
+    u32 phase{}, type{}, sub{};
+    return read(task+0xc,phase) && phase==state && read(task+0xa4,type) && type==3 &&
+           read(task+0xa8,sub) && sub==2 && read(task+0x58,map) && IsUsablePackedMap(map) &&
+           read(task+0xd0,lamp) && lamp>0;
+}
+void rwBirth(const GuestRegisterSnapshot& r) {
+    RepeatHost::factoryEntry();
+    // All callers of this particular factory publication supersede the previous actor occurrence.
+    const auto id = rwAdvance(2,0x18db4e0);
+    u64 ret{}, stageFrame{}, task{}, wrapper{}, stepRet{}, dispatchRet{};
+    if (!rwPointer(r.rbp) || !read(r.rbp+8,ret)) { emit("rw-unknown",id,7,0x18db4e0); return; }
+    if (ret != base+0x1939598) return;
+    u32 map{}; s32 lamp{}; Identity who{};
+    if (GetCurrentThreadId()!=rwGameThread.load() || !read(r.rbp,stageFrame) ||
+        !read(r.rbp-0x10,task) || !rwEqual(r.rbp-0x28,r.rax) || !rwDispatch(stageFrame,task,wrapper,stepRet,dispatchRet) ||
+        !rwTask(task,7,map,lamp)) { emit("rw-unknown",id,7,0x18db4e0,task,r.r12); return; }
+    RepeatHost::birth(task,r.rax,r.r12,map,lamp);
+    if (!rwHost(who,r.rax,r.r12,map)) { emit("rw-unknown",id,3,0x18db4e0,task,r.r12); return; }
+    const auto time = GetTickCount64();
+    rwPending = {who,id,task,wrapper,u64(lamp),time,time,0,false};
+    emit("rw-room",id,who.room,who.owner,who.global,who.map,u64(who.slot));
+    emit("rw-epochs",id,who.save,who.relay,who.leave,who.reload,u64(lamp));
+    emit("rw-stack7",id,ret-base,stepRet-base,dispatchRet-base,task,wrapper);
+    emit("rw-born",id,task,r.r12,r.rax,wrapper,stageFrame);
+    rwLive.store(id);
+    if (rwVersion.load()!=id) {
+        auto expected = id;
+        if (rwLive.compare_exchange_strong(expected,0)) emit("rw-unknown",id,8,0x18db4e0);
+    }
+}
+bool rwFrame(const Identity& who, u64 time) {
+    unsigned outside = 2;
+    rwClosed.compare_exchange_strong(outside,0);
+    if (!rwLive.load()) return false;
+    if (GetCurrentThreadId()!=rwGameThread.load()) { rwCut(4,0); return false; }
+    auto& p = rwPending;
+    if (p.id!=rwLive.load() || who!=p.host || rwClosed.load()) { rwCut(3,0); return false; }
+    if (time-p.lastFrame>500 || time-p.bornAt>30000) { rwCut(4,0); return false; }
+    p.lastFrame = time;
+    return true;
+}
+bool rwAdmit() {
+    auto& p=rwPending;
+    if (p.admitted || (scope.load() && (lastIdentity.room!=p.host.room || lastIdentity.owner!=p.host.owner ||
+        lastIdentity.slot!=p.host.slot || lastIdentity.relay!=p.host.relay || lastIdentity.leave!=p.host.leave ||
+        lastIdentity.save!=p.host.save))) { rwCut(3,0); return false; }
+    p.admitted=true;
+    emit("rw-admit",p.id,lastIdentity.actor,p.host.actor,scope.load());
+    return true;
+}
+void rwWorld(const GuestRegisterSnapshot& r) {
+    const auto id = rwLive.load();
+    if (!id) return;
+    u64 ret{};
+    if (!read(r.rsp,ret)) { rwCut(7,0x17d2f30); return; }
+    if (ret!=base+0x193b5c7) return; // unrelated item updater
+    if (GetCurrentThreadId()!=rwGameThread.load()) { rwCut(4,0x17d2f30); return; }
+    auto& p = rwPending;
+    if (p.id!=id || rwVersion.load()!=id) return;
+    const auto now=GetTickCount64();
+    if (now-p.lastFrame>500 || now-p.bornAt>30000) { rwCut(4,0x17d2f30); return; }
+    if (r.r13!=p.task) { rwCut(1,0x17d2f30); return; }
+    // Check the dispatcher and live owner for every relevant callback. Sample costly model reads at most 10 Hz.
+    u64 wrapper{}, stepRet{}, dispatchRet{};
+    u32 map{}; s32 lamp{}; Identity current{};
+    if (!rwDispatch(r.rbp,r.r13,wrapper,stepRet,dispatchRet) || wrapper!=p.wrapper || !rwTask(r.r13,13,map,lamp) ||
+        map!=p.host.map || u64(lamp)!=p.lamp) { rwCut(7,0x17d2f30); return; }
+    if (!rwHost(current,p.host.world,p.host.actor,map) || current!=p.host) { rwCut(3,0x17d2f30); return; }
+    if (p.worldSeen && now-p.lastRead<100) return;
+    p.lastRead=now;
+    const auto actor=p.host.actor;
+    const bool first=!p.worldSeen;
+    if (first) {
+        if (rwVersion.load()!=id) return;
+        emit("rw-stack13",id,ret-base,stepRet-base,dispatchRet-base,r.r13,wrapper);
+        emit("rw-world13",id,r.r13,actor,current.world,wrapper,r.rbp);
+        p.worldSeen=true;
+    }
+    u64 menu{}, modules{}, data{};
+    s32 menuState{}, hp{};
+    u8 request{};
+    if (!read(base+MenuManPointerOffset,menu) || !rwPointer(menu) || !read(menu+0x804,menuState) ||
+        !read(base+0x0556286b,request) || !read(actor+0x3b0,modules) || !rwPointer(modules) ||
+        !read(modules+0x20,data) || !rwPointer(data) || !read(data+0xf8,hp)) {
+        rwCut(7,0x17d2f30); return;
+    }
+    const auto currentMap = GetCurrentPackedMap();
+    const u32 flags = (currentMap==map ? 1u:0u) | (BbscHostInserted(actor,map) ? 2u:0u) |
+                      (ReadBbscLoadVisual(actor).Ready() ? 4u:0u);
+    if (rwVersion.load()!=id) return;
+    if (first) {
+        emit("rw-state13",id,currentMap,uint32_t(hp),uint32_t(menuState),request,flags);
+    }
+    if (flags!=7 || hp<=0 || request || (menuState!=0 && menuState!=3)) return;
+    auto expected=id;
+    if (!rwVersion.compare_exchange_strong(expected,id+1)) return;
+    expected=id;
+    rwLive.compare_exchange_strong(expected,0);
+    emit("rw-ready",id,currentMap,uint32_t(hp),uint32_t(menuState),request,flags);
+}
+void rwR2(u64 pc, const GuestRegisterSnapshot& r) {
+    if (!running.load(std::memory_order_relaxed)) return;
+    switch (pc) {
+    case 0x17d2f30:
+        if (rwLive.load(std::memory_order_relaxed)) rwWorld(r);
+        return;
+    case 0x13cde30: case 0x1944f23: case 0x1928680: case 0x1938f65:
+    case 0x178d9c0: case 0x1941c20: case 0x1548622:
+    case MultiPlayStopRequestOffset: case MatchingStopTaskEnqueueOffset:
+        rwCut(1,pc);
+        return;
+    }
+}
diff --git a/emulator/src/core/trace.inc b/emulator/src/core/trace.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/trace.inc
@@ -0,0 +1,107 @@
+// Emission is bounded and does no file I/O on the game thread. The writer
+// flushes sequence/loss watermarks even when a producer never finishes a slot.
+constexpr uint64_t capacity = 65536;
+struct Record {
+    uint64_t tick{}, scope{}, args[6]{};
+    DWORD tid{};
+    const char* name{};
+    bool loss{};
+};
+struct Slot { std::atomic<uint64_t> published{}; Record record{}; };
+Slot records[capacity];
+std::atomic<uint64_t> reserved{}, dropped{}, scope{}, stopAfter{};
+std::atomic<uint64_t> frames{}, maxFrameGap{};
+std::atomic<bool> running{};
+thread_local uint64_t callbackScope{};
+uint64_t base{};
+std::atomic<uint64_t> reportAfter{};
+HANDLE traceFile = INVALID_HANDLE_VALUE;
+uint64_t frequency{};
+uint64_t epoch() { return (callbackScope ? callbackScope : scope.load()) >> 32; }
+uint64_t windowId() { return uint32_t(callbackScope ? callbackScope : scope.load()); }
+bool roomActive() { return running.load(std::memory_order_relaxed) && (callbackScope || scope.load()); }
+uint64_t tick() { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
+
+template<class T> bool read(uint64_t address, T& value) {
+    if (address < 0x10000 || address > UINTPTR_MAX - sizeof(T)) return false;
+    SIZE_T bytes{};
+    return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(address),
+                             &value, sizeof(value), &bytes) && bytes == sizeof(value);
+}
+void append(const char* name, bool loss, uint64_t a, uint64_t b, uint64_t c,
+            uint64_t d, uint64_t e, uint64_t f) {
+    if (!running.load(std::memory_order_relaxed)) return;
+    // A finite one-play trace never recycles a producer slot. One atomic
+    // reservation also preserves simultaneous game-thread and relay events.
+    const auto n = reserved.fetch_add(1,std::memory_order_relaxed);
+    if (n >= capacity) {
+        dropped.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    auto& slot = records[n];
+    slot.record = {tick(), callbackScope ? callbackScope : scope.load(),
+                   {a,b,c,d,e,f}, GetCurrentThreadId(), name, loss};
+    slot.published.store(n + 1, std::memory_order_release);
+}
+void emit(const char* name, uint64_t a=0, uint64_t b=0, uint64_t c=0,
+          uint64_t d=0, uint64_t e=0, uint64_t f=0) { append(name,false,a,b,c,d,e,f); }
+void lost(const char* why) { append(why,true,0,0,0,0,0,0); }
+
+bool writeLine(const char* data, int length) {
+    DWORD written{};
+    return length > 0 && length < 512 &&
+        WriteFile(traceFile, data, DWORD(length), &written, nullptr) && written == DWORD(length);
+}
+DWORD WINAPI writeRecords(void*) {
+    char line[512];
+    uint64_t n = 0;
+    bool reported = false;
+    for (;;) {
+        const auto deadline = stopAfter.load();
+        const bool finished = deadline && GetTickCount64() >= deadline;
+        if (finished) running.store(false);
+        const auto high = std::min(reserved.load(),capacity);
+        while (n < high) {
+            auto& slot = records[n];
+            if (slot.published.load(std::memory_order_acquire) != n + 1) break;
+            const auto& v = slot.record;
+            const int len = std::snprintf(line, sizeof(line),
+                "E\t%llu\t%llu\t%lu\t%llu\t%u\t%c\t%s\t%llx\t%llx\t%llx\t%llx\t%llx\t%llx\n",
+                (unsigned long long)n + 1, (unsigned long long)v.tick, v.tid,
+                (unsigned long long)(v.scope >> 32), unsigned(v.scope),
+                v.loss ? '!' : '+', v.name, (unsigned long long)v.args[0],
+                (unsigned long long)v.args[1], (unsigned long long)v.args[2],
+                (unsigned long long)v.args[3], (unsigned long long)v.args[4], (unsigned long long)v.args[5]);
+            if (!writeLine(line,len)) { running.store(false); CloseHandle(traceFile); return 1; }
+            ++n;
+        }
+        const auto report = reportAfter.load();
+        // The checkpoint covers all slots reserved before this writer pass.
+        const bool ready = !reported && report && GetTickCount64() >= report && n == high;
+        const auto watermark = ready ? high : std::min(reserved.load(),capacity);
+        const int len = std::snprintf(line,sizeof(line),"%s\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\n",
+            finished ? "END" : ready ? "CHECKPOINT" : "W", (unsigned long long)tick(), (unsigned long long)n,
+            (unsigned long long)watermark, (unsigned long long)dropped.load(),
+            (unsigned long long)frames.load(), (unsigned long long)maxFrameGap.load());
+        if (!writeLine(line,len) || !FlushFileBuffers(traceFile) || finished) break;
+        reported |= ready;
+        Sleep(250);
+    }
+    running.store(false); CloseHandle(traceFile);
+    return 0;
+}
+bool openTrace() {
+    wchar_t directory[1024]{};
+    const auto length = GetEnvironmentVariableW(L"TH_WIPE_TRACE_DIR",directory,std::size(directory));
+    if (!length || length >= std::size(directory)) return false;
+    const std::filesystem::path dir(directory);
+    if (!dir.is_absolute()) return false;
+    auto path = dir / (L"death01-" + std::to_wstring(GetCurrentProcessId()) + L".tsv");
+    traceFile = CreateFileW(path.c_str(), GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_NEW,
+                            FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (traceFile == INVALID_HANDLE_VALUE) return false;
+    LARGE_INTEGER q{};
+    if (!QueryPerformanceFrequency(&q) || q.QuadPart <= 0) { CloseHandle(traceFile); return false; }
+    frequency = q.QuadPart;
+    return true;
+}
diff --git a/emulator/src/death-queue-01/queue.inc b/emulator/src/death-queue-01/queue.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/death-queue-01/queue.inc
@@ -0,0 +1,536 @@
+// Include inside ThWipe01, after Site and the recorder interface. C++20.
+namespace queue_detail {
+using U = uint64_t;
+using W = uint32_t;
+using Byte = uint8_t;
+
+struct Key {
+    W type, id, arg, mode;
+    bool operator==(const Key&) const = default;
+};
+static U pack(W lo, W hi) { return U(lo) | (U(hi) << 32); }
+static bool scoped(Key k) {
+    if (k.type == 13 || k.type == 14)
+        return k.id == 99999 && k.arg == 10000 && k.mode == 0;
+    if (k.id != 4000) return false;
+    if (k.type == 15) return (k.arg == 0 && k.mode == 1) ||
+                             ((k.arg == 1 || k.arg == 2) && k.mode == 3);
+    return k.mode == 0 && (k.type == 57 || (k.type == 67 && k.arg == 0));
+}
+static void keyRow(U serial, Key k) { emit("Q_KEY", serial, k.type, k.id, k.arg, k.mode); }
+
+enum Name : W { Unknown, Primary, Hp, Solo, TextWait, First, Final, Party };
+struct Label { const char* text; W length, rva; };
+static constexpr Label labels[] = {
+    {"", 0, 0}, {"OnEvent_4000", 12, 0x492e303}, {"OnEvent_4000_Hp", 15, 0x492e2f3},
+    {"SoloPlayDeath", 13, 0x492e333}, {"SoloPlayDeath_TextWait", 22, 0x492e341},
+    {"SoloPlayDeath_1", 15, 0x492e358}, {"SoloPlayDeath_2", 15, 0x492e368},
+    {"PartyGhostDeath", 15, 0x492e378}
+};
+static Name origin(W type, U pc) {
+    if (type == 14 && pc == 0x137d8ef) return Primary;
+    if (type == 13 && pc == 0x137d91b) return Hp;
+    if (type == 57 && (pc == 0x138169a || pc == 0x138176b || pc == 0x138180c)) return Solo;
+    if (type == 67 && pc == 0x1381ce1) return First;
+    if (type != 15) return Unknown;
+    switch (pc) {
+    case 0x13816c2: case 0x13817c4: case 0x138183c: return Solo;
+    case 0x1381724: return Party;
+    case 0x1381c73: return TextWait;
+    case 0x1381d15: case 0x1381dca: return Final;
+    default: return Unknown;
+    }
+}
+static W helperType(bool command, U pc) {
+    if (pc == (command ? 0x132b3bc : 0x132b2c0)) return 15;
+    if (pc == (command ? 0x133663b : 0x13365bf)) return 57;
+    if (pc == (command ? 0x132ceaf : 0x132ce2d)) return 67;
+    if (pc == (command ? 0x1329cf4 : 0x1329c5e)) return 14;
+    if (pc == (command ? 0x1329ebc : 0x1329e26)) return 13;
+    return 0;
+}
+static U relative(U pc) { return pc >= base && pc - base < 0x56d4000 ? pc - base : 0; }
+struct Pair { U first, second; bool operator==(const Pair&) const = default; };
+struct Node { U next, prev, object; bool operator==(const Node&) const = default; };
+static bool links(U addr, const Node& n) {
+    U back{}, forward{};
+    return n.next && n.prev && n.next != addr && n.prev != addr &&
+           read(n.next + 8, back) && back == addr && read(n.prev, forward) && forward == addr;
+}
+static bool listHeader(U list, Pair& h) {
+    return list && read(list + 8, h) && h.first;
+}
+static bool roots(Pair& root) {
+    return read(base + 0x553b0c8, root.first) && root.first &&
+           read(root.first, root.second) && root.second;
+}
+
+struct Object { Key key; W flags; Name name; U owner; bool operator==(const Object&) const = default; };
+// 0 = unrelated, 1 = candidate, -1 = incomplete read/invalid string layout.
+static int commandInfo(U obj, Object& d) {
+    if (!read(obj, d.key)) return -1;
+    if (!scoped(d.key)) return 0;
+    Pair size{};
+    if (!read(obj + 0x10, d.flags) || !read(obj + 0x30, size) || size.first > size.second) return -1;
+    bool knownLength = false;
+    for (const auto& label : labels) knownLength |= label.length == size.first && label.length != 0;
+    if (!knownLength) return 1; // Same-key command, name outside the allowlist.
+    U p = obj + 0x20;
+    if (size.second >= 16 && (!read(p, p) || !p)) return -1;
+    char text[24]{};
+    const unsigned n = static_cast<unsigned>(size.first) + 1;
+    for (unsigned off = 0;; off = (off + 16 > n ? n - 8 : off + 8)) {
+        U part{};
+        if (!read(p + off, part)) return -1;
+        std::memcpy(text + off, &part, 8);
+        if (off + 8 == n) break;
+    }
+    if (text[n - 1] != 0) return -1;
+    for (W i = 1; i < sizeof(labels) / sizeof(labels[0]); ++i)
+        if (labels[i].length == size.first && std::memcmp(text, labels[i].text, n) == 0)
+            d.name = static_cast<Name>(i);
+    return 1;
+}
+static int conditionInfo(U obj, Object& d) {
+    struct Common { U vt, owner; W id, tag; Byte done, once, pad[6]; } h{};
+    static_assert(sizeof(h) == 0x20 && sizeof(Node) == 0x18);
+    if (!read(obj, h)) return -1;
+    d.owner = h.owner;
+    d.flags = h.done | (W(h.once) << 8);
+    d.key = {h.tag, h.id, 0, 0};
+    const U vt = relative(h.vt);
+    if (vt == 0x531ce40 && h.id == 4000 && h.tag == 0) {
+        W delay{}, direction{};
+        if (!read(obj + 0x28, delay) || !read(obj + 0x40, direction) || !read(obj + 0x44, d.key.mode))
+            return -1;
+        delay &= 0x7fffffff;
+        if (direction != 0 || delay >= 0x40400000) return 0;
+        d.key.type = 15;
+        d.key.arg = (delay >= 0x3f800000) + (delay >= 0x40000000);
+    } else if (vt == 0x531cc10 && h.id == 99999 && (h.tag == 13 || h.tag == 14)) {
+        W mode{};
+        if (!read(obj + 0x20, d.key.arg) || !read(obj + 0x2c, mode)) return -1;
+        if (mode != W(h.tag == 14)) return 0;
+    } else if (vt == 0x531d5c0 && h.id == 4000 && h.tag == 57) {
+        if (!read(obj + 0x20, d.key.arg) || !read(obj + 0x24, d.key.mode)) return -1;
+    } else if (vt == 0x531d340 && h.id == 4000 && h.tag == 67) {
+        if (!read(obj + 0x20, d.key.arg)) return -1;
+    } else return 0;
+    return scoped(d.key) ? 1 : 0;
+}
+
+struct Build { U id, fp, callerFp, pc, event; W type; bool conditionSeen; };
+struct Birth {
+    U id, node, obj, list, head, event, nodeVersion, objVersion, gap;
+    Key key; Name name; bool command;
+};
+struct Send { U id, fp, event; Key key; };
+struct Match {
+    U id, fp, event, send, pick, node, desc, sub, vm, target;
+    U nodeVersion, objVersion, gap;
+    W picks, calls; Key key; Name name; bool pickOK;
+};
+struct State {
+    bool active, conflict, primaryAnchor;
+    U epochValue, event;
+    unsigned builders, matches, births;
+    Build build[8];
+    Match match[8];
+    Birth birth[128];
+    Send pending;
+};
+static constinit thread_local State state{};
+static constinit std::atomic<U> serial{}, nodeVersions[8192]{}, objectVersions[8192]{}, gaps{};
+static_assert(std::atomic<U>::is_always_lock_free);
+static unsigned bucket(U p) { return static_cast<unsigned>(((p >> 3) ^ (p >> 16) ^ (p >> 32)) & 8191); }
+static U next() { return serial.fetch_add(1, std::memory_order_relaxed) + 1; }
+static void clear() {
+    state.active = state.conflict = state.primaryAnchor = false;
+    state.event = state.builders = state.matches = state.births = 0;
+    state.pending = {};
+}
+static bool ready() {
+    if (!roomActive()) { if (state.active) clear(); return false; }
+    U e = epoch();
+    if (!state.active || state.epochValue != e) { clear(); state.epochValue = e; state.active = true; }
+    return true;
+}
+static void remember(U event, bool primary = false) {
+    if (!event) return;
+    if (state.primaryAnchor && !primary) return;
+    if (primary && !state.primaryAnchor) {
+        state.event = event; state.primaryAnchor = true; state.conflict = false;
+        return;
+    }
+    if (state.event && state.event != event && !state.conflict) {
+        state.conflict = true;
+        if (primary) lost("Q_EVENT_AMBIGUOUS");
+    } else if (!state.event) state.event = event;
+}
+static bool current(const Birth& b) {
+    return nodeVersions[bucket(b.node)].load() == b.nodeVersion &&
+           objectVersions[bucket(b.obj)].load() == b.objVersion && gaps.load() == b.gap;
+}
+static bool selectionCurrent(const Match& m) {
+    return nodeVersions[bucket(m.node)].load() == m.nodeVersion &&
+           objectVersions[bucket(m.desc)].load() == m.objVersion && gaps.load() == m.gap;
+}
+// A birth never travels to another thread. Every insertion (including unrelated helpers)
+// advances its two address stamps. Hash collisions discard evidence conservatively.
+static U birthFor(bool cmd, U event, U node, U obj, U list, U head, const Object& info) {
+    for (unsigned i = state.births; i; --i) {
+        const Birth& b = state.birth[i - 1];
+        if (b.command != cmd || b.obj != obj || b.event != event || b.list != list ||
+            b.head != head || (node && b.node != node) || b.key != info.key || b.name != info.name) continue;
+        if (!current(b)) return 0;
+        if (!node) { // EMIT carries a producer, not its scheduler node.
+            Node live{};
+            if (!read(b.node, live) || live.object != obj || !links(b.node, live) || !current(b)) return 0;
+            U before = b.node, at = live.next;
+            for (unsigned n = 0; at != head && n < 128; ++n) {
+                Pair neighbor{};
+                if (!at || !read(at, neighbor) || neighbor.second != before) return 0;
+                before = at; at = neighbor.first;
+            }
+            U tail{};
+            if (at != head || !read(head + 8, tail) || tail != before || !current(b)) return 0;
+        }
+        return b.id;
+    }
+    return 0;
+}
+static void save(const Birth& b) {
+    // A producer register cannot distinguish duplicate live nodes for one object.
+    for (unsigned i = 0; !b.command && i < state.births; ++i) {
+        const Birth& old = state.birth[i];
+        if (!old.command && old.obj == b.obj && old.node != b.node && old.list == b.list &&
+            nodeVersions[bucket(old.node)].load() == old.nodeVersion) {
+            Node n{};
+            if (read(old.node, n) && n.object == b.obj && links(old.node, n)) {
+                lost("Q_LINK_ALIAS"); return; // Old object stamp already revoked.
+            }
+        }
+    }
+    // Reuse revoked slots only. A full table cannot overwrite a live provenance receipt.
+    for (unsigned i = 0; i < state.births; ++i) {
+        if (!current(state.birth[i])) { state.birth[i] = b; return; }
+    }
+    if (state.births == 128) { lost("Q_BIRTH_CAP"); return; }
+    state.birth[state.births++] = b;
+}
+// The real VM at 2749180 establishes RBP. Prove its caller and exact frame on
+// the live frame chain. Unwound/stale TLS alone cannot qualify a handler.
+static U vmAt(U event, U cursor) {
+    if (!state.matches) return 0;
+    const Match& m = state.match[state.matches - 1];
+    if (!m.vm || !m.pickOK || !m.name || (event && event != m.event) || m.fp < 0x690) return 0;
+    const U child = m.fp - 0x690;
+    for (unsigned n = 0; cursor && cursor <= child && n < 64; ++n) {
+        Pair frame{};
+        if (!read(cursor, frame) || frame.first <= cursor) return 0;
+        if (cursor == child)
+            return frame.first == m.fp && frame.second == base + 0x139ae34 && selectionCurrent(m) ? m.vm : 0;
+        cursor = frame.first;
+    }
+    return 0;
+}
+
+static void build(W type, const GuestRegisterSnapshot& r) {
+    if (r.rsp < 8) { lost("Q_BUILD_STACK"); return; }
+    U fp = r.rsp - 8;
+    while (state.builders && state.build[state.builders - 1].fp <= fp) --state.builders;
+    if (W(r.rsi) != 4000 || !r.rdi) return;
+    U ret{};
+    if (!read(r.rsp, ret)) { lost("Q_BUILD_RETURN"); return; }
+    U pc = relative(ret);
+    Name name = origin(type, pc);
+    if (!name) return;
+    if ((type == 57 ? r.rcx : r.rdx) != base + labels[name].rva) { lost("Q_BUILD_NAME"); return; }
+    if (state.builders == 8) { state.builders = 0; lost("Q_BUILD_DEPTH"); return; }
+    remember(r.rdi);
+    U id = next();
+    state.build[state.builders++] = {id, fp, r.rbp, pc, r.rdi, type, false};
+    W param = W(type == 57 ? r.rdx : r.rcx);
+    if (type == 15) std::memcpy(&param, r.ymm[0].data(), sizeof(param));
+    emit(type == 15 ? "BUILD15" : type == 57 ? "BUILD57" : "BUILD67",
+         id, r.rdi, pc, r.rsp, name, pack(param, W(r.r8)));
+    emit("Q_BUILD_CONTEXT", id, vmAt(r.rdi, r.rbp), epoch(), windowId(), r.rbp, W(r.rsi));
+}
+static void linked(bool cmd, const GuestRegisterSnapshot& r) {
+    const U node = r.rbx, list = cmd ? r.r15 : r.r14;
+    U obj{};
+    U nv = ++nodeVersions[bucket(node)];
+    if (!node || !read(node + 16, obj) || !obj) { ++gaps; lost("Q_LINK_OBJECT"); return; }
+    U ov = ++objectVersions[bucket(obj)], gap = gaps.load();
+    Pair frame{};
+    if (!read(r.rbp, frame)) { lost("Q_LINK_FRAME"); return; }
+    U helper = relative(frame.second);
+    W type = helperType(cmd, helper);
+    if (!type) return;
+    Pair parent{};
+    if (!frame.first || !read(frame.first, parent)) { lost("Q_LINK_PARENT"); return; }
+    U pc = relative(parent.second);
+    Name expected = origin(type, pc);
+    if (!expected) return;
+    U event{};
+    if (cmd) {
+        if (list < 0x40) { lost("Q_LINK_LIST"); return; }
+        event = list - 0x40;
+    } else { // Parent R13 (15/57) or R15 (67/13/14), saved by this helper.
+        const U offset = type == 15 || type == 57 ? 0x18 : 8;
+        if (r.rbp < offset || !read(r.rbp - offset, event) || !event) { lost("Q_LINK_EVENT"); return; }
+    }
+    Node n{};
+    Pair h{}, root{};
+    Object info{};
+    int decoded = cmd ? commandInfo(obj, info) : conditionInfo(obj, info);
+    if (decoded != 1 || info.key.type != type || (cmd && info.name != expected) ||
+        (!cmd && (!roots(root) || list != root.second + 8 || root.second != info.owner)) ||
+        !listHeader(list, h) || !h.second || !read(node, n) || n.object != obj ||
+        n.next != h.first || node == h.first || !links(node, n)) {
+        emit("Q_LINK_UNKNOWN", cmd, helper, event, list, node, obj);
+        lost("Q_LINK_UNVERIFIED"); return;
+    }
+    remember(event);
+    U builder = 0;
+    while (state.builders && state.build[state.builders - 1].fp < frame.first) --state.builders;
+    if (state.builders) {
+        auto& b = state.build[state.builders - 1];
+        if (b.fp == frame.first && b.callerFp == parent.first && b.pc == pc &&
+            b.event == event && b.type == type) {
+            if (cmd || !b.conditionSeen) builder = b.id;
+            else lost("Q_LINK_REPEAT");
+            if (cmd) --state.builders;
+            else b.conditionSeen = true;
+        }
+    }
+    U id = next();
+    Birth birth{id, node, obj, list, h.first, event, nv, ov, gap, info.key, info.name, cmd};
+    if (!current(birth)) { lost("Q_LINK_CHANGED"); return; }
+    save(birth);
+    emit(cmd ? "COMMAND_LINKED" : "CONDITION_LINKED", id, builder, event, list, node, obj);
+    emit("Q_LINK_META", id, h.first, h.second, pack(info.key.type, info.key.id),
+         pack(info.key.arg, info.key.mode), info.name);
+    emit("Q_LINK_ORIGIN", id, helper, pc, frame.first, info.flags, info.owner);
+}
+
+static void sending(Key k, const GuestRegisterSnapshot& r) {
+    U ret{}, producer{}, birth{};
+    if (!read(r.rsp, ret)) lost("Q_EMIT_RETURN");
+    U pc = relative(ret);
+    if (pc == 0x12fd3ec && (k.type == 13 || k.type == 14)) producer = r.r15;
+    if ((pc == 0x13009e6 && k.type == 15) || (pc == 0x130d297 && k.type == 57) ||
+        (pc == 0x1309dd7 && k.type == 67)) producer = r.rbx;
+    if (producer) {
+        Object info{};
+        Pair root{}, h{};
+        if (conditionInfo(producer, info) == 1 && info.key == k && roots(root) &&
+            info.owner == root.second && listHeader(root.second + 8, h)) {
+            birth = birthFor(false, r.rdi, 0, producer, root.second + 8, h.first, info);
+            remember(r.rdi);
+        } else lost("Q_EMIT_PRODUCER");
+    }
+    if (state.pending.id) lost("Q_EMIT_NO_MATCH");
+    U id = next();
+    state.pending = {id, r.rsp >= 8 ? r.rsp - 8 : 0, r.rdi, k};
+    emit("EMIT", id, r.rdi, pc, producer, birth, r.rbp);
+    keyRow(id, k);
+}
+static void enter(Key k, bool selected, const GuestRegisterSnapshot& r) {
+    if (r.rsp < 8) { state.matches = 0; state.pending = {}; lost("Q_MATCH_STACK"); return; }
+    const auto s = state.pending;
+    state.pending = {};
+    if (!selected && s.id) lost("Q_EMIT_NO_MATCH");
+    U fp = r.rsp - 8;
+    if (state.matches && state.match[state.matches - 1].fp <= fp) {
+        state.matches = 0;
+        lost("Q_MATCH_UNWIND");
+    }
+    if (state.matches == 8) { state.matches = 0; state.pending = {}; lost("Q_MATCH_DEPTH"); }
+    if (!selected && !state.matches) return;
+    auto& m = state.match[state.matches++];
+    m = {};
+    m.fp = fp;
+    if (!selected) return; // Mask the outer VM until this unrelated nested matcher exits.
+    Pair entry{};
+    if (!read(r.rsp, entry)) lost("Q_MATCH_ARGUMENT");
+    U pc = relative(entry.first), event = entry.second;
+    bool managerOK = event && r.rdi >= 0x38 && r.rdi - 0x38 == event;
+    if (!managerOK) lost("Q_MATCH_MANAGER");
+    if (pc == 0x133a255) {
+        if (managerOK && s.id && s.fp == r.rbp && s.fp >= 0x78 && r.rsp == s.fp - 0x78 &&
+            s.event == event && s.key == k) m.send = s.id;
+        else lost("Q_MATCH_LOCAL_UNBOUND");
+    } else if (s.id) lost("Q_EMIT_NO_MATCH");
+    m.id = next(); m.event = managerOK ? event : 0; m.key = k;
+    emit("MATCH_ENTER", m.id, m.event, pc, r.rdi, m.send, fp);
+    keyRow(m.id, k);
+}
+static void pick(Match& m, const GuestRegisterSnapshot& r) {
+    if (m.pick) lost("Q_PICK_UNCLOSED");
+    m.pick = next(); m.node = r.rsi; m.desc = r.rax; m.sub = m.vm = m.target = 0;
+    m.nodeVersion = nodeVersions[bucket(m.node)].load();
+    m.objVersion = objectVersions[bucket(m.desc)].load(); m.gap = gaps.load();
+    m.pickOK = false;
+    Object info{};
+    Node n{};
+    Pair h{};
+    if (m.event && m.node && m.desc && read(m.node, n) && n.object == m.desc &&
+        commandInfo(m.desc, info) == 1 && info.key == m.key && links(m.node, n) &&
+        listHeader(m.event + 0x40, h) && h.second && h.first != m.node && selectionCurrent(m)) {
+        m.pickOK = true;
+        m.sub = birthFor(true, m.event, m.node, m.desc, m.event + 0x40, h.first, info);
+    } else lost("Q_PICK_UNVERIFIED");
+    m.name = info.name;
+    ++m.picks;
+    emit("PICK", m.pick, m.id, m.event, m.node, m.desc, m.sub);
+    emit("Q_PICK_META", m.pick, info.name, pack(info.key.type, info.key.id),
+         pack(info.key.arg, info.key.mode), info.flags, m.pickOK);
+}
+static bool vmSlots(const Match& m, const GuestRegisterSnapshot& r, U& def) {
+    U node{}, slot{}, obj{};
+    return m.pick && m.pickOK && r.rbp >= 0x608 && r.r14 == m.event &&
+           read(r.rbp - 0x608, node) && node == m.node &&
+           read(r.rbp - 0x5e8, slot) && slot == node + 0x10 && read(slot, obj) && obj == m.desc &&
+           read(r.rbp - 0x48, def) && selectionCurrent(m);
+}
+static void inside(Site site, const GuestRegisterSnapshot& r) {
+    if (!state.matches) return;
+    auto& m = state.match[state.matches - 1];
+    if (m.fp != r.rbp) { state.matches = 0; lost("Q_MATCH_FRAME"); return; }
+    if (!m.id) { if (site == Site::MATCH_END) --state.matches; return; }
+    if (site == Site::PICK) { pick(m, r); return; }
+    if (site == Site::MATCH_END) {
+        int32_t result = static_cast<int32_t>(r.r13);
+        if (m.pick || (result >= 0 && W(result) != m.picks) || (result < 0 && m.picks))
+            lost("Q_MATCH_COUNT");
+        emit("MATCH_END", m.id, m.event, U(static_cast<int64_t>(result)), m.picks, m.calls, m.send);
+        --state.matches;
+        return;
+    }
+    U def{};
+    bool good = vmSlots(m, r, def);
+    if (site == Site::VM_CALL) {
+        ++m.calls;
+        if (good && !m.vm && def && def == r.rdi) { m.vm = next(); m.target = def; }
+        else { m.vm = 0; m.pickOK = false; lost("Q_VM_CALL_UNBOUND"); }
+        emit("VM_CALL", m.vm, m.id, m.event, m.pick, m.vm ? m.sub : 0, r.rdi);
+    } else {
+        W result = 0;
+        if (good && m.vm && def == m.target) result = 1;
+        if (good && !m.vm && !def) result = 2;
+        if (!result) lost("Q_VM_EXIT_UNBOUND");
+        emit("VM_END_OR_NULL", result == 1 ? m.vm : 0, m.id, m.event, m.pick, result, def);
+        m.pick = m.vm = m.target = 0; m.pickOK = false;
+    }
+}
+
+struct Sample { U address; Node node; Object info; U receipt, nodeVersion, objVersion; bool candidate; };
+static constexpr unsigned activeSnapshotLimit = 256;
+static constinit thread_local Sample samples[activeSnapshotLimit]{};
+static constinit thread_local bool scanning{};
+
+static void scan(U snap, unsigned kind, U event, U list, const Pair& root) {
+    Pair h{}, ends{}, again{};
+    const unsigned limit = kind == 2 ? activeSnapshotLimit : 128;
+    unsigned visited = 0, candidates = 0, status = 0;
+    bool ok = listHeader(list, h) && read(h.first, ends) && ends.first && ends.second;
+    emit("Q_LIST", snap, kind, list, h.first, h.second);
+    U addr = ends.second, towardHead = h.first;
+    while (ok && visited < h.second && visited < limit) {
+        Node n{};
+        if (addr == h.first || !read(addr, n) || !n.object || n.next != towardHead || !links(addr, n)) {
+            ok = false; break;
+        }
+        Object info{};
+        int decoded = kind == 1 ? conditionInfo(n.object, info) : commandInfo(n.object, info);
+        if (decoded < 0 || (decoded && kind == 1 && info.owner != root.second)) { ok = false; break; }
+        U id = decoded ? birthFor(kind != 1, event, addr, n.object, list, h.first, info) : 0;
+        samples[visited++] = {addr, n, info, id, nodeVersions[bucket(addr)].load(),
+                              objectVersions[bucket(n.object)].load(), decoded == 1};
+        towardHead = addr; addr = n.prev;
+    }
+    for (unsigned i = 0; ok && i < visited; ++i) {
+        const auto& s = samples[i];
+        Node n{}; Object info{};
+        ok = read(s.address, n) && n == s.node && nodeVersions[bucket(s.address)].load() == s.nodeVersion &&
+             objectVersions[bucket(s.node.object)].load() == s.objVersion;
+        if (!ok) break;
+        int decoded = kind == 1 ? conditionInfo(n.object, info) : commandInfo(n.object, info);
+        ok = decoded >= 0 && (decoded == 1) == s.candidate && (!s.candidate || info == s.info);
+    }
+    ok = ok && listHeader(list, again) && again == h && read(h.first, again) && again == ends;
+    if (kind == 1) ok = ok && roots(again) && again == root;
+    ok = ok && roomActive() && epoch() == state.epochValue && !state.conflict;
+    if (ok && visited == h.second && addr == h.first && towardHead == ends.first) status = 1;
+    if (ok && visited == limit && visited < h.second && addr != h.first) status = 2;
+    for (unsigned i = 0; status && i < visited; ++i) {
+        const auto& s = samples[i];
+        if (!s.candidate) continue;
+        U receipt = birthFor(kind != 1, event, s.address, s.node.object, list, h.first, s.info);
+        emit("Q_RESIDENT", snap, kind, s.address, s.node.object, receipt == s.receipt ? receipt : 0, s.info.flags);
+        emit("Q_RESIDENT_META", snap, s.address, pack(s.info.key.type, s.info.key.id),
+             pack(s.info.key.arg, s.info.key.mode), s.info.name);
+        ++candidates;
+    }
+    emit("Q_LIST_END", snap, kind, status, visited, candidates);
+    if (status != 1) lost(status == 2 ? "Q_LIST_CAP" : "Q_LIST_UNSTABLE");
+}
+} // namespace queue_detail
+
+void queueEvent(uint64_t event) {
+    if (queue_detail::ready()) queue_detail::remember(event, true);
+}
+void queueObserveEvent(uint64_t event) { queueEvent(event); }
+uint64_t queueVmAt(uint64_t event, uint64_t guestRbp) {
+    return queue_detail::ready() ? queue_detail::vmAt(event, guestRbp) : 0;
+}
+uint64_t queueVmFor(uint64_t event, const GuestRegisterSnapshot& r) {
+    return queueVmAt(event, r.rbp);
+}
+uint64_t queueVmFor(uint64_t event) {
+    // Opportunistic convenience only. Production handler callbacks use their guest RBP.
+    return queueVmAt(event, reinterpret_cast<uint64_t>(__builtin_frame_address(0)));
+}
+void queueSnapshot() {
+    using namespace queue_detail;
+    U snap = next();
+    bool valid = ready() && state.event && !state.conflict;
+    U event = valid ? state.event : 0;
+    emit("Q_SNAPSHOT", snap, event);
+    if (!valid) { lost("Q_SNAPSHOT_NO_EVENT"); emit("Q_SNAPSHOT_END", snap, 0); return; }
+    if (scanning) { lost("Q_SNAPSHOT_REENTRY"); emit("Q_SNAPSHOT_END", snap, 0); return; }
+    scanning = true;
+    Pair root{};
+    bool gotRoot = roots(root);
+    scan(snap, 1, event, gotRoot ? root.second + 8 : 0, root);
+    scan(snap, 2, event, event + 0x40, root);
+    scan(snap, 3, event, event + 0x60, root);
+    scanning = false;
+    emit("Q_SNAPSHOT_END", snap, roomActive() && epoch() == state.epochValue && !state.conflict);
+}
+void queuePoint(Site site, const GuestRegisterSnapshot& r) {
+    using namespace queue_detail;
+    switch (site) {
+    case Site::MATCH_ENTER: case Site::EMIT: {
+        Key k{W(r.rsi), W(r.rdx), W(r.rcx), W(r.r8)};
+        bool selected = scoped(k);
+        if (!selected && (site == Site::EMIT || (!state.matches && !state.pending.id))) return;
+        if (!ready()) return;
+        if (site == Site::MATCH_ENTER) enter(k, selected, r);
+        else sending(k, r);
+        return;
+    }
+    case Site::PICK: case Site::VM_CALL: case Site::VM_END_OR_NULL: case Site::MATCH_END:
+        if (state.matches && ready()) inside(site, r);
+        return;
+    case Site::BUILD15: case Site::BUILD57: case Site::BUILD67:
+        if ((W(r.rsi) == 4000 || state.builders) && ready())
+            build(site == Site::BUILD15 ? 15 : site == Site::BUILD57 ? 57 : 67, r);
+        return;
+    case Site::CONDITION_LINKED: case Site::COMMAND_LINKED:
+        if (ready()) linked(site == Site::COMMAND_LINKED, r);
+        return;
+    default: return;
+    }
+}
