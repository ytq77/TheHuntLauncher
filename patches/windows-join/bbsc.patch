+        return m.get(task, 0xd8, actual_key) && actual_key == key && m.get(task, 0xe0, actual_buffer) &&
+               actual_buffer == buffer && m.get(task, 0xe8, actual_length) && actual_length == length;
+    };
+    if (!live()) return {};
+    if (!active_claim->origin.digest.empty()) {
+        std::array<u8, capacity> bytes{};
+        if (!m.bytes(buffer, 0, bytes.data(), length) || !live()) return {};
+        auto digest = BbscSaveProofHash(std::span{bytes}.first(length));
+        if (digest.empty()) return {};
+        verify_copy(a, digest);
+    }
+    return active_claim->key;
+}
