@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "host_decode.hpp"
+#include "host_match.h"
+#include <map>
+
+namespace HostDecode {
+#define HOST_CLAIM_SITE(name, value, ...) inline constexpr Address name = value;
+#include "host_claim_sites.inc"
+#undef HOST_CLAIM_SITE
+inline constexpr Address build_entry = 0x1874710, queue_insert = 0x1875320;
+
+// Used under CandidateLifetimes' mutex. The native pending item owns the candidate
+// and prepared. A particular published todo owns a copy of this Build's pose.
+class ClaimOrigins {
+    struct Pending {
+        Address node, generation;
+        TheHuntHostMatchV1 match;
+    };
+    struct Todo {
+        Address owner, record, stored, item, generation;
+        TheHuntHostPoseV1 pose;
+    };
+    struct Stored {
+        Address owner, tree_node, item, generation;
+        TheHuntHostPoseV1 pose;
+    };
+    struct Flight {
+        Address frame, item, generation, prepared, owner, queue_frame, build_result;
+        std::optional<TheHuntHostPoseV1> pose;
+    };
+    inline static thread_local Flight flight{};
+    std::map<Address, Pending> pending_;
+    std::map<Address, Stored> stored_;
+    std::map<Address, Todo> todos_;
+    Address serial_{};
+    unsigned installed_{};
+    static constexpr Address required[] = {build_entry, queue_insert,
+#define HOST_CLAIM_SITE(name, value, ...) name,
+#include "host_claim_sites.inc"
+#undef HOST_CLAIM_SITE
+    };
+    static bool equals(Memory m, Address addr, Address offset, Address expected) {
+        Address actual{};
+        return m.get(addr, offset, actual) && actual == expected;
+    }
+public:
+    void install(Address site) {
+        for (unsigned i = 0; i < std::size(required); ++i)
+            if (required[i] == site) installed_ |= 1u << i;
+    }
+    bool ready() const { return installed_ == (1u << std::size(required)) - 1; }
+    void detach(Address item) {
+        pending_.erase(item);
+        std::erase_if(stored_, [item](const auto& e) { return e.second.item == item; });
+        std::erase_if(todos_, [item](const auto& e) { return e.second.item == item; });
+    }
+    void invalidate(Address candidate) {
+        for (auto it = pending_.begin(); it != pending_.end();) {
+            const auto current = it++;
+            if (current->second.match.matched_candidate == candidate) detach(current->first);
+        }
+    }
+    void begin(Address frame, Address node, Address item, const std::optional<TheHuntHostMatchV1>& match) {
+        flight = {};
+        detach(item);
+        if (!ready() || !frame || !match) return;
+        const auto generation = ++serial_;
+        pending_.emplace(item, Pending{node, generation, *match});
+        flight = {frame, item, generation, match->matched_prepared, 0, 0, 0, {}};
+    }
+    template<class Regs> void build(Memory m, Address base, const Regs& r, TheHuntHostPoseV1 pose) {
+        if (!flight.frame || r.rbp != flight.frame || r.rsi != flight.prepared || r.r14 != r.rsi ||
+            !equals(m, r.rsp, 0, base + 0x187338f)) return;
+        flight.owner = r.rdi;
+        flight.pose = pose;
+    }
+    template<class Regs> void observe(Memory m, Address base, Address site, const Regs& r) {
+        switch (site) {
+        case PendingExpired: case PendingCleared: case PendingCancelled:
+            detach(r.r15);
+            return;
+        case MatchBuildFinished:
+            if (flight.frame == r.rbp) flight = {};
+            return;
+        case queue_insert:
+            if (flight.pose && r.rbp == flight.frame && r.r14 == flight.prepared &&
+                r.rdi == flight.owner && r.rsi && r.rsi == r.rax && r.rsp >= 8 &&
+                equals(m, r.rsp, 0, base + 0x187339f)) {
+                flight.queue_frame = r.rsp - 8;
+                flight.build_result = r.rsi;
+            }
+            return;
+        case StoredPayload: {
+            Address ret{}, node{};
+            if (m.get(r.rsp, 0, ret) && ret != base + 0x1875423 && ret != base + 0x18756ca) return;
+            // Replacing a tree entry does not replace the already enqueued job.
+            // Revoke its unclaimed origin even when another native caller made the write.
+            std::erase_if(todos_, [&](const auto& e) { return e.second.stored == r.rsi; });
+            stored_.erase(r.rsi);
+            const auto p = pending_.find(flight.item);
+            if (!flight.queue_frame || !flight.pose || r.rbp != flight.queue_frame || r.rbp < 0x10050 ||
+                r.rdi != flight.owner || !equals(m, r.rbp, 0, flight.frame) ||
+                p == pending_.end() || p->second.generation != flight.generation) return;
+            if (ret == base + 0x1875423 && r.rbx == flight.build_result) node = r.rdx;
+            if (ret == base + 0x18756ca && r.rsi == r.r15) m.get(r.rbp-0x50, 0, node);
+            if (node && r.rsi && equals(m, node, 0x28, r.rsi))
+                stored_.emplace(r.rsi, Stored{r.rdi, node, flight.item, flight.generation, *flight.pose});
+            return;
+        }
+        // Before the native allocator frees the status tree's payload. A todo
+        // already published from that payload is a separate owning allocation.
+        case StoreOwnerDestroyed: case StoreTreeCleared: stored_.erase(r.r14); return;
+        case StoreItemRemoved: stored_.erase(r.r12); return;
+        case TodoPublished: {
+            // Every publication invalidates a recycled node or record, even for a
+            // different caller or a selection for which the server supplied no ID.
+            todos_.erase(r.r14);
+            std::erase_if(todos_, [&](const auto& e) { return e.second.record == r.rbx; });
+            Address parent{}, caller{}, payload{};
+            if (r.rbp < 0x10028 || !r.rbx || !equals(m, r.r14, 0x10, r.rbx) ||
+                !m.get(r.rbp - 0x28, 0, payload) ||
+                !m.get(r.rbp, 8, caller) || (caller != base + 0x18762dc && caller != base + 0x187611d) ||
+                !m.get(r.rbp, 0, parent) || !m.get(parent, 8, caller) ||
+                (caller != base + 0x18756e8 && caller != base + 0x1875710 && caller != base + 0x130ca39)) return;
+            const auto held = stored_.find(payload);
+            if (held == stored_.end() || held->second.owner != r.r15 ||
+                !equals(m, held->second.tree_node, 0x28, payload)) return;
+            const auto& source = held->second;
+            todos_.emplace(r.r14, Todo{r.r15, r.rbx, payload, source.item, source.generation, source.pose});
+            return;
+        }
+        }
+    }
+    // Called within the room component's real allocated_claim, after both native
+    // scans and generation assignment. The returned value owns no game pointers.
+    template<class Claim> std::optional<TheHuntHostClaimOriginV1> seal(const Claim& key) const {
+        const auto& s = key.selected;
+        const auto t = todos_.find(s.queue_node);
+        const auto p = pending_.find(s.pending_item);
+        if (!key.incarnation || !s.selection_incarnation || t == todos_.end() || p == pending_.end()) return {};
+        const auto& todo = t->second;
+        const auto& held = p->second;
+        if (todo.owner != s.queue_owner || todo.record != s.queue_record || todo.item != s.pending_item ||
+            todo.generation != held.generation || held.node != s.pending_node ||
+            held.match.matched_candidate != s.candidate || held.match.matched_prepared != s.prepared) return {};
+        return TheHuntHostClaimOriginV1{held.match, todo.pose, key.incarnation};
+    }
+};
+} // namespace HostDecode
