+void witness(const TraceSite& site, const GuestRegisterSnapshot& g) noexcept {
+    try {
+        std::unique_lock lock{room_mutex};
+        if (!all_installed()) return;
+        const HostDecode::Memory m{BbscSaveProofRead};
+        u64 parent{}, ret{}, ptr{}, control{};
+        switch (site.offset) {
+        case QueueRecordSelected: {
+            u32 key{};
+            if (g.rbp < 0x10620 || g.rbp != flight.frame || g.rbx < 0x10000 || g.rbx != flight.owner ||
+                g.rcx < 0x10000 || g.rdx < 0x10000 ||
+                !m.get(g.rcx, 0x10, ptr) || ptr != g.rdx || !m.get(g.rdx, 0, key) ||
+                key != static_cast<u32>(g.r13) || !m.get(g.rdx, 8, flight.role)) { flight = {}; return; }
+            flight.key = key;
+            flight.objects = {g.rbx, g.rcx, g.rdx, 0, 0, 0, 0, ++serial};
+            return;
+        }
+        case ClaimItemSelected: {
+            flight.allocation_frame = 0;
+            u32 key{};
+            if (!flight.objects.queue_record || g.r12 != GetSummonManager() || !m.get(g.rbp, 0, parent) ||
+                parent != flight.frame || !m.get(g.rbp, 8, ret) || ret != image_base+0x187379c ||
+                g.rcx < 0x10000 || g.rdx < 0x10000 || g.rsi < 0x10000 || g.rax < 0x10000 ||
+                !m.get(g.rcx, 0x10, ptr) || ptr != g.rdx || !m.get(g.rdx, 8, ptr) || ptr != g.rsi ||
+                !m.get(g.rdx, 0, ptr) || ptr != g.rax || !m.get(g.rsi, 0, key) ||
+                key != flight.key || key != static_cast<u32>(g.r13)) return;
+            flight.allocation_frame = g.rbp;
+            flight.objects.pending_node = g.rcx;
+            flight.objects.pending_item = g.rdx;
+            flight.objects.candidate = g.rax;
+            flight.objects.prepared = g.rsi;
+            return;
+        }
+        case SubmittedToMatching2: {
+            submission = {};
+            if (!m.get(g.rbp, 8, ret) || ret != image_base+0xcc4ddf || !m.get(g.rbp, 0, parent) ||
+                !m.get(g.r15, 0, ptr) || ptr != image_base+0xcc31d0 ||
+                !m.get(g.r15, 8, control) || control < 0x10000 || g.rbx < 0x10000 || !g.rdi ||
+                g.rdi > 0xffff || parent < 0x10000) return;
+            retire(control);
+            submission = {control, parent, ++serial};
+            rooms.emplace(control, Created{g.rbx, serial, static_cast<std::uint16_t>(g.rdi)});
+            return;
+        }
+        case CreateRequestId: {
+            const auto pending = std::exchange(submission, {});
+            auto it = rooms.find(g.r15);
+            if (it != rooms.end() && pending.controller == g.r15 && g.rbp == pending.frame &&
+                it->second.generation == pending.generation) it->second.request = static_cast<u32>(g.rax);
+            return;
+        }
+        case AcceptedCreateResponse: accepted_create(g, m); return;
+        case CreateMembersReturned: {
+            const auto handoff = finish_create(g);
+            lock.unlock();
+            log_handoff(handoff);
+            return;
+        }
+        case ControllerDelete: case ControllerDestroy: retire(g.rdi); return;
+        case ControllerSubobjectDelete: case ControllerSubobjectDestroy:
+            if (g.rdi >= 0x10068) retire(g.rdi-0x68);
+            return;
+        case ContextStop: case ContextDestroy:
+            for (auto it = rooms.begin(); it != rooms.end();) {
+                const auto current = it++;
+                if (current->second.context_object == g.rdi) retire(current->first);
+            }
+            return;
+        case ReadyHostRoom: {
+            const auto it = rooms.find(g.rbx);
+            u64 holder_frame{};
+            u32 world{};
+            if (!selection.frame || it == rooms.end() || !it->second.request || !g.rax ||
+                (g.r12 & 0xff) != 1 || g.rbp < 0x10278 || !m.get(g.rbp, 8, ret) ||
+                ret != image_base+0xc8f53c || !m.get(g.rbp, 0, holder_frame) ||
+                !m.get(holder_frame, 8, ret) || ret != image_base+0x18736ad ||
+                !m.get(holder_frame, 0, parent) || parent != selection.frame ||
+                !m.get(g.rbp-0x274, 0, world)) return;
+            selection.controller = g.rbx;
+            selection.generation = it->second.generation;
+            selection.platform = {world, g.rax};
+            selection.destination = g.r14;
+            selection.producer_frame = g.rbp;
+            return;
+        }
+        case FreshDescriptor:
+            selection.fresh = selection.controller && selection.producer_frame == g.rbp &&
+                g.r13 == g.rbp-0x160 && g.r14 == selection.destination && g.r13 != g.r14 &&
+                native_platform(m, g.r13, selection.platform);
+            return;
+        case DescriptorReturned:
+            if (!selection.fresh || selection.frame != g.rbp || !(g.rax & 0xff) ||
+                selection.destination != g.r15 || !native_platform(m, g.r15, selection.platform)) {
+                selection = {}; return;
+            }
+            selection.returned = true;
+            selection.key = static_cast<u32>(g.r13);
+            return;
+        case SerializedForSelection: {
+            u64 len{};
+            u32 role_data{};
+            std::int32_t role{};
+            std::uint16_t version{};
+            std::array<u8, capacity> bytes{};
+            if (!selection.returned || !flight.objects.queue_record || selection.frame != g.rbp ||
+                flight.frame != g.rbp || g.rbp < 0x10620 ||
+                !(g.rax & 0xff) || g.r14 != g.rbp-0x3b0 || static_cast<u32>(g.r13) != selection.key ||
+                !m.get(g.rbp-0x5f0, 0, len) || len < 15 || len > capacity ||
+                !m.get(g.rbp-0x5c4, 0, role_data) || !m.get(g.rbp-0x5c8, 0, role) || role != flight.role ||
+                !m.get(image_base, 0x56c69a0, ptr) || ptr < 0x10000 || !m.get(ptr, 0x168, version) ||
+                !m.bytes(g.r14, 0, bytes.data(), len) || std::memcmp(bytes.data(), &role_data, 4) ||
+                std::memcmp(bytes.data()+4, &role, 4)) { selection = {}; return; }
+            const auto span = std::span{bytes}.first(len);
+            if (decode(span, version) != selection.platform) { selection = {}; return; }
+            selection.buffer = g.r14; selection.length = static_cast<u32>(len);
+            selection.digest = BbscSaveProofHash(span);
+            return;
+        }
+        case TaskCopyReturned: {
+            const auto copied = std::exchange(flight, {});
+            if (!active_claim || !allocation || !copied.incarnation || active_claim->key.incarnation != copied.incarnation ||
+                g.rbp != copied.allocation_frame || g.r12 != GetSummonManager() ||
+                g.rbp < 0x10040 || !m.get(g.rbp, 8, ret) || ret != image_base+0x187379c ||
+                !m.get(g.rbp, 0, parent) || parent != active_claim->origin.frame) return;
+            const auto& a = allocation->attempt;
+            u32 key{}, len{};
+            std::array<u8, capacity> bytes{};
+            if (m.get(a.task, 0xd8, key) && key == a.key && m.get(a.task, 0xe0, ptr) && ptr == a.buffer &&
+                m.get(a.task, 0xe8, len) && len == a.length && m.bytes(ptr, 0, bytes.data(), len)) {
+                const auto handoff = verify_copy(a, BbscSaveProofHash(std::span{bytes}.first(len)));
+                lock.unlock();
+                log_handoff(handoff);
+            }
+            return;
+        }
+        case TaskCleanup:
+            if (allocation && allocation->attempt.task == g.rbx) {
+                active_claim.reset(); allocation.reset(); emitted.reset();
+            }
+            return;
+        default: return;
+        }
+    } catch (...) { selection = {}; submission = {}; flight = {}; receiving.reset(); }
+}
