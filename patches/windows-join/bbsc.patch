+    std::map<u64,Source> births;
+    void put(Source s) {
+        if (!s.seq) return;
+        if (s.kind == Kind::Condition || s.kind == Kind::Command)
+            births[s.seq] = s;
+        else cache[s.seq % cache.size()] = s;
+    }
+    Source get(u64 id, Kind k) const {
