@@ -0,0 +1,59 @@
+// Included in the host Bloodborne event dispatcher. The two observations bracket
+// this game's own CSRequestSummon serializer and do not change its arguments.
+namespace HostClaimTransport {
+constexpr u64 begin = 0x14b483c, returned = 0x14b484c;
+std::atomic<unsigned> installed_sites{};
+
+void installed(u64 offset) {
+    if (offset == begin) installed_sites.fetch_or(1);
+    if (offset == returned) installed_sites.fetch_or(2);
+}
+
+// Shared with the original GetSeamlessHostPlacementHeader in the combined host.
+template<class Pose>
+std::string placement_header(const Pose& pose) {
+    std::ostringstream out;
+    out << "1," << std::hex << std::setfill('0') << std::setw(8) << pose.packed_region << ','
+        << std::setw(8) << std::bit_cast<u32>(pose.x) << ',' << std::setw(8)
+        << std::bit_cast<u32>(pose.y) << ',' << std::setw(8)
+        << std::bit_cast<u32>(pose.z) << ',' << std::setw(8)
+        << std::bit_cast<u32>(pose.heading) << ',' << std::dec << pose.area;
+    return out.str();
+}
+
+void record(u64 offset, const GuestRegisterSnapshot& g) noexcept {
+    using namespace TheHunt::Summon;
+    if ((offset != begin && offset != returned) || !BoundClaimsEnabled()) return;
+    if (offset == returned) {
+        NativeClaimCall().returned(g.rbp, g.rbx);
+        return;
+    }
+    NativeClaimCall().begin(0, 0, {});
+    try {
+        const u64 manager = GetSummonManager();
+        if (installed_sites.load() != 3 || g.rbp < 0x10050 || manager < 0x10000 ||
+            manager > std::numeric_limits<u64>::max() - 0x58 || g.rbx != manager + 0x58) return;
+        const HostDecode::Memory memory{BbscSaveProofRead};
+        u64 callback_type{}, captured_task{}, buffer{};
+        u32 selection_key{}, length{};
+        if (!memory.get(g.rbp - 0x50, 0, callback_type) || callback_type != image_base + 0x5324bd0 ||
+            !memory.get(g.rbp - 0x48, 0, captured_task) || captured_task != g.rbx ||
+            !memory.get(g.rbx, 0xd8, selection_key) || !memory.get(g.rbx, 0xe0, buffer) ||
+            !memory.get(g.rbx, 0xe8, length)) return;
+        TheHuntHostRoomClaimV1 key{};
+        TheHuntHostRoomHandoffV1 room{};
+        if (!TheHuntHostRoomCaptureClaim(g.rbx, selection_key, buffer, length, &key) ||
+            !TheHuntHostRoomCopyHandoff(&key, &room) || room.claim != key) return;
+        TheHuntHostClaimOriginV1 selected{};
+        if (!TheHuntHostMatchCopyForClaim(&key, &selected) || !key.incarnation || selected.incarnation != key.incarnation ||
+            selected.match.registration_id[48] != '\0' || selected.match.matched_candidate != key.selected.candidate ||
+            selected.match.matched_prepared != key.selected.prepared) return;
+        auto origin = EncodeClaimOrigin({std::string_view(selected.match.registration_id, 48),
+                                         room.room_id, room.host_member_id,
+                                         room.host_join_date, key.incarnation, HostRunId()});
+        if (origin) NativeClaimCall().begin(g.rbp, g.rbx, ClaimHeaders{std::move(*origin), placement_header(selected.host_pose)});
+    } catch (...) {
+        NativeClaimCall().begin(0, 0, {});
+    }
+}
+} // namespace HostClaimTransport
