diff --git a/emulator/src/core/host_decode.hpp b/emulator/src/core/host_decode.hpp
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/host_decode.hpp
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <set>
+#include <string_view>
+#include <vector>
+
+namespace HostDecode {
+using Address = std::uint64_t;
+inline constexpr Address submit = 0x14babcb, inserted = 0x14b8e8d, matched = 0x18732dd;
+inline constexpr Address retained_duplicate = 0x14b8f18, destroy = 0x14bff90;
+inline constexpr Address search_return = 0x1e856e4;
+inline constexpr std::u16string_view field_name = u"TheHuntRegistrationId";
+
+// The adapter copies only from the current process or an offline memory image.
+using Copy = bool (*)(Address, void*, std::size_t);
+struct Memory {
+    Copy copy;
+    bool bytes(Address base, Address offset, void* dst, std::size_t count) const {
+        constexpr auto last = std::numeric_limits<Address>::max();
+        return base && count && offset <= last - base && count - 1 <= last - (base + offset)
+            && copy(base + offset, dst, count);
+    }
+    template<class T> bool get(Address base, Address offset, T& value) const {
+        return bytes(base, offset, &value, sizeof(value));
+    }
+};
+
+class RegistrationId {
+public:
+    static constexpr std::size_t length = 48;
+    static std::optional<RegistrationId> parse(const std::array<char16_t, length>& native) {
+        RegistrationId id;
+        for (std::size_t i = 0; i < length; ++i) {
+            const auto c = native[i];
+            if (!((c >= u'0' && c <= u'9') || (c >= u'a' && c <= u'f'))) return {};
+            id.bytes_[i] = static_cast<char>(c);
+        }
+        return id;
+    }
+    std::string_view text() const { return {bytes_.data(), bytes_.size()}; }
+private:
+    RegistrationId() = default;
+    std::array<char, length> bytes_{};
+};
+
+struct Registration {
+    const char* status = "unreadable";
+    std::optional<RegistrationId> id{};
+};
+
+inline Registration read_scalar(Memory m, Address node) {
+    std::uint32_t tag{};
+    if (!m.get(node, 0x58, tag)) return {};
+    if (tag != 5) return {"not_string"};
+    Address str{}, count{}, capacity{};
+    if (!m.get(node, 0x60, str) || !m.get(str, 0x18, count) ||
+        !m.get(str, 0x20, capacity) || count > capacity) return {};
+    if (count != RegistrationId::length) return {"wrong_length"};
+    Address data{};
+    std::array<char16_t, RegistrationId::length> value{};
+    // A canonical value always takes the native out-of-line string branch.
+    if (!m.get(str, 8, data) || !m.bytes(data, 0, value.data(), sizeof(value))) return {};
+    auto id = RegistrationId::parse(value);
+    return id ? Registration{"present", id} : Registration{"not_lower_hex"};
+}
+
+inline Registration registration_on_row(Memory m, Address row) {
+    std::uint32_t tag{};
+    Address object{}, head{}, root{};
+    if (!m.get(row, 0, tag) || tag != 7 || !m.get(row, 8, object) ||
+        !m.get(object, 8, head) || !m.get(head, 8, root)) return {};
+    // Walk this object's unique-key map. Exact key equality needs no assumption
+    // about the imported comparison function or the ordering of other keys.
+    std::vector<Address> todo{root};
+    std::set<Address> seen;
+    while (!todo.empty()) {
+        const Address node = todo.back();
+        todo.pop_back();
+        if (node == head) continue;
+        std::uint8_t nil{};
+        Address length{}, capacity{};
+        if (!seen.insert(node).second || !m.get(node, 0x19, nil) || nil ||
+            !m.get(node, 0x38, length) || !m.get(node, 0x40, capacity) || length > capacity)
+            return {};
+        if (length == field_name.size()) {
+            Address data{};
+            std::array<char16_t, field_name.size()> key{};
+            // The field name exceeds the seven-unit inline capacity.
+            if (!m.get(node, 0x28, data) || !m.bytes(data, 0, key.data(), sizeof(key))) return {};
+            if (std::equal(key.begin(), key.end(), field_name.begin())) return read_scalar(m, node);
+        }
+        Address left{}, right{};
+        if (!m.get(node, 0, left) || !m.get(node, 0x10, right)) return {};
+        todo.push_back(right);
+        todo.push_back(left);
+    }
+    return {"absent"};
+}
+
+struct FrameRow {
+    Address row{}, wrapper{}, storage{}, candidate{}, primary_node{}, rows_to_end{};
+    Registration registration;
+};
+
+// Submit and the tail-called manager each have their *own* native frame. The
+// callee-saved parser cursor and the caller's decoder slot refer to the same row.
+// This object is a synchronous observation. None of these addresses owns memory.
+template<class Snapshot>
+std::optional<FrameRow> read_offer(Memory m, Address base, Address site, const Snapshot& r) {
+    if ((site != submit && site != inserted && site != retained_duplicate) || !base || r.rbp < 8 ||
+        r.rbp > std::numeric_limits<Address>::max() - 0x700) return {};
+    Address pc{}, cursor{}, local_row{}, end{};
+    if (!m.get(r.rbp, 8, pc) || pc < base || pc - base != search_return ||
+        !m.get(r.rbp - 8, 0, cursor) || !m.get(r.rbp, 0x6f8, local_row) ||
+        !cursor || cursor != local_row || !m.get(r.rbp, 0x80, end) ||
+        end <= cursor || (end - cursor) % 0x20) return {};
+    FrameRow result;
+    result.row = cursor;
+    result.rows_to_end = (end - cursor) / 0x20;
+    result.wrapper = r.rbp + 0x628;
+    std::uint16_t size{};
+    if (!m.get(result.wrapper, 8, result.storage) || !m.get(result.storage, 2, size) ||
+        size != 224) return {};
+    if (site == submit) {
+        if (r.r15 != result.storage || !r.r14) return {};
+        result.candidate = r.r14;
+    } else if (site == inserted) {
+        Address in_node{};
+        if (!r.r15 || !m.get(r.rbx, 0x10, in_node) || in_node != r.r15) return {};
+        result.primary_node = r.rbx;
+        result.candidate = in_node;
+    } else {
+        // On this exact branch r14 is the old primary node, rbx its retained
+        // candidate and r15 the distinct offer the game will destroy.
+        Address old{};
+        if (!r.r15 || !r.rbx || r.rbx == r.r15 ||
+            !m.get(r.r14, 0x10, old) || old != r.rbx) return {};
+        result.candidate = r.r15;
+    }
+    result.registration = registration_on_row(m, result.row);
+    return result;
+}
+} // namespace HostDecode
diff --git a/emulator/src/core/host_match.h b/emulator/src/core/host_match.h
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/host_match.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct TheHuntHostMatchV1 {
+    char registration_id[49];   /* 48 lowercase hex digits, then NUL */
+    uint8_t reserved[7];        /* zero; fixed x64 layout across packing settings */
+    uint64_t matched_candidate;
+    uint64_t matched_prepared;
+} TheHuntHostMatchV1;
+
+/* Host ABI. The event is borrowed for this call; copy it to retain the values.
+   Both addresses identify game objects at Matched, not transferable ownership.
+   Install during initialization, before matchmaking. NULL disables delivery. */
+typedef void (*TheHuntHostMatchCallback)(const TheHuntHostMatchV1* event);
+#if defined(_WIN32) && defined(THEHUNT_HOST_MATCH_BUILD)
+#define THEHUNT_MATCH_API __declspec(dllexport)
+#else
+#define THEHUNT_MATCH_API
+#endif
+THEHUNT_MATCH_API void TheHuntSetHostMatchCallback(TheHuntHostMatchCallback callback);
+
+typedef struct TheHuntHostRoomClaimV1 TheHuntHostRoomClaimV1;
+typedef struct TheHuntHostPoseV1 {
+    uint32_t packed_region;
+    int32_t area;
+    float x, y, z, heading;
+} TheHuntHostPoseV1;
+typedef struct TheHuntHostClaimOriginV1 {
+    TheHuntHostMatchV1 match;
+    TheHuntHostPoseV1 host_pose;
+    uint64_t incarnation;
+} TheHuntHostClaimOriginV1;
+
+/* Pass the entire Handoff.claim. Success returns a caller-owned immutable copy.
+   Zero means unavailable and clears out. */
+THEHUNT_MATCH_API int TheHuntHostMatchCopyForClaim(const TheHuntHostRoomClaimV1* claim,
+                                                   TheHuntHostClaimOriginV1* out);
+#undef THEHUNT_MATCH_API
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/emulator/src/core/host_match_lifecycle.hpp b/emulator/src/core/host_match_lifecycle.hpp
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/host_match_lifecycle.hpp
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "host_decode.hpp"
+#include "host_match.h"
+#include "host_claim_lifecycle.hpp"
+#include <map>
+#include <mutex>
+
+namespace HostDecode {
+struct Observation {
+    std::optional<FrameRow> row;
+    Address candidate{}, retained{}, item{}, prepared{};
+    const char* status{};
+    std::optional<TheHuntHostMatchV1> match;
+};
+
+inline unsigned required_site(Address site) {
+    switch (site) {
+    case inserted: return 1;
+    case retained_duplicate: return 2;
+    case destroy: return 4;
+    case matched: return 8;
+    default: return 0;
+    }
+}
+
+class CandidateLifetimes {
+    // Only actual admission creates an entry. Destruction invalidates it before
+    // release. A conflicting duplicate permanently invalidates the retained life.
+    std::mutex mutex_;
+    unsigned installed_{};
+    std::map<Address, RegistrationId> live_;
+    ClaimOrigins origins_;
+public:
+    void installed(Address site) {
+        const auto bit = required_site(site);
+        std::scoped_lock lock{mutex_};
+        installed_ |= bit;
+        origins_.install(site);
+    }
+
+    template<class Regs> void producer(Memory m, Address base, Address site, const Regs& r) {
+        std::scoped_lock lock{mutex_};
+        origins_.observe(m, base, site, r);
+    }
+    template<class Regs> void build(Memory m, Address base, const Regs& r, TheHuntHostPoseV1 pose) {
+        std::scoped_lock lock{mutex_};
+        origins_.build(m, base, r, pose);
+    }
+    template<class Claim> std::optional<TheHuntHostClaimOriginV1> seal(const Claim& claim) {
+        std::scoped_lock lock{mutex_};
+        return origins_.seal(claim);
+    }
+
+    template<class Snapshot>
+    Observation observe(Memory m, Address base, Address site, const Snapshot& r) {
+        Observation result;
+        if (site == submit) {
+            result.row = read_offer(m, base, site, r);
+            return result;
+        }
+        std::scoped_lock lock{mutex_};
+        if (site == destroy) {
+            result.candidate = r.rdi;
+            live_.erase(r.rdi);
+            origins_.invalidate(r.rdi);
+            result.status = "destroyed";
+        } else if (site == inserted) {
+            result.candidate = r.r15;
+            live_.erase(r.r15); // also covers insertion by another native caller
+            origins_.invalidate(r.r15);
+            result.row = read_offer(m, base, site, r);
+            result.status = "unbound";
+            if (installed_ == 15 && result.row && result.row->registration.id) {
+                live_.emplace(r.r15, *result.row->registration.id);
+                result.status = "bound";
+            }
+        } else if (site == retained_duplicate) {
+            result.retained = r.rbx;
+            result.candidate = r.r15;
+            // Remove first, including on an unreadable row or an allocation failure.
+            // Only the same proven registration preserves the existing life.
+            auto old = live_.extract(r.rbx);
+            // A thrown DOM read cannot leave the old pending origin authorized.
+            try {
+                result.row = read_offer(m, base, site, r);
+            } catch (...) {
+                origins_.invalidate(r.rbx);
+                throw;
+            }
+            result.status = "retained_unbound";
+            if (!old.empty()) {
+                const bool same = result.row && result.row->registration.id &&
+                    old.mapped().text() == result.row->registration.id->text();
+                if (same) {
+                    live_.insert(std::move(old));
+                    result.status = "retained_same_registration";
+                } else {
+                    origins_.invalidate(r.rbx);
+                    result.status = "retained_binding_revoked";
+                }
+            }
+        } else if (site == matched) {
+            result.item = r.rsi;
+            Address native_item{};
+            result.status = "unreadable_item";
+            if (!r.rsi || !m.get(r.rcx, 0x10, native_item) || native_item != r.rsi ||
+                !m.get(r.rsi, 0, result.candidate) || !result.candidate ||
+                !m.get(r.rsi, 8, result.prepared) || !result.prepared) {
+                origins_.begin(r.rbp, r.rcx, r.rsi, {});
+                return result;
+            }
+            result.status = installed_ == 15 ? "no_live_registration" : "lifecycle_incomplete";
+            auto current = live_.find(result.candidate);
+            if (installed_ == 15 && current != live_.end()) {
+                TheHuntHostMatchV1 value{};
+                const auto id = current->second.text();
+                std::copy(id.begin(), id.end(), value.registration_id);
+                value.matched_candidate = result.candidate;
+                value.matched_prepared = result.prepared;
+                result.match = value;
+                result.status = "matched_registration";
+            }
+            origins_.begin(r.rbp, r.rcx, r.rsi, result.match);
+        }
+        return result;
+    }
+};
+} // namespace HostDecode
diff --git a/emulator/src/core/host_return.inc b/emulator/src/core/host_return.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/host_return.inc
@@ -0,0 +1,104 @@
+// One receipt for the host's ordinary co-op death load. All addresses belong to
+// this process. No readiness is inferred from elapsed time or a peer's HP.
+struct RepeatHostReturn {
+    enum class Step { Idle, Calling, Entered, Submitted, Acknowledged, Descriptor,
+                      Consumed, Resolved, Born, Published };
+    Step step{Step::Idle};
+    u64 global{}, old_actor{}, descriptor{}, task{}, world{}, actor{};
+    u32 map{};
+    s32 lamp{}, stored_lamp{}, descriptor_lamp{};
+
+    void reset() { *this = {}; }
+    bool pending() const { return step != Step::Idle && step != Step::Published; }
+
+    void begin(u64 global_now, u64 dead_actor, u32 target_map, s32 target_lamp, s32 saved_lamp) {
+        reset();
+        if (!global_now || !dead_actor || !target_map || target_lamp <= 0) return;
+        step = Step::Calling;
+        global = global_now;
+        old_actor = dead_actor;
+        map = target_map;
+        lamp = target_lamp;
+        stored_lamp = saved_lamp;
+    }
+
+    void transition(bool from_this_call, u64 global_now, u64 player, bool request_idle) {
+        if (step == Step::Calling && from_this_call && request_idle &&
+            global_now == global && player == old_actor) {
+            step = Step::Entered;
+        } else {
+            reset();
+        }
+    }
+
+    void submitted(bool accepted) {
+        if (step == Step::Entered && accepted) step = Step::Submitted;
+        else reset();
+    }
+
+    void acknowledge(u64 state, bool active, bool will_clear) {
+        if (!active || !will_clear) return;
+        if (step == Step::Submitted && state == global) step = Step::Acknowledged;
+        else reset();
+    }
+
+    void finalize(u64 value, u32 type, u32 sub, s32 point) {
+        if (step != Step::Acknowledged || !value || type != 3 || sub != 2 ||
+            (point != lamp && point != stored_lamp)) {
+            reset();
+            return;
+        }
+        descriptor = value;
+        descriptor_lamp = point;
+        step = Step::Descriptor;
+    }
+
+    bool needsLocalLamp(u64 value, bool death_source, u32 source_map, s32 source_lamp,
+                        u32 stored_lamp_map) const {
+        return step == Step::Descriptor && value == descriptor && death_source && stored_lamp > 0 &&
+               descriptor_lamp == stored_lamp && source_lamp == stored_lamp && source_map &&
+               source_map == stored_lamp_map && source_lamp != lamp;
+    }
+
+    template<class Bytes>
+    void setDestination(Bytes& bytes) const {
+        static_assert(sizeof(Bytes)==0x7c && sizeof(map)==4 && sizeof(lamp)==4);
+        std::memcpy(bytes.data(), &map, sizeof(map));
+        std::memcpy(bytes.data()+0x78, &lamp, sizeof(lamp));
+    }
+
+    void consume(u64 value, bool source_is_death_load, u32 consumed_map, s32 consumed_lamp) {
+        if (step == Step::Descriptor && value == descriptor && source_is_death_load &&
+            consumed_map == map && consumed_lamp == lamp)
+            step = Step::Consumed;
+        else reset();
+    }
+
+    void resolve(u64 value, u32 target_map, s32 target_lamp, u32 type, u32 sub) {
+        if (step != Step::Consumed || !value || map != target_map || lamp != target_lamp ||
+            type != 3 || sub != 2) {
+            reset();
+            return;
+        }
+        task = value;
+        step = Step::Resolved;
+    }
+
+    void born(u64 birth_task, u64 new_world, u64 new_actor, u32 birth_map, s32 birth_lamp) {
+        if (step != Step::Resolved || birth_task != task || !new_world || !new_actor ||
+            birth_map != map || birth_lamp != lamp) {
+            reset();
+            return;
+        }
+        world = new_world;
+        actor = new_actor;
+        step = Step::Born;
+    }
+
+    bool ready(u64 current_world, u64 current_actor, u32 current_map, bool inserted_and_alive) {
+        if (step != Step::Born || !inserted_and_alive || current_world != world ||
+            current_actor != actor || current_map != map) return false;
+        step = Step::Published;
+        return true;
+    }
+};
diff --git a/emulator/src/core/host_return_runtime.inc b/emulator/src/core/host_return_runtime.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/host_return_runtime.inc
@@ -0,0 +1,263 @@
+// Gameplay uses the actual local death request and a newly published actor.
+// The field recorder supplies the already-validated map task and actor at birth.
+#include "host_return.inc"
+
+namespace RepeatHost {
+struct Binding {
+    u64 room{}, owner{}, membership{}, leave{}, save{};
+    s32 slot{-1};
+    DWORD thread{};
+};
+std::mutex mutex;
+RepeatHostReturn receipt;
+Binding binding;
+bool factory_seen{};
+bool witnessed{};
+s64 started{};
+std::atomic<bool> tracking{};
+u64 death_id{}, wire_token{};
+TheHuntVisibility::Context signed_party;
+thread_local u64 calling{};
+
+void clearLocked() {
+    receipt.reset();
+    binding = {};
+    factory_seen = false;
+    witnessed = false;
+    started = 0;
+    tracking.store(false, std::memory_order_release);
+}
+
+void cancel() {
+    u64 token{};
+    {
+        std::scoped_lock lock{mutex};
+        token = std::exchange(wire_token, 0);
+        signed_party = {};
+        death_id = 0;
+        clearLocked();
+    }
+    if (token) ThRepeatWire::CancelHostDeath(token);
+}
+
+void committed(u64 id) {
+    if (!id) return;
+    {
+        std::scoped_lock lock{mutex};
+        if (death_id == id) return;
+    }
+    cancel();
+    const auto party = ThRepeatWire::Current();
+    const auto token = ThRepeatWire::CaptureHostDeath();
+    if (!token) return;
+    std::scoped_lock lock{mutex};
+    death_id = id;
+    wire_token = token;
+    signed_party = party.room;
+}
+
+// Only the arbiter's granted death request may start this native receipt.
+void start(u64 id) {
+    Binding next;
+    const u64 global = GetGlobalState();
+    const u64 actor = GetLocalPlayerCharacter();
+    if (!id || GetSessionState() != 3 || GetLocalPlayerType() != 0 ||
+        !ReadablePointer(global, 0x1593) || ReadValue<u8>(global, 0x1592) != 1 ||
+        ReadValue<u8>(global, 0x08) || !actor || GetCharacterHp(actor) != 0) return;
+    next.membership = ThRepeatWire::Membership();
+    next.room = BbscMod::RelayAuthRoom();
+    next.owner = BbscMod::RelayAuthOwner();
+    next.thread = GetCurrentThreadId();
+    next.leave = bbsc_leave_event_ms.load();
+    next.slot = ReadValue<s32>(global, 0x1490);
+    if (next.slot < 0 || next.slot > 9 || !BbscMod::RelayAuthPrivate() || !next.room ||
+        !next.owner || next.owner != BbscMod::RelayAuthOwnId()) return;
+    next.save = BbscLoadProtectionRoleEpoch();
+    const u32 map = GetCurrentPackedMap();
+    if (!IsUsablePackedMap(map)) return;
+    const s32 saved_lamp = ReadValue<s32>(global, 0x1528);
+    s32 lamp = saved_lamp;
+    u32 selected_map{};
+    if (BbscHostWipeDestination(id,selected_map,lamp)) {
+        if (selected_map != map || BbscWipeLampMap(lamp) != map || !ResolveLampPoint(lamp)) return;
+    } else if (BbscWipeLampMap(lamp) != map || !ResolveLampPoint(lamp)) {
+        const auto body = ReadCharacterTransform(actor);
+        if (!body || !ResolveNearestLoadedLamp(body->position, &lamp) || BbscWipeLampMap(lamp) != map)
+            return;
+    }
+    std::scoped_lock lock{mutex};
+    if (id != death_id || !wire_token || receipt.pending()) return;
+    receipt.begin(global, actor, map, lamp, saved_lamp);
+    binding = std::move(next);
+    factory_seen = false;
+    witnessed = false;
+    started = SteadyNowMs();
+    tracking.store(true, std::memory_order_release);
+    calling = id;
+}
+
+void returned(u64 id, bool accepted) {
+    if (!id || calling != id) return;
+    calling = 0;
+    std::scoped_lock lock{mutex};
+    if (death_id != id) return;
+    receipt.submitted(accepted);
+    if (!receipt.pending()) clearLocked();
+}
+
+void consume(const GuestRegisterSnapshot& r) {
+    const u64 desc = r.rsi;
+    const bool source = ReadablePointer(r.rsp, 8) &&
+        ReadValue<u64>(r.rsp, 0) == image_base + 0x1929b8f &&
+        r.rbp > 0xd0 && desc == r.rbp - 0xd0 && r.rsp == desc - 0x28;
+    TheHuntVisibility::Context party;
+    struct Change { u64 desc{}, token{}, global{}, membership{}, leave{}, save{}; s32 slot{}; };
+    Change change;
+    {
+        std::scoped_lock lock{mutex};
+        if (!receipt.pending()) return;
+        if (!source || !ReadablePointer(desc,0xa0) || binding.thread != GetCurrentThreadId() ||
+            ReadValue<u32>(desc,0x54) != 3 || ReadValue<u32>(desc,0x58) != 2) {
+            clearLocked(); return;
+        }
+        const u32 map = ReadValue<u32>(desc,0x08);
+        const s32 point = ReadValue<s32>(desc,0x80);
+        if (!receipt.needsLocalLamp(desc,source,map,point,BbscWipeLampMap(receipt.stored_lamp))) {
+            receipt.consume(desc,source,map,point);
+            if (!receipt.pending()) clearLocked();
+            return;
+        }
+        party = signed_party;
+        change = {desc,wire_token,receipt.global,binding.membership,binding.leave,binding.save,binding.slot};
+    }
+    const u64 global = GetGlobalState();
+    TheHuntVisibility::Context current;
+    const bool identity = party.room && party.own == party.owner && party.peers.size()==2 &&
+        BbscMod::RelayAuthVisibilityContext(current) && ThRepeatWire::SameParty(current,party) &&
+        GetSessionState() == 3 && GetLocalPlayerType() == 0 && global == change.global &&
+        ReadablePointer(global,0x1593) && ReadValue<u8>(global,0x1592) == 1 &&
+        ReadValue<s32>(global,0x1490)==change.slot && BbscLoadProtectionRoleEpoch()==change.save &&
+        ThRepeatWire::Membership()==change.membership && u64(bbsc_leave_event_ms.load())==change.leave;
+    // The native death consumer owns this stack descriptor. The signed room lock
+    // spans the one bounded write, and the stored save lamp is never written.
+    const bool applied = identity && BbscMod::RelayAuthUseVisibilityContext(current, [](void* data) {
+        const auto& op = *static_cast<const Change*>(data);
+        std::scoped_lock lock{mutex};
+        if (op.token != wire_token || !wire_token || binding.membership != op.membership ||
+            op.membership != ThRepeatWire::Membership() || op.leave != u64(bbsc_leave_event_ms.load()) ||
+            binding.thread != GetCurrentThreadId() || !ReadablePointer(op.desc,0xa0) ||
+            ReadValue<u32>(op.desc,0x54)!=3 || ReadValue<u32>(op.desc,0x58)!=2 ||
+            ReadValue<s32>(op.global,0x1528)!=receipt.stored_lamp ||
+            !receipt.needsLocalLamp(op.desc,true,ReadValue<u32>(op.desc,8),
+                 ReadValue<s32>(op.desc,0x80),BbscWipeLampMap(receipt.stored_lamp))) return false;
+        auto bytes = ReadValue<std::array<u8,0x7c>>(op.desc,0x08);
+        receipt.setDestination(bytes);
+        if (!WriteValue(op.desc,0x08,bytes)) return false;
+        receipt.consume(op.desc,true,ReadValue<u32>(op.desc,8),ReadValue<s32>(op.desc,0x80));
+        return receipt.step == RepeatHostReturn::Step::Consumed;
+    }, &change);
+    std::scoped_lock lock{mutex};
+    if (change.token != wire_token) return;
+    if (!applied) { clearLocked(); return; }
+    LOG_INFO(Debug,"BBSC repeat: host death descriptor selected current-map lamp {} in {:#x} (stored {})",
+             receipt.lamp,receipt.map,receipt.stored_lamp);
+}
+
+void trace(u64 site, const GuestRegisterSnapshot& r) {
+    if (!tracking.load(std::memory_order_acquire)) return;
+    if (site != DeathReloadRequestOffset && site != 0x194100a &&
+        site != StageWarpDescriptorFinalizeOffset && site != 0x1928680 && site != 0x1938f65)
+        return;
+    if (site == 0x1928680) { consume(r); return; }
+    std::scoped_lock lock{mutex};
+    if (witnessed && site == DeathReloadRequestOffset) { clearLocked(); return; }
+    if (!receipt.pending()) return;
+    if (site == DeathReloadRequestOffset) {
+        const u64 global = GetGlobalState();
+        const bool idle = ReadablePointer(global, 0x09) && !ReadValue<u8>(global, 0x08);
+        receipt.transition(calling && calling == death_id, global, GetLocalPlayerCharacter(), idle);
+    } else if (site == 0x194100a) {
+        if (!ReadablePointer(r.rcx, 0x09) || r.rbp < 0x10198 || !ReadablePointer(r.rbp - 0x198, 1)) {
+            clearLocked();
+            return;
+        }
+        receipt.acknowledge(r.rcx, ReadValue<u8>(r.rcx, 0x08) != 0, ReadValue<u8>(r.rbp - 0x198, 0) != 0);
+    } else if (site == StageWarpDescriptorFinalizeOffset) {
+        if (!ReadablePointer(r.r9, 0x84)) { clearLocked(); return; }
+        receipt.finalize(r.r9, ReadValue<u32>(r.r9, 0x54), ReadValue<u32>(r.r9, 0x58),
+                         ReadValue<s32>(r.r9, 0x80));
+    } else {
+        if (!ReadablePointer(r.r13, 0xd4)) { clearLocked(); return; }
+        receipt.resolve(r.r13, ReadValue<u32>(r.r13, 0x58), ReadValue<s32>(r.r13, 0xd0),
+                        ReadValue<u32>(r.r13, 0xa4), ReadValue<u32>(r.r13, 0xa8));
+    }
+    if (!receipt.pending()) clearLocked();
+}
+
+void factoryEntry() {
+    if (!tracking.load(std::memory_order_acquire)) return;
+    std::scoped_lock lock{mutex};
+    if (receipt.step == RepeatHostReturn::Step::Resolved && !factory_seen) factory_seen = true;
+    else clearLocked();
+}
+
+void birth(u64 task, u64 world, u64 actor, u32 map, s32 lamp) {
+    if (!tracking.load(std::memory_order_acquire)) return;
+    const auto room = BbscMod::RelayAuthRoom();
+    const auto owner = BbscMod::RelayAuthOwner();
+    const auto global = GetGlobalState();
+    const auto leave = u64(bbsc_leave_event_ms.load());
+    const bool local = GetSessionState()==3 && GetLocalPlayerType()==0 && owner && owner==BbscMod::RelayAuthOwnId() &&
+        BbscMod::RelayAuthPrivate() && ReadablePointer(global,0x1593) && ReadValue<u8>(global,0x1592)==1 &&
+        world && ReadValue<u64>(image_base+CandidateLocalStatePointerOffset,0)==world &&
+        ReadablePointer(world,0x68) && actor && ReadValue<u64>(world,0x60)==actor;
+    std::scoped_lock lock{mutex};
+    if (!factory_seen || !local || binding.thread!=GetCurrentThreadId() || room!=binding.room || owner!=binding.owner ||
+        global!=receipt.global || ReadValue<s32>(global,0x1490)!=binding.slot ||
+        ThRepeatWire::Membership()!=binding.membership || leave!=binding.leave) { clearLocked(); return; }
+    receipt.born(task, world, actor, map, lamp);
+    if (!receipt.pending()) clearLocked();
+}
+
+void tick() {
+    if (!tracking.load(std::memory_order_acquire)) return;
+    TheHuntVisibility::Context current;
+    const bool in_room = BbscMod::RelayAuthVisibilityContext(current);
+    const auto known_room = BbscMod::RelayAuthRoom();
+    const u64 actor = GetLocalPlayerCharacter(), global = GetGlobalState();
+    const u32 map = GetCurrentPackedMap();
+    const u64 world = ReadValue<u64>(image_base + CandidateLocalStatePointerOffset, 0);
+    const bool loaded = GetSessionState() == 3 && GetLocalPlayerType() == 0 &&
+        ReadablePointer(global, 0x1593) && ReadValue<u8>(global, 0x1592) == 1 &&
+        !ReadValue<u8>(global, 8) && actor && GetCharacterHp(actor) > 0 &&
+        BbscHostInserted(actor, map);
+    const u64 save_now = BbscLoadProtectionRoleEpoch();
+    u64 token{};
+    s32 lamp{};
+    {
+        std::scoped_lock lock{mutex};
+        if ((in_room && (current.room != binding.room || current.owner != binding.owner || current.own != current.owner)) ||
+            (known_room && known_room != binding.room) ||
+            binding.membership != ThRepeatWire::Membership() || SteadyNowMs() - started >= BbscGuestWaitHostMs ||
+            binding.leave != static_cast<u64>(bbsc_leave_event_ms.load()) ||
+            save_now != binding.save || (global && global != receipt.global)) { clearLocked(); return; }
+        if (!in_room || !loaded || world != receipt.world || actor != receipt.actor || map != receipt.map) return;
+        if (!witnessed) {
+            if (!receipt.ready(world, actor, map, loaded)) return;
+            witnessed = true;
+        }
+        if (ReadValue<s32>(global, 0x1490) != binding.slot) { clearLocked(); return; }
+        token = wire_token;
+        lamp = receipt.lamp;
+    }
+    if (ThRepeatWire::PublishHostReload(token, map, lamp)) {
+        std::scoped_lock lock{mutex};
+        if (token == wire_token) clearLocked();
+        LOG_INFO(Debug, "BBSC repeat: host return witnessed, map {:#x} lamp {} published", map, lamp);
+    }
+}
+} // namespace RepeatHost
+
+void BbscHostWipeCommitted(uint64_t id) { RepeatHost::committed(id); }
+void BbscHostWipeReturnBegin(uint64_t id) { RepeatHost::start(id); }
+void BbscHostWipeReturnEnd(uint64_t id, bool accepted) { RepeatHost::returned(id, accepted); }
