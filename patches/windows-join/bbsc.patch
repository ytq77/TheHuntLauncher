diff --git a/emulator/src/core/origin_queue.inc b/emulator/src/core/origin_queue.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/origin_queue.inc
@@ -0,0 +1,500 @@
+// Include inside ThWipe01, after Site and the recorder interface. C++20.
+namespace queue_detail {
+using U = uint64_t;
+using W = uint32_t;
+using Byte = uint8_t;
+
+struct Key {
+    W type, id, arg, mode;
+    bool operator==(const Key&) const = default;
+};
+static U pack(W lo, W hi) { return U(lo) | (U(hi) << 32); }
+static bool scoped(Key k) {
+    if (k.type == 13 || k.type == 14)
+        return k.id == 99999 && k.arg == 10000 && k.mode == 0;
+    if (k.id != 4000) return false;
+    if (k.type == 15) return (k.arg == 0 && k.mode == 1) ||
+                             ((k.arg == 1 || k.arg == 2) && k.mode == 3);
+    return k.mode == 0 && (k.type == 57 || (k.type == 67 && k.arg == 0));
+}
+static void keyRow(U serial, Key k) { emit("Q_KEY", serial, k.type, k.id, k.arg, k.mode); }
+
+enum Name : W { Unknown, Primary, Hp, Solo, TextWait, First, Final, Party };
+struct Label { const char* text; W length, rva; };
+static constexpr Label labels[] = {
+    {"", 0, 0}, {"OnEvent_4000", 12, 0x492e303}, {"OnEvent_4000_Hp", 15, 0x492e2f3},
+    {"SoloPlayDeath", 13, 0x492e333}, {"SoloPlayDeath_TextWait", 22, 0x492e341},
+    {"SoloPlayDeath_1", 15, 0x492e358}, {"SoloPlayDeath_2", 15, 0x492e368},
+    {"PartyGhostDeath", 15, 0x492e378}
+};
+static Name origin(W type, U pc) {
+    if (type == 14 && pc == 0x137d8ef) return Primary;
+    if (type == 13 && pc == 0x137d91b) return Hp;
+    if (type == 57 && (pc == 0x138169a || pc == 0x138176b || pc == 0x138180c)) return Solo;
+    if (type == 67 && pc == 0x1381ce1) return First;
+    if (type != 15) return Unknown;
+    switch (pc) {
+    case 0x13816c2: case 0x13817c4: case 0x138183c: return Solo;
+    case 0x1381724: return Party;
+    case 0x1381c73: return TextWait;
+    case 0x1381d15: case 0x1381dca: return Final;
+    default: return Unknown;
+    }
+}
+static W helperType(bool command, U pc) {
+    if (pc == (command ? 0x132b3bc : 0x132b2c0)) return 15;
+    if (pc == (command ? 0x133663b : 0x13365bf)) return 57;
+    if (pc == (command ? 0x132ceaf : 0x132ce2d)) return 67;
+    if (pc == (command ? 0x1329cf4 : 0x1329c5e)) return 14;
+    if (pc == (command ? 0x1329ebc : 0x1329e26)) return 13;
+    return 0;
+}
+static U relative(U pc) { return pc >= base && pc - base < 0x56d4000 ? pc - base : 0; }
+struct Pair { U first, second; bool operator==(const Pair&) const = default; };
+struct Node { U next, prev, object; bool operator==(const Node&) const = default; };
+static bool links(U addr, const Node& n) {
+    U back{}, forward{};
+    return n.next && n.prev && n.next != addr && n.prev != addr &&
+           read(n.next + 8, back) && back == addr && read(n.prev, forward) && forward == addr;
+}
+static bool listHeader(U list, Pair& h) {
+    return list && read(list + 8, h) && h.first;
+}
+static bool roots(Pair& root) {
+    return read(base + 0x553b0c8, root.first) && root.first &&
+           read(root.first, root.second) && root.second;
+}
+
+struct Object { Key key; W flags; Name name; U owner; bool operator==(const Object&) const = default; };
+// 0 = unrelated, 1 = candidate, -1 = incomplete read/invalid string layout.
+static int commandInfo(U obj, Object& d) {
+    if (!read(obj, d.key)) return -1;
+    if (!scoped(d.key)) return 0;
+    Pair size{};
+    if (!read(obj + 0x10, d.flags) || !read(obj + 0x30, size) || size.first > size.second) return -1;
+    bool knownLength = false;
+    for (const auto& label : labels) knownLength |= label.length == size.first && label.length != 0;
+    if (!knownLength) return 1; // Same-key command, name outside the allowlist.
+    U p = obj + 0x20;
+    if (size.second >= 16 && (!read(p, p) || !p)) return -1;
+    char text[24]{};
+    const unsigned n = static_cast<unsigned>(size.first) + 1;
+    for (unsigned off = 0;; off = (off + 16 > n ? n - 8 : off + 8)) {
+        U part{};
+        if (!read(p + off, part)) return -1;
+        std::memcpy(text + off, &part, 8);
+        if (off + 8 == n) break;
+    }
+    if (text[n - 1] != 0) return -1;
+    for (W i = 1; i < sizeof(labels) / sizeof(labels[0]); ++i)
+        if (labels[i].length == size.first && std::memcmp(text, labels[i].text, n) == 0)
+            d.name = static_cast<Name>(i);
+    return 1;
+}
+static int conditionInfo(U obj, Object& d) {
+    struct Common { U vt, owner; W id, tag; Byte done, once, pad[6]; } h{};
+    static_assert(sizeof(h) == 0x20 && sizeof(Node) == 0x18);
+    if (!read(obj, h)) return -1;
+    d.owner = h.owner;
+    d.flags = h.done | (W(h.once) << 8);
+    d.key = {h.tag, h.id, 0, 0};
+    const U vt = relative(h.vt);
+    if (vt == 0x531ce40 && h.id == 4000 && h.tag == 0) {
+        W delay{}, direction{};
+        if (!read(obj + 0x28, delay) || !read(obj + 0x40, direction) || !read(obj + 0x44, d.key.mode))
+            return -1;
+        delay &= 0x7fffffff;
+        if (direction != 0 || delay >= 0x40400000) return 0;
+        d.key.type = 15;
+        d.key.arg = (delay >= 0x3f800000) + (delay >= 0x40000000);
+    } else if (vt == 0x531cc10 && h.id == 99999 && (h.tag == 13 || h.tag == 14)) {
+        W mode{};
+        if (!read(obj + 0x20, d.key.arg) || !read(obj + 0x2c, mode)) return -1;
+        if (mode != W(h.tag == 14)) return 0;
+    } else if (vt == 0x531d5c0 && h.id == 4000 && h.tag == 57) {
+        if (!read(obj + 0x20, d.key.arg) || !read(obj + 0x24, d.key.mode)) return -1;
+    } else if (vt == 0x531d340 && h.id == 4000 && h.tag == 67) {
+        if (!read(obj + 0x20, d.key.arg)) return -1;
+    } else return 0;
+    return scoped(d.key) ? 1 : 0;
+}
+
+struct Build { U id, fp, callerFp, pc, event; W type; bool conditionSeen; };
+struct Birth {
+    U id, node, obj, list, head, event, nodeVersion, objVersion, gap;
+    Key key; Name name; bool command;
+};
+struct Send { U id, fp, event; Key key; };
+struct Match {
+    U id, fp, event, send, pick, node, desc, sub, vm, target;
+    U nodeVersion, objVersion, gap;
+    W picks, calls; Key key; Name name; bool pickOK;
+};
+struct State {
+    bool active, conflict, primaryAnchor;
+    U epochValue, event;
+    unsigned builders, matches, births;
+    Build build[8];
+    Match match[8];
+    Birth birth[128];
+    Send pending;
+};
+static constinit thread_local State state{};
+static constinit std::atomic<U> serial{}, nodeVersions[8192]{}, objectVersions[8192]{}, gaps{};
+static_assert(std::atomic<U>::is_always_lock_free);
+static unsigned bucket(U p) { return static_cast<unsigned>(((p >> 3) ^ (p >> 16) ^ (p >> 32)) & 8191); }
+static U next() { return serial.fetch_add(1, std::memory_order_relaxed) + 1; }
+static void clear() {
+    state.active = state.conflict = state.primaryAnchor = false;
+    state.event = state.builders = state.matches = state.births = 0;
+    state.pending = {};
+}
+static bool ready() {
+    if (!roomActive()) { if (state.active) clear(); return false; }
+    U e = epoch();
+    if (!state.active || state.epochValue != e) { clear(); state.epochValue = e; state.active = true; }
+    return true;
+}
+static void remember(U event, bool primary = false) {
+    if (!event) return;
+    if (state.primaryAnchor && !primary) return;
+    if (primary && !state.primaryAnchor) {
+        state.event = event; state.primaryAnchor = true; state.conflict = false;
+        return;
+    }
+    if (state.event && state.event != event && !state.conflict) {
+        state.conflict = true;
+        if (primary) lost("Q_EVENT_AMBIGUOUS");
+    } else if (!state.event) state.event = event;
+}
+static bool current(const Birth& b) {
+    return nodeVersions[bucket(b.node)].load() == b.nodeVersion &&
+           objectVersions[bucket(b.obj)].load() == b.objVersion && gaps.load() == b.gap;
+}
+static bool selectionCurrent(const Match& m) {
+    return nodeVersions[bucket(m.node)].load() == m.nodeVersion &&
+           objectVersions[bucket(m.desc)].load() == m.objVersion && gaps.load() == m.gap;
+}
+// A birth never travels to another thread. Every insertion (including unrelated helpers)
+// advances its two address stamps. Hash collisions discard evidence conservatively.
+static U birthFor(bool cmd, U event, U node, U obj, U list, U head, const Object& info) {
+    for (unsigned i = state.births; i; --i) {
+        const Birth& b = state.birth[i - 1];
+        if (b.command != cmd || b.obj != obj || b.event != event || b.list != list ||
+            b.head != head || (node && b.node != node) || b.key != info.key || b.name != info.name) continue;
+        if (!current(b)) return 0;
+        if (!node) { // EMIT carries a producer, not its scheduler node.
+            Node live{};
+            if (!read(b.node, live) || live.object != obj || !links(b.node, live) || !current(b)) return 0;
+            U before = b.node, at = live.next;
+            for (unsigned n = 0; at != head && n < 128; ++n) {
+                Pair neighbor{};
+                if (!at || !read(at, neighbor) || neighbor.second != before) return 0;
+                before = at; at = neighbor.first;
+            }
+            U tail{};
+            if (at != head || !read(head + 8, tail) || tail != before || !current(b)) return 0;
+        }
+        return b.id;
+    }
+    return 0;
+}
+static void save(const Birth& b) {
+    // A producer register cannot distinguish duplicate live nodes for one object.
+    for (unsigned i = 0; !b.command && i < state.births; ++i) {
+        const Birth& old = state.birth[i];
+        if (!old.command && old.obj == b.obj && old.node != b.node && old.list == b.list &&
+            nodeVersions[bucket(old.node)].load() == old.nodeVersion) {
+            Node n{};
+            if (read(old.node, n) && n.object == b.obj && links(old.node, n)) {
+                lost("Q_LINK_ALIAS"); return; // Old object stamp already revoked.
+            }
+        }
+    }
+    // Reuse revoked slots only. A full table cannot overwrite a live provenance receipt.
+    for (unsigned i = 0; i < state.births; ++i) {
+        if (!current(state.birth[i])) { sources.births.erase(state.birth[i].id); state.birth[i] = b; return; }
+    }
+    if (state.births == 128) { lost("Q_BIRTH_CAP"); return; }
+    state.birth[state.births++] = b;
+}
+// The real VM at 2749180 establishes RBP. Prove its caller and exact frame on
+// the live frame chain. Unwound/stale TLS alone cannot qualify a handler.
+static U vmAt(U event, U cursor) {
+    if (!state.matches) return 0;
+    const Match& m = state.match[state.matches - 1];
+    if (!m.vm || !m.pickOK || !m.name || (event && event != m.event) || m.fp < 0x690) return 0;
+    const U child = m.fp - 0x690;
+    for (unsigned n = 0; cursor && cursor <= child && n < 64; ++n) {
+        Pair frame{};
+        if (!read(cursor, frame) || frame.first <= cursor) return 0;
+        if (cursor == child)
+            return frame.first == m.fp && frame.second == base + 0x139ae34 && selectionCurrent(m) ? m.vm : 0;
+        cursor = frame.first;
+    }
+    return 0;
+}
+
+static void build(W type, const GuestRegisterSnapshot& r) {
+    if (r.rsp < 8) { lost("Q_BUILD_STACK"); return; }
+    U fp = r.rsp - 8;
+    while (state.builders && state.build[state.builders - 1].fp <= fp) --state.builders;
+    if (W(r.rsi) != 4000 || !r.rdi) return;
+    U ret{};
+    if (!read(r.rsp, ret)) { lost("Q_BUILD_RETURN"); return; }
+    U pc = relative(ret);
+    Name name = origin(type, pc);
+    if (!name) return;
+    if ((type == 57 ? r.rcx : r.rdx) != base + labels[name].rva) { lost("Q_BUILD_NAME"); return; }
+    if (state.builders == 8) { state.builders = 0; lost("Q_BUILD_DEPTH"); return; }
+    remember(r.rdi);
+    U id = next();
+    state.build[state.builders++] = {id, fp, r.rbp, pc, r.rdi, type, false};
+    W param = W(type == 57 ? r.rdx : r.rcx);
+    if (type == 15) std::memcpy(&param, r.ymm[0].data(), sizeof(param));
+    emit(type == 15 ? "BUILD15" : type == 57 ? "BUILD57" : "BUILD67",
+         id, r.rdi, pc, r.rsp, name, pack(param, W(r.r8)));
+    emit("Q_BUILD_CONTEXT", id, vmAt(r.rdi, r.rbp), epoch(), windowId(), r.rbp, W(r.rsi));
+}
+static void linked(bool cmd, const GuestRegisterSnapshot& r) {
+    const U node = r.rbx, list = cmd ? r.r15 : r.r14;
+    U obj{};
+    U nv = ++nodeVersions[bucket(node)];
+    if (!node || !read(node + 16, obj) || !obj) { ++gaps; lost("Q_LINK_OBJECT"); return; }
+    U ov = ++objectVersions[bucket(obj)], gap = gaps.load();
+    Pair frame{};
+    if (!read(r.rbp, frame)) { lost("Q_LINK_FRAME"); return; }
+    U helper = relative(frame.second);
+    W type = helperType(cmd, helper);
+    if (!type) return;
+    Pair parent{};
+    if (!frame.first || !read(frame.first, parent)) { lost("Q_LINK_PARENT"); return; }
+    U pc = relative(parent.second);
+    Name expected = origin(type, pc);
+    if (!expected) return;
+    U event{};
+    if (cmd) {
+        if (list < 0x40) { lost("Q_LINK_LIST"); return; }
+        event = list - 0x40;
+    } else { // Parent R13 (15/57) or R15 (67/13/14), saved by this helper.
+        const U offset = type == 15 || type == 57 ? 0x18 : 8;
+        if (r.rbp < offset || !read(r.rbp - offset, event) || !event) { lost("Q_LINK_EVENT"); return; }
+    }
+    Node n{};
+    Pair h{}, root{};
+    Object info{};
+    int decoded = cmd ? commandInfo(obj, info) : conditionInfo(obj, info);
+    if (decoded != 1 || info.key.type != type || (cmd && info.name != expected) ||
+        (!cmd && (!roots(root) || list != root.second + 8 || root.second != info.owner)) ||
+        !listHeader(list, h) || !h.second || !read(node, n) || n.object != obj ||
+        n.next != h.first || node == h.first || !links(node, n)) {
+        emit("Q_LINK_UNKNOWN", cmd, helper, event, list, node, obj);
+        lost("Q_LINK_UNVERIFIED"); return;
+    }
+    remember(event);
+    U builder = 0;
+    while (state.builders && state.build[state.builders - 1].fp < frame.first) --state.builders;
+    if (state.builders) {
+        auto& b = state.build[state.builders - 1];
+        if (b.fp == frame.first && b.callerFp == parent.first && b.pc == pc &&
+            b.event == event && b.type == type) {
+            if (cmd || !b.conditionSeen) builder = b.id;
+            else lost("Q_LINK_REPEAT");
+            if (cmd) --state.builders;
+            else b.conditionSeen = true;
+        }
+    }
+    U id = next();
+    Birth birth{id, node, obj, list, h.first, event, nv, ov, gap, info.key, info.name, cmd};
+    if (!current(birth)) { lost("Q_LINK_CHANGED"); return; }
+    save(birth);
+    emit(cmd ? "COMMAND_LINKED" : "CONDITION_LINKED", id, builder, event, list, node, obj);
+    emit("Q_LINK_META", id, h.first, h.second, pack(info.key.type, info.key.id),
+         pack(info.key.arg, info.key.mode), info.name);
+    emit("Q_LINK_ORIGIN", id, helper, pc, frame.first, info.flags, info.owner);
+}
+
+// Type 15 calls both the sender and the independent equal-key command eraser.
+// Only a suppressed sender can issue a receipt for the second call.
+struct SkippedTimer {
+    U birth{}, frame{}, stack{}, producer{}, event{};
+    Key key{};
+};
+static thread_local SkippedTimer skippedTimer;
+
+static U producerBirth(U event, U producer, Key k) {
+    Object info{};
+    Pair root{}, h{};
+    if (conditionInfo(producer,info) != 1 || info.key != k || !roots(root) ||
+        info.owner != root.second || !listHeader(root.second+8,h)) return 0;
+    return birthFor(false,event,0,producer,root.second+8,h.first,info);
+}
+
+static void timerCleanup(const GuestRegisterSnapshot& r) {
+    const auto t = skippedTimer;
+    if (!t.birth || r.rsp != t.stack || r.rbp != t.frame) return;
+    U ret{};
+    if (!read(r.rsp,ret) || relative(ret) != 0x1300a78) return;
+    skippedTimer = {};
+    const Key key{W(r.rsi),W(r.rcx),W(r.r8),W(r.r9)};
+    if (r.rbx != t.producer || r.rdi != t.event+0x38 || key != t.key ||
+        producerBirth(t.event,t.producer,key) != t.birth) return;
+    auto& call = const_cast<GuestRegisterSnapshot&>(r);
+    call.rax = 0; // The eraser otherwise returns whether it removed any command.
+    call.skip_original = 1;
+}
+
+static void sending(Key k, const GuestRegisterSnapshot& r) {
+    U ret{}, producer{}, birth{};
+    if (!read(r.rsp, ret)) lost("Q_EMIT_RETURN");
+    U pc = relative(ret);
+    if (pc == 0x12fd3ec && (k.type == 13 || k.type == 14)) producer = r.r15;
+    if ((pc == 0x13009e6 && k.type == 15) || (pc == 0x130d297 && k.type == 57) ||
+        (pc == 0x1309dd7 && k.type == 67)) producer = r.rbx;
+    if (pc == 0x13009e6 && k.type == 15) skippedTimer = {};
+    if (producer) {
+        Object info{};
+        Pair root{}, h{};
+        if (conditionInfo(producer, info) == 1 && info.key == k && roots(root) &&
+            info.owner == root.second && listHeader(root.second + 8, h)) {
+            birth = birthFor(false, r.rdi, 0, producer, root.second + 8, h.first, info);
+            remember(r.rdi);
+        } else lost("Q_EMIT_PRODUCER");
+    }
+    if (state.pending.id) lost("Q_EMIT_NO_MATCH");
+    U id = next();
+    state.pending = {id, r.rsp >= 8 ? r.rsp - 8 : 0, r.rdi, k};
+    emit("EMIT", id, r.rdi, pc, producer, birth, r.rbp);
+    const auto condition = sources.get(birth,Kind::Condition);
+    const auto* death = episodes.find(condition.life);
+    const unsigned step = condition.name == Solo ? 0 : condition.name == First ? 1 : 3;
+    if (death && !death->released && (settled(*death) ||
+        (death->id && death->repeat && (death->steps & (1u << step))))) {
+        if (pc == 0x13009e6 && k.type == 15)
+            skippedTimer = {birth,r.rbp,r.rsp,producer,r.rdi,k};
+        state.pending = {};
+        auto& invocation = const_cast<GuestRegisterSnapshot&>(r);
+        invocation.rax = 0;
+        invocation.skip_original = 1;
+    }
+    keyRow(id, k);
+}
+static void enter(Key k, bool selected, const GuestRegisterSnapshot& r) {
+    if (r.rsp < 8) { state.matches = 0; state.pending = {}; lost("Q_MATCH_STACK"); return; }
+    const auto s = state.pending;
+    state.pending = {};
+    if (!selected && s.id) lost("Q_EMIT_NO_MATCH");
+    U fp = r.rsp - 8;
+    if (state.matches && state.match[state.matches - 1].fp <= fp) {
+        state.matches = 0;
+        lost("Q_MATCH_UNWIND");
+    }
+    if (state.matches == 8) { state.matches = 0; state.pending = {}; lost("Q_MATCH_DEPTH"); }
+    if (!selected && !state.matches) return;
+    auto& m = state.match[state.matches++];
+    m = {};
+    m.fp = fp;
+    if (!selected) return; // Mask the outer VM until this unrelated nested matcher exits.
+    Pair entry{};
+    if (!read(r.rsp, entry)) lost("Q_MATCH_ARGUMENT");
+    U pc = relative(entry.first), event = entry.second;
+    bool managerOK = event && r.rdi >= 0x38 && r.rdi - 0x38 == event;
+    if (!managerOK) lost("Q_MATCH_MANAGER");
+    if (pc == 0x133a255) {
+        if (managerOK && s.id && s.fp == r.rbp && s.fp >= 0x78 && r.rsp == s.fp - 0x78 &&
+            s.event == event && s.key == k) m.send = s.id;
+        else lost("Q_MATCH_LOCAL_UNBOUND");
+    } else if (s.id) lost("Q_EMIT_NO_MATCH");
+    m.id = next(); m.event = managerOK ? event : 0; m.key = k;
+    emit("MATCH_ENTER", m.id, m.event, pc, r.rdi, m.send, fp);
+    keyRow(m.id, k);
+}
+static void pick(Match& m, const GuestRegisterSnapshot& r) {
+    if (m.pick) lost("Q_PICK_UNCLOSED");
+    m.pick = next(); m.node = r.rsi; m.desc = r.rax; m.sub = m.vm = m.target = 0;
+    m.nodeVersion = nodeVersions[bucket(m.node)].load();
+    m.objVersion = objectVersions[bucket(m.desc)].load(); m.gap = gaps.load();
+    m.pickOK = false;
+    Object info{};
+    Node n{};
+    Pair h{};
+    if (m.event && m.node && m.desc && read(m.node, n) && n.object == m.desc &&
+        commandInfo(m.desc, info) == 1 && info.key == m.key && links(m.node, n) &&
+        listHeader(m.event + 0x40, h) && h.second && h.first != m.node && selectionCurrent(m)) {
+        m.pickOK = true;
+        m.sub = birthFor(true, m.event, m.node, m.desc, m.event + 0x40, h.first, info);
+    } else lost("Q_PICK_UNVERIFIED");
+    m.name = info.name;
+    ++m.picks;
+    emit("PICK", m.pick, m.id, m.event, m.node, m.desc, m.sub);
+    emit("Q_PICK_META", m.pick, info.name, pack(info.key.type, info.key.id),
+         pack(info.key.arg, info.key.mode), info.flags, m.pickOK);
+}
+static bool vmSlots(const Match& m, const GuestRegisterSnapshot& r, U& def) {
+    U node{}, slot{}, obj{};
+    return m.pick && m.pickOK && r.rbp >= 0x608 && r.r14 == m.event &&
+           read(r.rbp - 0x608, node) && node == m.node &&
+           read(r.rbp - 0x5e8, slot) && slot == node + 0x10 && read(slot, obj) && obj == m.desc &&
+           read(r.rbp - 0x48, def) && selectionCurrent(m);
+}
+static void inside(Site site, const GuestRegisterSnapshot& r) {
+    if (!state.matches) return;
+    auto& m = state.match[state.matches - 1];
+    if (m.fp != r.rbp) { state.matches = 0; lost("Q_MATCH_FRAME"); return; }
+    if (!m.id) { if (site == Site::MATCH_END) --state.matches; return; }
+    if (site == Site::PICK) { pick(m, r); return; }
+    if (site == Site::MATCH_END) {
+        int32_t result = static_cast<int32_t>(r.r13);
+        if (m.pick || (result >= 0 && W(result) != m.picks) || (result < 0 && m.picks))
+            lost("Q_MATCH_COUNT");
+        emit("MATCH_END", m.id, m.event, U(static_cast<int64_t>(result)), m.picks, m.calls, m.send);
+        --state.matches;
+        return;
+    }
+    U def{};
+    bool good = vmSlots(m, r, def);
+    if (site == Site::VM_CALL) {
+        ++m.calls;
+        if (good && !m.vm && def && def == r.rdi) { m.vm = next(); m.target = def; }
+        else { m.vm = 0; m.pickOK = false; lost("Q_VM_CALL_UNBOUND"); }
+        if (m.vm) sources.vm(m.vm,m.id,m.sub,m.name);
+        emit("VM_CALL", m.vm, m.id, m.event, m.pick, m.vm ? m.sub : 0, r.rdi);
+    } else {
+        W result = 0;
+        if (good && m.vm && def == m.target) result = 1;
+        if (good && !m.vm && !def) result = 2;
+        if (!result) lost("Q_VM_EXIT_UNBOUND");
+        emit("VM_END_OR_NULL", result == 1 ? m.vm : 0, m.id, m.event, m.pick, result, def);
+        m.pick = m.vm = m.target = 0; m.pickOK = false;
+    }
+}
+
+} // namespace queue_detail
+uint64_t queueVmAt(uint64_t event, uint64_t guestRbp) {
+    return queue_detail::ready() ? queue_detail::vmAt(event, guestRbp) : 0;
+}
+void queuePoint(Site site, const GuestRegisterSnapshot& r) {
+    using namespace queue_detail;
+    switch (site) {
+    case Site::MATCH_ENTER: case Site::EMIT: {
+        Key k{W(r.rsi), W(r.rdx), W(r.rcx), W(r.r8)};
+        bool selected = scoped(k);
+        if (!selected && (site == Site::EMIT || (!state.matches && !state.pending.id))) return;
+        if (!ready()) return;
+        if (site == Site::MATCH_ENTER) enter(k, selected, r);
+        else sending(k, r);
+        return;
+    }
+    case Site::PICK: case Site::VM_CALL: case Site::VM_END_OR_NULL: case Site::MATCH_END:
+        if (state.matches && ready()) inside(site, r);
+        return;
+    case Site::BUILD15: case Site::BUILD57: case Site::BUILD67:
+        if ((W(r.rsi) == 4000 || state.builders) && ready())
+            build(site == Site::BUILD15 ? 15 : site == Site::BUILD57 ? 57 : 67, r);
+        return;
+    case Site::CONDITION_LINKED: case Site::COMMAND_LINKED:
+        if (ready()) linked(site == Site::COMMAND_LINKED, r);
+        return;
+    default: return;
+    }
+}
