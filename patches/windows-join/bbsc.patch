+// Include once at file scope after the production Core::Bloodborne namespace.
+extern "C" int TheHuntHostRoomCaptureClaim(uint64_t task, uint32_t key, uint64_t buffer,
+                                          uint32_t length, TheHuntHostRoomClaimV1* out) {
+    if (!out) return 0;
+    *out = {};
+    try {
+        if (auto claim = Core::Bloodborne::HostRoomTrace::claim_key(task, key, buffer, length)) {
+            *out = *claim;
+            return 1;
+        }
+    } catch (...) {}
+    return 0;
+}
+extern "C" int TheHuntHostRoomCopyHandoff(const TheHuntHostRoomClaimV1* key, TheHuntHostRoomHandoffV1* out) {
+    if (!out) return 0;
+    try {
+        if (key) {
+            if (auto value = Core::Bloodborne::HostRoomTrace::lookup(*key)) {
+                *out = *value;
+                return 1;
+            }
+        }
+    } catch (...) {}
+    *out = {};
+    return 0;
+}
+extern "C" void TheHuntHostRoomReleaseClaim(const TheHuntHostRoomClaimV1* key) {
+    try { if (key) Core::Bloodborne::HostRoomTrace::release(*key); } catch (...) {}
+}
diff --git a/emulator/src/core/host_room_descriptor.inc b/emulator/src/core/host_room_descriptor.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/host_room_descriptor.inc
@@ -0,0 +1,41 @@
+// Included inside HostRoomTrace. The native serializer and reader use this same field order.
+struct PlatformRoom {
+    u32 world{};
+    u64 room{};
+    bool operator==(const PlatformRoom&) const = default;
+};
+
+std::optional<PlatformRoom> decode(std::span<const u8> bytes, std::uint16_t version) {
+    if (bytes.size() < 15 || bytes.size() > capacity || std::memcmp(bytes.data() + 8, "NXRV", 4) ||
+        (static_cast<unsigned>(bytes[12]) << 8 | bytes[13]) != version) return {};
+    std::size_t pos = 15;
+    auto skip = [&](std::size_t n) {
+        if (n > bytes.size() - pos) return false;
+        pos += n;
+        return true;
+    };
+    auto string16 = [&] {
+        while (skip(2)) if (bytes[pos-2] == 0 && bytes[pos-1] == 0) return true;
+        return false;
+    };
+    for (unsigned n = bytes[14]; n; --n) {
+        if (!skip(6)) return {}; // u32 attribute id, u8 type, u8 flags
+        switch (bytes[pos-2]) {
+        case 1: if (!skip(4)) return {}; break;
+        case 2:
+        case 3: if (!skip(8)) return {}; break;
+        case 4: if (!string16()) return {}; break;
+        default: return {};
+        }
+    }
+    if (!string16() || !skip(16) || !skip(2)) return {}; // name, native fixed-width identity, length
+    if (bytes[pos-2] != 0 || bytes[pos-1] != 16 || bytes.size() - pos != 16) return {};
+    u32 tag{};
+    PlatformRoom out;
+    static_assert(std::endian::native == std::endian::little);
+    std::memcpy(&tag, bytes.data()+pos, 4);
+    std::memcpy(&out.world, bytes.data()+pos+4, 4);
+    std::memcpy(&out.room, bytes.data()+pos+8, 8);
+    if (tag || !out.room) return {};
+    return out;
+}
