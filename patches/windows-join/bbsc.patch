+u64 VerifiedLandingActor() {
+    const auto& k = wait.local;
+    const auto& request = wait.landing;
+    const u64 global = GetGlobalState();
+    const u64 actor = GetLocalPlayerCharacter();
+    const auto party = ThRepeatWire::Current();
+    if (bbsc_pvp_on.load() || !request.ticket || BbscLoadProtectionTicket() != request.ticket ||
+        bbsc_character_reload_generation.load() != request.reload_before + 1 ||
+        BbscMod::RelayAuthRoom() != k.room.id || BbscMod::RelayAuthOwner() != k.room.owner.user ||
+        (party.room.room && party != wait.scope) || ThRepeatWire::Membership() != k.room.epoch || Leaving(k.room) ||
+        BbscLoadProtectionRoleEpoch() != k.role || GetSessionState() != 6 || GetLocalPlayerType() != 1 ||
+        GetCurrentPackedMap() != k.map || global != k.global || !ReadablePointer(global,0x1593) ||
+        ReadValue<u8>(global,0x1592) || ReadValue<s32>(global,0x1490) != k.slot || !actor ||
+        actor == k.actor || (wait.landing_actor && actor != wait.landing_actor) ||
