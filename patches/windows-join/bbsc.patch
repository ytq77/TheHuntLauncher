+bool OwnedCorpse() {
+    if (!wait.episode) return false;
+    if (wait.requested_ms) {
+        const u64 actor = VerifiedLandingActor();
+        if (actor && GetCharacterHp(actor) == 0 && HasLandingTask()) return true;
+    }
+    const auto current = ThRepeatWire::Current();
+    return (!current.room.room || current == wait.scope) &&
+        BbscMod::RelayAuthOwner() == wait.local.room.owner.user &&
+        BbscMod::RelayAuthRoom() == wait.local.room.id && !Leaving(wait.local.room) && GetSessionState() == 6 &&
+        wait.local.room.epoch == ThRepeatWire::Membership() &&
+        wait.local.actor == GetLocalPlayerCharacter() && wait.local.global == GetGlobalState() &&
