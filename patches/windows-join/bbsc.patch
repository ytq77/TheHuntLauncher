+    // Grant time, even when the native actor has not *yet* raised its death bit.
+    if (elapsed < BbscDeadWatchdogMs || (d->selected && d->bodyDone)) return true;
+    if (now >= d->retryAfter) {
+        d->retryAfter = now + BbscLifeSendMs;
+        d->choosing = true;
+        chooseFallback(*d);
+        d->choosing = false;
+    }
+    return true;
+}
+} // namespace ThOrigin
+
+bool BbscHostWipeDestination(uint64_t id,u32& map,s32& lamp) {
+    if (!ThOrigin::onGameThread()) return false;
+    const auto* d = ThOrigin::episodes.find(ThOrigin::episodes.current);
+    if (!d || !id || id != d->id || !d->submitted || !d->targetLamp) return false;
+    map = ThOrigin::pair.map;
+    lamp = d->targetLamp;
+    return true;
+}
+
+namespace ThOrigin {
+bool chooseFallback(Death& d) {
+    // Same selector/caller argument as the original SoloPlayDeath_2. No remote
+    // address or previous destination is accepted as a substitute.
+    const auto key = pair;
+    const auto serial = d.serial;
+    const auto g = key.global;
+    if (!g || !BbscRespawnNativeScreenIdle() || BbscWipeStageLoading() ||
+        !ReadablePointer(g,0x1700) || ReadValue<u8>(g,0x1520) || ReadValue<u8>(g,8)) return false;
+    const auto stage = ReadValue<u64>(image_base + 0x0553b130,0);
+    const auto last = ReadValue<s32>(g,0x1528);
+    if (!ReadablePointer(stage,0x10) || !ReadablePointer(ReadValue<u64>(stage,8),0x2a0) ||
+        !ReadablePointer(ReadValue<u64>(image_base+0x05540290,0),0x10) ||
+        !ReadablePointer(ReadValue<u64>(image_base+0x0553d6d0,0),0xf4) ||
+        !ReadablePointer(ReadValue<u64>(g,0x16f8),0x10) ||
+        last < -1 || (last >= 0 && !ReadablePointer(ReadValue<u64>(image_base+0x0553b0c8,0),8)) ||
+        !HasMemoryAccess(g+0x0c,8,MemoryProt::CpuWrite) ||
+        !HasMemoryAccess(g+0x1524,1,MemoryProt::CpuWrite)) return false;
+    const auto oldMap = ReadValue<u32>(g,0x0c);
+    const auto oldPoint = ReadValue<s32>(g,0x10);
+    const auto oldMode = ReadValue<u8>(g,0x1524);
+    using Select = bool PS4_SYSV_ABI (*)(u64,s32);
+    const bool picked = reinterpret_cast<Select>(image_base+SelectSummonedPlacementOffset)(
+        0,999-static_cast<s32>((key.map >> 16) & 255));
+    if (d.serial != serial || episodes.current != serial || key != pair || !currentScope() ||
+        ReadValue<u8>(g,8) || d.bodyVm || d.legacy) return true; // Ownership changed inside selector.
+    const u32 map = ReadValue<u32>(g,0x0c);
+    const s32 point = ReadValue<s32>(g,0x10);
+    const u8 mode = ReadValue<u8>(g,0x1524);
+    if (!picked || !IsUsablePackedMap(map) || ReadValue<s32>(g,0x1528) != last ||
+        !(last >= 0 ? mode == 1 && point == -1 : map == key.map && point >= 0 && mode == oldMode) ||
+        !sameDeadPair(SteadyNowMs())) {
+        const bool a = WriteValue<u32>(g,0x0c,oldMap);
+        const bool b = WriteValue<s32>(g,0x10,oldPoint);
+        const bool c = WriteValue<u8>(g,0x1524,oldMode);
+        if (!(a && b && c)) { d.quarantine = true; LOG_WARNING(Debug,"BBSC repeat: selector rollback incomplete"); }
+        return false;
+    }
+    d.dst = map; d.point = point; d.lamp = last;
+    d.fallback = d.selected = d.bodyDone = true; // Reserve before any wallet operation or re-entry.
+    BbscApplyDeathPenalty("repeat wipe host");
+    return true;
+}
+} // namespace ThOrigin
+
+namespace ThOrigin {
+namespace NativeQueue {
+u64 base{};
+u64 epoch() { return 1; } // Native allocation stamps span actor replacement and loading.
+u64 windowId() { return episodes.current; }
+bool roomActive() { return installed && onGameThread(); }
+template<class T> bool read(u64 address, T& value) {
+    SIZE_T got{};
+    return address >= 0x10000 && ReadProcessMemory(GetCurrentProcess(),
+        reinterpret_cast<const void*>(address), &value, sizeof(T), &got) && got == sizeof(T);
+}
+void lost(const char*) {} // The native reader returns unknown at each failed check.
+void emit(const char* tag,u64 a=0,u64 b=0,u64 c=0,u64 d=0,u64 e=0,u64 f=0) {
+    row(tag,a,b,c,d,e,f);
+}
+#include "origin_pins.inc"
+#include "origin_queue.inc"
+} // namespace NativeQueue
+
+u64 activeVm(u64 frame) { return NativeQueue::queueVmAt(0,frame); }
+void native(u64 rva, const GuestRegisterSnapshot& r) {
+    if (!installed || !tracking.load(std::memory_order_acquire)) return;
+    using namespace NativeQueue;
+    if (!onGameThread()) {
+        if (rva == 0x1327add || rva == 0x139b34e) {
+            using namespace NativeQueue::queue_detail;
+            ++nodeVersions[bucket(r.rbx)];
+            U obj{};
+            if (r.rbx && read(r.rbx+16,obj) && obj) ++objectVersions[bucket(obj)];
+            else ++gaps;
+        }
+        return;
+    }
+    if (rva == 0x1a0d48e) { hpWrite(r.rdi,static_cast<s32>(r.rsi)); return; }
+    if (rva == 0x18bcdd7) { hpWrite(r.r12,static_cast<s32>(r.rdx)); return; }
+    if (rva == 0x139a870) { NativeQueue::queue_detail::timerCleanup(r); return; }
+    if (rva == 0x1381fb6) {
+        auto* d = episodes.find(episodes.current);
+        if (d && d->id && r.rbp == d->finalFp && d->bodyVm && d->bodyVm == activeVm(r.rbp))
+            d->bodyDone = true;
+        return;
+    }
+    if (rva == 0x12fd2e0) {
+        localSend = {};
+        if (episodes.current && r.r13 == boundActor && currentScope() && GetCharacterHp(boundActor) == 0 &&
+            ReadValue<s32>(r.r15,0x10) == 99999 && ReadValue<s32>(r.r15,0x14) == 14 &&
+            ReadValue<s32>(r.r15,0x20) == 10000 && ReadValue<s32>(r.r15,0x2c) == 1 &&
+            ReadValue<s32>(r.r15,0x38) == -1 && r.r14 && r.rbp)
+            localSend = {r.rbp,r.r14,r.r15,episodes.current};
+        return;
+    }
+    if (rva == 0x1381458) {
+        const auto vm = NativeQueue::queueVmAt(r.r14,r.rbp);
+        auto src = sources.get(vm,Kind::Vm);
+        auto* d = episodes.find(src.life);
+        if (d && d->serial == episodes.current && src.name == 1 && !d->primary)
+            d->primary = vm;
+        return;
+    }
+    for (auto& p : pins) if (p.offset == rva) { queuePoint(p.site,r); return; }
+}
+struct HookPin { u64 rva; std::span<const u8> bytes; bool live{}; std::array<u8,16> jump{}; };
+std::vector<HookPin> hookPins;
+void diagnostic(u64 rva, const GuestRegisterSnapshot* r);
+void PS4_SYSV_ABI hook(u64 rva, const GuestRegisterSnapshot* r) {
+    if (r) native(rva,*r);
+    diagnostic(rva,r);
+}
+bool hooked(u64 rva) {
+    for (const auto& p : hookPins) if (p.rva == rva) return p.live;
+    return false;
+}
+bool agrees(u64 rva, std::span<const u8> expected) {
+    for (const auto& p : hookPins) if (p.rva == rva && p.live)
+        return expected.size() == p.bytes.size() &&
+            !std::memcmp(expected.data(),p.bytes.data(),expected.size()) &&
+            !std::memcmp(reinterpret_cast<const void*>(image_base+rva),p.jump.data(),expected.size());
+    return false;
+}
+unsigned stepMask{};
+void install() {
+    if (!image_base || !BbscSpectateEnabled() || !hookPins.empty() || stepMask != 7) return;
+    NativeQueue::base = image_base;
+    for (const auto& p : NativeQueue::pins) {
+        if (p.site != NativeQueue::Site::ACCEPT && p.site != NativeQueue::Site::PRIMARY_SEND &&
+            (p.site < NativeQueue::Site::BUILD15 || p.site > NativeQueue::Site::MATCH_END)) continue;
+        hookPins.push_back({p.offset,{p.bytes.data(),p.count}});
+    }
+    static constexpr u8 afterHp[]{0x80,0xb8,0x6f,0x17,0,0,0};
+    static constexpr u8 finalExit[]{0x48,0x83,0xc4,0x08,0x5b};
+    static constexpr u8 cleanupEntry[]{0x55,0x48,0x89,0xe5,0x41,0x57};
+    hookPins.push_back({0x1a0d48e,afterHp});
+    hookPins.push_back({0x18bcdd7,afterHp});
+    hookPins.push_back({0x1381fb6,finalExit});
+    hookPins.push_back({0x139a870,cleanupEntry});
+    for (const auto& p : hookPins) {
+        if (p.rva + p.bytes.size() > MemoryPatcher::g_eboot_image_size ||
+            !HasMemoryAccess(image_base + p.rva,p.bytes.size(),MemoryProt::CpuRead) ||
+            std::memcmp(reinterpret_cast<const void*>(image_base+p.rva),p.bytes.data(),p.bytes.size())) return;
+    }
+    for (auto& p : hookPins) {
+        p.live = InstallGuestCodeHook(reinterpret_cast<void*>(image_base+p.rva),p.bytes,p.rva,hook);
+        if (!p.live) return;
+        std::memcpy(p.jump.data(),reinterpret_cast<const void*>(image_base+p.rva),p.bytes.size());
+    }
+    installed = true;
+    LOG_INFO(Debug,"BBSC repeat host origin: ready ({} pins, step mask {})",hookPins.size(),stepMask);
+}
+} // namespace ThOrigin
