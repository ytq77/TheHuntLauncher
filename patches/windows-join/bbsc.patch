+bool HoldLanding(s64 now) {
+    const auto& k = wait.local;
+    const auto& request = wait.landing;
+    const u64 room = BbscMod::RelayAuthRoom();
+    const u32 owner = BbscMod::RelayAuthOwner();
+    const u64 generation = bbsc_character_reload_generation.load();
+    if ((room && room != k.room.id) || (owner && owner != k.room.owner.user) ||
+        generation > request.reload_before + 1 || BbscLoadProtectionRoleEpoch() != k.role ||
+        (request.ticket && BbscLoadProtectionTicket() != request.ticket)) {
+        Retire();
+        return true;
+    }
+    if (BbscWipeStageLoading()) return true;
+    if (now - wait.requested_ms >= BbscLoadCoverLimitMs) {
+        LOG_WARNING(Debug, "BBSC repeat guest: accepted follow ended without a verified landing (episode {})", wait.episode);
+        Retire();
+        return true;
+    }
+    const u64 actor = VerifiedLandingActor();
+    if (!actor) return true;
+    const s32 hp = GetCharacterHp(actor);
+    if (hp < 0) return true;
+    if (hp == 0) {
