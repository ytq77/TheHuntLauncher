+bool native_platform(const HostDecode::Memory& m, u64 descriptor, PlatformRoom expected) {
+    u64 data{}, len{}, room{};
+    u32 tag{}, world{};
+    return descriptor >= 0x10000 && m.get(descriptor, 0x68, data) && data >= 0x10000 &&
+        m.get(descriptor, 0x70, len) && len == 16 && m.get(data, 0, tag) && !tag &&
+        m.get(data, 4, world) && m.get(data, 8, room) && PlatformRoom{world, room} == expected;
+}
