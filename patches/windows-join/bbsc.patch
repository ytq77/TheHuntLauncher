+        GetLocalPlayerType() != 0 || !IsUsablePackedMap(map) || !Boot()) return 0;
+    std::unique_lock lock{mutex};
+    if (s.epoch != Membership()) return 0;
+    if (s != host.scope || (!host.down && !host.before_first)) host = {s};
+    if (host.token) return host.token;
+    host.token = ++serial;
+    host.before_first = !host.down;
+    host.map = map;
+    host.captured = SteadyNowMs();
+    const auto token = host.token;
+    lock.unlock();
+    ThGuestInsert::Capture(token);
+    return token;
+}
+
+bool PublishHostReload(u64 token, u32 map, s32 lamp) {
+    const auto s = Current();
+    const auto now = SteadyNowMs();
+    if (!token || !map || GetSessionState() != 3 || GetLocalPlayerType() != 0 ||
+        GetCurrentPackedMap() != map || BbscWipeLampMap(lamp) != map) return false;
+    std::unique_lock lock{mutex};
+    // Latch the native completion even during a roster freshness gap. Receive
+    // can publish it on the wire only with a fresh, matching signed context.
+    if (IsLeaving() || (s.room.room && s != host.scope) || host.scope.epoch != Membership() ||
+        host.scope.room.room != BbscMod::RelayAuthRoom() || host.scope.room.owner != BbscMod::RelayAuthOwner() ||
+        token != host.token || !host.first || !Fresh(host.captured, now) || host.map != map)
+        return false;
+    if (host.published) return host.lamp == lamp;
+    host.published = now;
+    host.lamp = lamp;
+    lock.unlock();
+    ThGuestInsert::Published(token);
+    return true;
+}
+
+void CancelHostDeath(u64 token) {
+    std::scoped_lock lock{mutex};
+    if (token && token == host.token) { host = {}; ThGuestInsert::Cancel(token); }
+}
+void ClearGuest() {
+    std::scoped_lock lock{mutex};
+    guest = {};
+}
+bool Begin(const Scope& s, u64 challenge, u32 death, u32 map, s64 now) {
+    const u64 boot = Boot();
+    if (!boot || !death || !challenge || challenge == Ask || challenge == Done) return false;
+    std::scoped_lock lock{mutex};
+    if (s.epoch != Membership()) return false;
+    guest = {s, challenge, boot, death, map, now};
+    return true;
+}
+
+// Only the game thread sends queries. The authenticated receive callback records
+// the matching reply. Retries carry the same challenge, including after packet loss.
+s32 Query(const Scope& s, s64 now) {
+    V::Frame q;
+    {
+        std::scoped_lock lock{mutex};
+        if (!guest.challenge || s != guest.scope || !Fresh(guest.started, now)) return 0;
+        if (guest.lamp) return guest.lamp;
+        if (guest.sent && now - guest.sent < BbscLifeSendMs) return 0;
+        guest.sent = now;
+        const auto& c = s.room;
+        q = {V::HostQuery, false, c.owner, guest.map, guest.boot, guest.challenge,
+             0, 0, 0, c.room, V::Find(c,c.own)->joined, V::Find(c,c.owner)->joined, guest.death, Ask};
+    }
+    BbscMod::RelayAuthSendVisibility(s.room, V::Encode(q));
+    return 0;
+}
+
+bool Receive(const V::Context& c, u32 sender, std::span<const u8> bytes) {
+    V::Frame f;
+    if (!V::Decode(bytes,f) || (f.observer != Ask && f.observer != Done) ||
+        f.observer == f.challenge) return false;
+    if (IsLeaving() || !V::Allowed(c,f,sender,c.own)) return true;
+    const auto s = Current();
+    if (!s.room.room || !SameParty(s.room,c)) return true;
+    const auto now = SteadyNowMs();
+    V::Frame reply;
+    {
+        std::scoped_lock lock{mutex};
+        if (f.kind == V::HostStatus && f.observer == Done) {
+            if (s == guest.scope && Fresh(guest.started,now) && !guest.lamp &&
+                f.ready && f.challenge == guest.challenge && f.boot == guest.boot &&
+                f.map == guest.map && f.ticket == guest.death && f.role &&
+                f.reload <= 0x7fffffff && BbscWipeLampMap(static_cast<s32>(f.reload)) == f.map)
+                guest.lamp = static_cast<s32>(f.reload);
+            return true;
+        }
+        if (f.kind != V::HostQuery || f.observer != Ask || s != host.scope ||
+            !Fresh(host.published,now) || !Fresh(host.captured,now) || !host.first ||
+            f.map != host.map || f.role < host.first || f.role > host.last) return true;
+        reply = {V::HostStatus, true, sender, host.map, Boot(), f.challenge, f.host,
+                 f.role, static_cast<u64>(host.lamp), c.room, f.target_joined,
+                 f.sender_joined, host.token, Done};
+    }
+    BbscMod::RelayAuthSendVisibility(c, V::Encode(reply));
+    return true;
+}
+} // namespace ThRepeatWire
