+namespace ThGuestInsert {
+// Only the game thread owns this object. Menu/leave and Stage callbacks publish scalars.
+struct Hold {
+    ThHostPair pair;
+    u64 token{}, membership{}, last_up{}, task{}, returned_actor{}, reload{}, stage{};
+    s64 started{};
+    bool deferred{}, retained_line{}, native_present{};
+};
+Hold hold;
+std::atomic<u64> cancelled{}, stages{};
+
+void Cancel(u64 token) { cancelled.store(token); } // Serialized by ThRepeatWire::mutex.
+void NewLoad() { ++stages; }
+
+void Capture(u64 token) {
+    if (!ThOrigin::onGameThread()) return;
+    hold = {};
+    const auto* d = ThOrigin::episodes.find(ThOrigin::episodes.current);
+    if (!token || !d || !d->id || !d->repeat || d->released || !ThOrigin::pair.other_actor) return;
+    hold.pair = ThOrigin::pair; // ThHostPairNow checked the native actor against the signed peer.
+    hold.token = token;
+    hold.membership = ThRepeatWire::Membership();
+    hold.last_up = d->peerUp;
+    hold.started = SteadyNowMs();
+}
+
+void Published(u64 token) {
+    if (!ThOrigin::onGameThread() || !token || token != hold.token || token == cancelled.load()) return;
+    const auto actor = GetLocalPlayerCharacter();
+    const auto& p = hold.pair;
+    if (!actor || actor == p.actor) return;
+    // The original kept-death capture already called RemotePlayerExists (native MemberIdEquals)
+    // with the old world intact. Both field runs subsequently consumed this exact retained receipt.
+    std::scoped_lock lock{bbsc_retained_join_mutex};
+    const auto& kept = bbsc_retained_join;
+    if (!kept.host_reload_ms || kept.host_reload_ms < hold.started || kept.global != p.global ||
+        kept.map != p.map || kept.role != p.role || !ThRepeatWire::SameParty(kept.context,p.room.party)) return;
+    u64 task{};
+    for (const auto& m : kept.members) {
+        if (!m.task) continue;
+        if (task) return; // Multiple retained tasks cannot be attributed to the single guest.
+        task = m.task;
+    }
+    if (!task) return;
+    hold.task = task;
+    hold.returned_actor = actor;
+    hold.reload = bbsc_character_reload_generation.load();
+    hold.stage = stages.load();
+}
+
+void Present(u64 task) {
+    if (ThOrigin::onGameThread() && hold.deferred && !hold.native_present && task == hold.task) {
+        hold.native_present = true;
+        LOG_INFO(Debug, "BBSC repeat insert: member already present during manual deferral, task {:#x}", task);
+    }
+}
+
+void Expire(s64 now) {
+    if (!ThOrigin::onGameThread() || !hold.token) return;
+    if (hold.token == cancelled.load() || (hold.returned_actor && stages.load() != hold.stage)) {
+        hold = {};
+    } else if (now < hold.started || now - hold.started >= BbscReinsertTimeoutMs) {
+        if (hold.deferred) LOG_INFO(Debug, "BBSC repeat insert: deadline reached for task {:#x}, restoring ordinary retry", hold.task);
+        hold = {};
+    }
+}
+
+Decision Check(u64 task, bool from_v8, s64 now) {
+    if (!ThOrigin::onGameThread()) return Decision::Stock;
+    Expire(now);
+    if (!hold.task || hold.task != task) return Decision::Stock;
+    const auto& p = hold.pair;
+    if (GetSessionState() != 3 || GetLocalPlayerType() != 0 ||
+        ThRepeatWire::IsLeaving() || ThRepeatWire::Membership() != hold.membership ||
+        bbsc_relay_selection_generation.load() != p.room.epoch || bbsc_leave_event_ms.load() != p.local_leave_ms ||
+        BbscMod::RelayAuthRoom() != p.room.party.room || BbscMod::RelayAuthOwner() != p.room.party.owner ||
+        GetGlobalState() != p.global || ReadValue<s32>(p.global, 0x1490) != p.slot ||
+        GetCurrentPackedMap() != p.map || BbscLoadProtectionRoleEpoch() != p.role ||
+        GetLocalPlayerCharacter() != hold.returned_actor || bbsc_character_reload_generation.load() != hold.reload) {
+        hold = {};
+        return Decision::Stock;
+    }
+    TheHuntVisibility::Context roster;
+    const bool signed_now = BbscMod::RelayAuthVisibilityContext(roster);
+    if (signed_now && !ThRepeatWire::SameParty(roster,p.room.party)) { hold = {}; return Decision::Stock; }
+    const auto* peer = TheHuntVisibility::Find(p.room.party,p.room.peer);
+    std::array<u8,16> npid{};
+    const bool named = ReadBbscDisplayNpid(task + 0xC8,npid);
+    if (!peer || (named && npid != peer->npid) || (!named && !hold.deferred)) {
+        hold = {};
+        return Decision::Stock;
+    }
+    if (signed_now && named) {
+        std::scoped_lock lock{bbsc_life_mutex};
+        if (originUpRoom == p.room && originUpSerial > hold.last_up && th_host_life.room == p.room &&
+            !th_host_life.dead && th_host_life.received && now >= th_host_life.received &&
+            now - th_host_life.received <= BbscLifeFreshMs) {
+            const bool line = hold.retained_line;
+            if (hold.deferred) LOG_INFO(Debug, "BBSC repeat insert: member {} reported alive, resuming task {:#x}", p.room.peer,task);
+            hold = {};
+            return line ? Decision::Ready : Decision::Stock;
+        }
+    }
+    if (!hold.deferred) LOG_INFO(Debug, "BBSC repeat insert: deferring retained member {} task {:#x} until alive", p.room.peer,task);
+    hold.deferred = true;
+    hold.retained_line |= from_v8;
+    return Decision::Wait;
+}
