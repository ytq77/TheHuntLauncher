+// Included after the composed host and room unit. Both copies have exactly the
+// same publication, retention and ReleaseClaim lifetime under the same lock.
+extern "C" int TheHuntHostMatchCopyForClaim(const TheHuntHostRoomClaimV1* claim,
+                                           TheHuntHostClaimOriginV1* out) {
+    if (!out) return 0;
+    *out = {};
+    if (!claim) return 0;
+    namespace room = Core::Bloodborne::HostRoomTrace;
+    try {
+        std::scoped_lock lock{room::room_mutex};
+        const auto it = room::complete.find(claim->incarnation);
+        if (it == room::complete.end() || it->second.claim != *claim || !it->second.match_origin) return 0;
+        *out = *it->second.match_origin;
+        return 1;
+    } catch (...) { return 0; }
+}
