+}
+bool TakeWatchdog(s64 now) {
+    const auto& e = O::episode;
+    if (!e.id || e.id <= spent || e.veto || !e.evidence.seq || Leaving(e.local.room) ||
+        e.hp != 0 || e.local.actor != GetLocalPlayerCharacter() || GetCharacterHp(e.local.actor) != 0 ||
+        e.local.global != GetGlobalState() || e.local.role != BbscLoadProtectionRoleEpoch() ||
+        e.local.reload != bbsc_character_reload_generation.load() ||
+        e.local.map != GetCurrentPackedMap() || !BbscReverseCoopSession() || bbsc_pvp_on.load()) return false;
+    auto s = ThRepeatWire::Current();
+    if (!s.room.room && e.local.room.epoch == ThRepeatWire::Membership() &&
+        BbscMod::RelayAuthRoom() == e.local.room.id && BbscMod::RelayAuthOwner() == e.local.room.owner.user) {
+        const auto& r = e.local.room;
+        s = {{r.id,r.own.user,r.owner.user,{r.own,r.owner}},r.epoch};
+    }
+    if (s.room.room != e.local.room.id || s.epoch != e.local.room.epoch ||
+        !V::Find(s.room,s.room.own) || !V::Find(s.room,s.room.owner) ||
+        *V::Find(s.room,s.room.own) != e.local.room.own ||
+        *V::Find(s.room,s.room.owner) != e.local.room.owner ||
+        !ThRepeatWire::Begin(s,e.id,e.evidence.seq,e.local.map,now)) return false;
+    spent = e.id;
+    wait = {e.local,s,e.id,0,e.evidence.first,now};
