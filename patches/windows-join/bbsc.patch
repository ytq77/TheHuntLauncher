+    return target.resolved_lamp && target.ticket == wait.landing.ticket && target.global == k.global &&
+        target.actor == k.actor && target.reload == wait.landing.reload_before && target.role == k.role &&
+        target.slot == k.slot && target.map == k.map && target.host_point == wait.certified_lamp &&
+        ThRepeatWire::SameParty(target.context,wait.scope.room);
