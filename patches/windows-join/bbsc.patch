+
+namespace TheHunt::Summon {
+inline constexpr char discovery_header[] = "X-TheHunt-Registration-Discovery";
+inline constexpr char claim_origin_header[] = "X-TheHunt-Claim-Origin";
+
+// A parsed registration borrows the caller's input while the result is in use.
+// The server independently checks its native room and authenticated membership.
+struct ClaimOrigin {
+    std::string_view registration;
+    std::uint64_t room{};
+    std::uint16_t owner_member{};
+    std::uint64_t owner_joined{};
+    std::uint64_t attempt{};
+    std::string_view host_run;
+};
+
+inline bool LowerHex(std::string_view value, std::size_t digits) {
+    return value.size() == digits && std::all_of(value.begin(), value.end(), [](char c) {
+        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+    });
+}
+
+template<class Integer>
+inline bool ParsePositive(std::string_view bytes, Integer& number) {
+    if (bytes.empty() || bytes.front() < '1' || bytes.front() > '9') return false;
+    const auto [next, ec] = std::from_chars(bytes.data(), bytes.data() + bytes.size(), number);
+    return ec == std::errc{} && next == bytes.data() + bytes.size();
+}
+
+inline std::optional<ClaimOrigin> ParseClaimOrigin(std::string_view text) {
+    if (!text.starts_with("1,") || text.size() > 152) return {};
+    text.remove_prefix(2);
+    auto take = [&]() -> std::string_view {
+        const auto comma = text.find(',');
+        if (comma == text.npos) return {};
+        const auto field = text.substr(0, comma);
+        text.remove_prefix(comma + 1);
+        return field;
+    };
+    ClaimOrigin origin{};
+    origin.registration = take();
+    if (!LowerHex(origin.registration, 48) || !ParsePositive(take(), origin.room) ||
+        !ParsePositive(take(), origin.owner_member) || !ParsePositive(take(), origin.owner_joined)) return {};
+    origin.host_run = take();
+    if (!LowerHex(origin.host_run, 32) || !ParsePositive(text, origin.attempt)) return {};
+    return origin;
+}
+
+inline std::optional<std::string> EncodeClaimOrigin(const ClaimOrigin& origin) {
+    if (!LowerHex(origin.registration, 48) || !LowerHex(origin.host_run, 32) ||
+        !origin.room || !origin.owner_member || !origin.owner_joined ||
+        !origin.attempt) return {};
+    std::string text = "1,";
+    text.append(origin.registration);
+    text += ',' + std::to_string(origin.room);
+    text += ',' + std::to_string(origin.owner_member);
+    text += ',' + std::to_string(origin.owner_joined);
+    text += ',';
+    text.append(origin.host_run);
+    text += ',' + std::to_string(origin.attempt);
+    return text;
+}
+} // namespace TheHunt::Summon
diff --git a/emulator/mod/worker01.inc b/emulator/mod/worker01.inc
new file mode 100644
--- /dev/null
+++ b/emulator/mod/worker01.inc
@@ -0,0 +1,84 @@
+/* Inside the private namespace of the fixed 01 bbsc_mod_zh_cn.cpp. */
+enum class StartupPhase01 { Idle, Installing, Ready, Refused };
+SRWLOCK startup_lock01 = SRWLOCK_INIT;
+CONDITION_VARIABLE startup_changed01 = CONDITION_VARIABLE_INIT;
+StartupPhase01 startup_phase01 = StartupPhase01::Idle;
+ThWipeReceipt01 startup_receipt01{};
+bool preflight_only01 = false;
+ULONGLONG startup_deadline01 = 0;
+constexpr DWORD StartupWaitMs01 = 15000;
+
+bool StillInstalling01() {
+    AcquireSRWLockShared(&startup_lock01);
+    const bool active = startup_phase01 == StartupPhase01::Installing &&
+                        GetTickCount64() < startup_deadline01;
+    ReleaseSRWLockShared(&startup_lock01);
+    return active;
+}
+
+bool FinishStartup01(uint32_t stages) {
+    AcquireSRWLockExclusive(&startup_lock01);
+    const bool ready = stages == Th01RequiredStages(startup_receipt01.mode, preflight_only01) &&
+                       startup_phase01 == StartupPhase01::Installing &&
+                       GetTickCount64() < startup_deadline01;
+    if (ready) {
+        startup_receipt01.identity = TH01_ID;
+        startup_receipt01.stages = stages;
+    }
+    startup_phase01 = ready ? StartupPhase01::Ready : StartupPhase01::Refused;
+    WakeAllConditionVariable(&startup_changed01);
+    ReleaseSRWLockExclusive(&startup_lock01);
+    return ready;
+}
+
+int StartWorker01(uint64_t base, uint64_t bytes, uint32_t requested, ThWipeReceipt01* receipt) {
+    if (!receipt) return 0;
+    *receipt = {};
+    const int mode = Th01Mode();
+    const int preflight = Th01Preflight();
+    wchar_t expected[32768];
+    if (mode < 0 || preflight < 0 || requested != Th01RequiredStages(mode, preflight) ||
+        !base || bytes < EbootSize || bytes > 512u * 1024 * 1024 ||
+        base > UINTPTR_MAX - bytes || !Th01PackageModulePath(expected, 32768) ||
+        GetModuleHandleW(expected) != self_module) return 0;
+
+    AcquireSRWLockExclusive(&startup_lock01);
+    if (startup_phase01 != StartupPhase01::Idle) {
+        if (startup_phase01 == StartupPhase01::Installing) {
+            startup_phase01 = StartupPhase01::Refused;
+            WakeAllConditionVariable(&startup_changed01);
+        }
+        ReleaseSRWLockExclusive(&startup_lock01);
+        return 0;
+    }
+    startup_phase01 = StartupPhase01::Installing;
+    startup_receipt01.image_base = base;
+    startup_receipt01.image_bytes = bytes;
+    startup_receipt01.mode = static_cast<uint32_t>(mode);
+    preflight_only01 = preflight == 1;
+    startup_deadline01 = GetTickCount64() + StartupWaitMs01;
+    HANDLE worker = CreateThread(nullptr, 0, Worker, nullptr, 0, nullptr);
+    if (!worker) startup_phase01 = StartupPhase01::Refused;
+    while (startup_phase01 == StartupPhase01::Installing) {
+        const ULONGLONG now = GetTickCount64();
+        if (now >= startup_deadline01) {
+            startup_phase01 = StartupPhase01::Refused;
+        } else if (!SleepConditionVariableSRW(&startup_changed01, &startup_lock01,
+                       static_cast<DWORD>(startup_deadline01 - now), 0) &&
+                   startup_phase01 == StartupPhase01::Installing) {
+            startup_phase01 = StartupPhase01::Refused;
+        }
+    }
+    bool ok = startup_phase01 == StartupPhase01::Ready;
+    ReleaseSRWLockExclusive(&startup_lock01);
+    if (ok && preflight_only01) {
+        const ULONGLONG now = GetTickCount64();
+        DWORD code = 1;
+        const DWORD remaining = now < startup_deadline01 ? static_cast<DWORD>(startup_deadline01 - now) : 0;
+        ok = WaitForSingleObject(worker, remaining) == WAIT_OBJECT_0 &&
+             GetExitCodeThread(worker, &code) && code == 0;
+    }
+    if (worker) CloseHandle(worker);
+    if (ok) *receipt = startup_receipt01;
+    return ok ? 1 : 0;
+}
diff --git a/emulator/src/core/action.inc b/emulator/src/core/action.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/action.inc
@@ -0,0 +1,164 @@
+// CUSA03173 1.09. Included inside ThWipe01 after trace.inc and pins.inc.
+std::atomic<uint64_t> actionActor{}, actionSerial{};
+struct ActionSource { uint64_t scope{}, id{}, actor{}, frame{}; uint32_t sub{}; };
+thread_local ActionSource actionSource;
+
+// Pin all rows (and any loss) of an observation to its entering scope.
+struct ActionScope {
+    uint64_t saved = callbackScope;
+    uint64_t key = saved ? saved : scope.load();
+    ActionScope() { callbackScope = key; }
+    ~ActionScope() {
+        if (key && scope.load() != key) lost("act-scope-changed");
+        callbackScope = saved;
+    }
+    bool local(uint64_t actor) const {
+        return key && running.load() && scope.load() == key && actor && actionActor.load() == actor;
+    }
+};
+uint64_t actionId() { return actionSerial.fetch_add(1,std::memory_order_relaxed) + 1; }
+uint64_t actionPair(uint32_t lo, uint32_t hi) { return uint64_t(hi) << 32 | lo; }
+struct ActionSlot {
+    int32_t clip;
+    uint32_t from, to, period;
+    bool operator==(const ActionSlot&) const = default;
+};
+
+void actionBytes(const char* tag, uint64_t id, uint64_t actor, uint64_t target = 0) {
+    uint64_t meta{}, node{}, control{}, flags{}, check{};
+    uint8_t a{}, b{};
+    if (!read(actor+0x18,meta) || !meta || !read(meta+0x30,node) || !node ||
+        !read(actor+0x58,control) || !control || !read(control+0x38,flags) || !flags ||
+        !read(node+0x18,a) || !read(flags+0x48,b)) { lost("act-byte-read"); return; }
+    if (node+0x18 != flags+0x48 || a != b || (target && target != flags+0x48) ||
+        !read(meta+0x30,check) || check != node || !read(control+0x38,check) || check != flags ||
+        !read(actor+0x18,check) || check != meta || !read(actor+0x58,check) || check != control) {
+        emit("act-byte-raw",id,actor,node+0x18,flags+0x48,actionPair(a,b),target);
+        lost("act-byte-mismatch");
+        return;
+    }
+    emit(tag,id,actor,node+0x18,flags+0x48,actionPair(a,b),target);
+}
+
+// This last-slot view is a sample of the ring, not evidence that a clip ran.
+void actionCheckpoint(const char* tag, uint64_t actor) {
+    if (!roomActive()) return;
+    ActionScope capture;
+    if (!capture.local(actor)) return;
+    const auto id = actionId();
+    emit(tag,id,actor);
+    actionBytes("act-bytes",id,actor);
+    uint64_t mods{}, timeline{}, behaviour{}, controller{};
+    uint8_t enabled{};
+    if (!read(actor+0x3b0,mods) || !mods || !read(mods+0x18,timeline) ||
+        !read(mods+0x30,behaviour) || (behaviour && (!read(behaviour+0x384,enabled) ||
+        !read(behaviour+0x10,controller)))) { lost("act-view-read"); return; }
+    emit("act-view",id,actor,timeline,behaviour,enabled,controller);
+    uint64_t cursors{}, again{};
+    if (!timeline || !read(timeline+0xc0,cursors) ||
+        uint32_t(cursors)>=10 || uint32_t(cursors>>32)>=10) { lost("act-cursors"); return; }
+    const auto index = (uint32_t(cursors)+9)%10;
+    ActionSlot slot{}, verify{};
+    const auto at = timeline+0x20+16*index;
+    if (!read(at,slot) || !read(timeline+0xc0,again) || again!=cursors ||
+        !read(at,verify) || verify!=slot) { lost("act-slot-sample"); return; }
+    emit("act-last-slot",id,cursors,index,uint32_t(slot.clip),actionPair(slot.from,slot.to),slot.period);
+}
+
+uint64_t actionClearBegin(uint64_t actor, uint64_t target) {
+    if (!roomActive()) return 0;
+    ActionScope capture;
+    if (!capture.local(actor)) return 0;
+    if (!target) { lost("act-clear-skipped"); return 0; }
+    const auto id = actionId();
+    actionBytes("act-clear-before",id,actor,target);
+    return id;
+}
+void actionClearEnd(uint64_t id, uint64_t actor, uint64_t target) {
+    if (!id) return;
+    ActionScope capture;
+    if (capture.local(actor)) actionBytes("act-clear-after",id,actor,target);
+}
+
+// Match the native sorted directory lookup at 1a278cf..1a27912. Anchoring
+// only to the most recent slot could give a different animation's clip key.
+bool actionTrack(uint64_t timeline, int32_t clip, uint64_t expected) {
+    uint64_t directory{};
+    struct Index { int32_t count, padding; uint64_t entries; } index{};
+    if (clip==-1 || !expected || !read(timeline+0x10,directory) || !directory ||
+        !read(directory+0x30,index) || !index.entries) return false;
+    int32_t lo=0, hi=index.count;
+    while (lo<hi) {
+        const int32_t mid=lo+(hi-lo)/2;
+        uint64_t entry{}, track{};
+        uint32_t key{};
+        if (!read(index.entries+8*uint64_t(mid),entry) || !entry || !read(entry,key)) return false;
+        if (key==uint32_t(clip)) return read(entry+0x10,track) && track==expected;
+        if (key<uint32_t(clip)) lo=mid+1; else hi=mid;
+    }
+    return false;
+}
+
+void actionPoint(const GuestRegisterSnapshot& r) {
+    if (!r.rbx || r.rbx!=actionActor.load(std::memory_order_relaxed) || !roomActive()) return;
+    ActionScope capture;
+    if (!capture.local(r.rbx)) return;
+    actionSource={};
+    uint32_t sub{};
+    if (!read(r.r14,sub)) { lost("act-parameter"); return; }
+    if (sub!=12 && sub!=47) return;
+    struct Desc {
+        uint32_t type, pad; uint64_t payload;
+        uint32_t from, to; uint8_t start, end; uint8_t padding[6];
+        uint64_t keyframe, group, track;
+    } desc{};
+    struct ActionFrame { uint64_t track, desc, walker, ret; } frame{};
+    struct WalkerFrame { uint64_t index, saved12, timeline, saved15, parent, ret; } walker{};
+    static_assert(sizeof(Desc)==0x38 && offsetof(Desc,start)==0x18);
+    if (!read(r.rsi,desc) || desc.type || desc.payload!=r.r14 || uint8_t(r.rax)!=desc.start ||
+        !read(r.rbp-0x10,frame)) { lost("act-descriptor"); return; }
+    const auto id=actionId();
+    emit("act-desc",id,r.rbx,r.rbp,sub,actionPair(desc.start,desc.end),r.rsi);
+    actionBytes("act-bytes",id,r.rbx);
+    const auto ret=frame.ret-base;
+    const uint64_t offset=ret==0x1a2163c ? 0x68 : ret==0x1a214dc ? 0xe8 : ret==0x1a2159c ? 0xa8 : 0;
+    uint64_t mods{}, timeline{}, dispatch{}, actor{};
+    if (!offset || frame.walker<=r.rbp || frame.walker-r.rbp>0x100000 ||
+        frame.walker-offset!=r.rsi || frame.desc!=r.rsi || frame.track!=desc.track ||
+        !read(frame.walker-0x20,walker) || walker.ret!=base+0x1a27935 || walker.index>=10 ||
+        !read(r.rbx+0x3b0,mods) || !mods || !read(mods+0x18,timeline) || !timeline ||
+        timeline!=walker.timeline || !read(timeline+0x18,dispatch) || dispatch!=r.r15 ||
+        !read(dispatch+0x10,actor) || actor!=r.rbx) { lost("act-source-stack"); return; }
+    const auto at=timeline+0x20+walker.index*16;
+    ActionSlot slot{}, verify{};
+    struct Key { uint32_t start, pad, end; } key{};
+    if (!read(at,slot) || !actionTrack(timeline,slot.clip,desc.track) ||
+        !read(desc.keyframe,key) || !read(at,verify) || slot!=verify) { lost("act-source-clip"); return; }
+    emit("act-clip",id,uint32_t(slot.clip),actionPair(slot.from,slot.to),slot.period,desc.track,walker.index);
+    emit("act-times",id,actionPair(desc.from,desc.to),actionPair(key.start,key.end),desc.keyframe,ret,timeline);
+    actionSource={capture.key,id,r.rbx,r.rbp,sub};
+}
+
+// Reuse BBSC.Persist.SkippedCleanup before its JSON sampling and log limit.
+// The writer saved the action caller's RBX (actor) at its own RBP-0x28.
+void actionMaintenance(const GuestRegisterSnapshot& r) {
+    if (!roomActive()) return;
+    ActionScope capture;
+    uint64_t cleanup{}, actor{};
+    struct Frame { uint64_t parent, ret; } writer{};
+    if (!read(r.rsp,cleanup)) { lost("act-maint-read"); return; }
+    if (cleanup!=base+0x18c4d82 && cleanup!=base+0x18c4dbf) return;
+    if (!read(r.rbp,writer)) { lost("act-maint-frame"); return; }
+    const auto ret=writer.ret-base;
+    const uint32_t sub=ret==0x1a24a7a ? 12 : ret==0x1a25174 ? 47 : 0;
+    if (!sub) { lost("act-maint-source"); return; }
+    if (!read(r.rbp-0x28,actor) || !actor) { lost("act-maint-actor"); return; }
+    if (!capture.local(actor)) return;
+    const auto id=actionId();
+    const auto& source=actionSource;
+    const auto origin=source.scope==capture.key && source.actor==actor &&
+        source.frame==writer.parent && source.sub==sub ? source.id : 0;
+    emit("act-maint",id,origin,actor,writer.parent,cleanup-base,ret);
+    actionBytes("act-bytes",id,actor);
+    if (!origin) lost("act-maint-origin");
+}
