new file mode 100644
--- /dev/null
+++ b/emulator/mod/startup01.h
@@ -0,0 +1,55 @@
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include <wchar.h>
+#include <windows.h>
+
+/* Fixed ABI of the isolated 01 R2 pair. Both binaries use the Windows x64 C ABI. */
+#define TH01_EXPORT "ThWipeStartup01_R2_5a99108_v2"
+#define TH01_ID UINT64_C(0x5448303152320002)
+enum {
+    TH01_BYTE_READBACK = 1u,
+    TH01_REQUIRED_R2 = 2u,
+    TH01_RECORDER = 4u,
+    TH01_PREFLIGHT_ONLY = 8u
+};
+typedef struct {
+    uint64_t identity;
+    uint64_t image_base;
+    uint64_t image_bytes;
+    uint32_t mode;
+    uint32_t stages;
+} ThWipeReceipt01;
+typedef int (*ThWipeStartupFn01)(uint64_t, uint64_t, uint32_t, ThWipeReceipt01*);
+
+static inline int Th01Mode(void) {
+    wchar_t value[2];
+    if (GetEnvironmentVariableW(L"TH_WIPE_OBSERVE_01", value, 2) != 1) return -1;
+    if (value[0] == L'1') return 1;
+    if (value[0] == L'0') return 0;
+    return -1;
+}
+
+static inline int Th01Preflight(void) {
+    wchar_t value[2];
+    SetLastError(ERROR_SUCCESS);
+    DWORD n = GetEnvironmentVariableW(L"TH_WIPE_PREFLIGHT_ONLY", value, 2);
+    if (!n && GetLastError() == ERROR_ENVVAR_NOT_FOUND) return 0;
+    return n == 1 && value[0] == L'1' ? 1 : -1;
+}
+
+static inline uint32_t Th01RequiredStages(int mode, int preflight) {
+    return TH01_BYTE_READBACK | TH01_REQUIRED_R2 | (mode == 1 ? TH01_RECORDER : 0u) |
+           (preflight == 1 ? TH01_PREFLIGHT_ONLY : 0u);
+}
+
+/* Resolve only the installed layout of this pair, independent of cwd or PATH. */
+static inline int Th01PackageModulePath(wchar_t *path, DWORD capacity) {
+    static const wchar_t core_tail[] = L"\\bin\\bb-probe.exe";
+    static const wchar_t dll_tail[] = L"\\mod\\bbsc.dll";
+    DWORD n = GetModuleFileNameW(NULL, path, capacity);
+    const size_t suffix = sizeof(core_tail) / sizeof(*core_tail) - 1;
+    if (n <= suffix || n >= capacity || _wcsicmp(path + n - suffix, core_tail)) return 0;
+    memcpy(path + n - suffix, dll_tail, sizeof(dll_tail));
+    return 1;
+}
