diff --git a/emulator/src/core/host_row_events.inc b/emulator/src/core/host_row_events.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/host_row_events.inc
@@ -0,0 +1,91 @@
+// Pad33 host, included immediately before its existing TraceEntry.
+namespace HostRowTrace {
+using HostDecode::Address;
+HostDecode::CandidateLifetimes lifetimes;
+std::atomic<TheHuntHostMatchCallback> receiver{};
+
+bool copy_current(Address address, void* out, std::size_t count) {
+    std::size_t copied{};
+    return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(address),
+                             out, count, &copied) && copied == count;
+}
+
+void write_registration(std::ostream& out, const HostDecode::Registration& value) {
+    out << ",\"field_status\":\"" << value.status << '"';
+    if (value.id) out << ",\"TheHuntRegistrationId\":\"" << value.id->text() << '"';
+}
+
+template<class Placement>
+void capturePose(const GuestRegisterSnapshot& regs, const Placement& read) noexcept {
+    if (read.prepared != regs.rsi || (read.result != "applied" && read.result != "same_map")) return;
+    const auto& h = read.host;
+    try {
+        lifetimes.build({copy_current}, image_base, regs, {h.packed_region, h.area, h.x, h.y, h.z, h.heading});
+    } catch (...) {}
+}
+
+bool record(const TraceSite& site, const GuestRegisterSnapshot& regs) {
+    switch (site.offset) {
+#define HOST_CLAIM_SITE(name, rva, ...) case rva:
+#include "host_claim_sites.inc"
+#undef HOST_CLAIM_SITE
+    case HostDecode::queue_insert:
+        try { lifetimes.producer({copy_current}, image_base, site.offset, regs); } catch (...) {}
+        return site.offset != HostDecode::queue_insert;
+    }
+    if (site.offset != HostDecode::submit && !HostDecode::required_site(site.offset)) return false;
+    const bool dedicated = site.offset == HostDecode::destroy || site.offset == HostDecode::retained_duplicate;
+    try {
+        const auto event = lifetimes.observe({copy_current}, image_base, site.offset, regs);
+        // Hand off the typed copy before diagnostic IO, outside the lifetime lock.
+        if (event.match) {
+            if (const auto callback = receiver.load(std::memory_order_acquire)) callback(&*event.match);
+        }
+        if (!event.row && !event.status) return dedicated;
+        std::ostringstream out;
+        if (const auto& row = event.row) {
+            out << ",\"row\":";
+            WriteHex(out, row->row);
+            out << ",\"rows_to_end\":" << row->rows_to_end << ",\"wrapper\":";
+            WriteHex(out, row->wrapper);
+            out << ",\"storage\":";
+            WriteHex(out, row->storage);
+            out << ",\"constructed_candidate\":";
+            WriteHex(out, row->candidate);
+            if (row->primary_node) {
+                out << ",\"primary_node\":";
+                WriteHex(out, row->primary_node);
+            }
+            write_registration(out, row->registration);
+        } else if (site.offset != HostDecode::matched) {
+            out << ",\"constructed_candidate\":";
+            WriteHex(out, event.candidate);
+        }
+        if (site.offset == HostDecode::retained_duplicate) {
+            out << ",\"retained_candidate\":";
+            WriteHex(out, event.retained);
+        }
+        if (site.offset == HostDecode::matched) {
+            out << ",\"matched_item\":";
+            WriteHex(out, event.item);
+            out << ",\"matched_candidate\":";
+            WriteHex(out, event.candidate);
+            out << ",\"matched_prepared\":";
+            WriteHex(out, event.prepared);
+            if (event.match) out << ",\"TheHuntRegistrationId\":\"" << event.match->registration_id << '"';
+        }
+        if (event.status) out << ",\"binding_status\":\"" << event.status << '"';
+        const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                            std::chrono::system_clock::now().time_since_epoch()).count();
+        std::scoped_lock lock{capture_mutex};
+        if (!capture_file.is_open()) return dedicated;
+        const auto seq = event_sequence.fetch_add(1, std::memory_order_relaxed) + 1;
+        capture_file << "{\"type\":\"host_decode\",\"seq\":" << seq << ",\"time_ms\":" << ms
+                     << ",\"site\":\"" << site.name << '"' << out.str() << "}\n";
+        capture_file.flush();
+    } catch (...) {
+        // No observer exception may unwind through the game's call frame.
+    }
+    return dedicated;
+}
+} // namespace HostRowTrace
diff --git a/emulator/src/core/observer.inc b/emulator/src/core/observer.inc
new file mode 100644
--- /dev/null
+++ b/emulator/src/core/observer.inc
@@ -0,0 +1,183 @@
+namespace ThWipe01 {
+#include "trace.inc"
+#include "pins.inc"
+#include "../death-queue-01/queue.inc"
+#include "primary.inc"
+#include "action.inc"
+
+std::atomic<uint32_t> stepReceipts{};
+bool allR2Sites{};
+struct Identity {
+    uint64_t room{}, owner{}, world{}, global{}, actor{}, relay{}, leave{}, reload{}, save{};
+    uint32_t map{};
+    int32_t slot{};
+    bool operator==(const Identity&) const = default;
+};
+Identity lastIdentity{};
+uint32_t generation{}, window{};
+int previousHp = -1;
+DWORD frameTid{};
+uint64_t lastBeat{}, lastFrameTick{};
+
+#include "return_observer.inc"
+
+void terminateScope(bool rwSuccessor=false) {
+    if (!rwSuccessor) rwScopeLost();
+    if (scope.load()) emit("scope-end",lastIdentity.actor,lastIdentity.map,window);
+    scope.store(0); actionActor.store(0); previousHp = -1; lastFrameTick = 0; lastBeat = 0;
+}
+void observeFrame(s32 session, u64 global, u64 actor, s32 rawHp) {
+    if (!running.load(std::memory_order_relaxed)) return;
+    // Only the normal game tick may walk the character or scheduler lists.
+    const auto tid = GetCurrentThreadId();
+    if (frameTid && frameTid != tid) { rwScopeLost(); lost("game-thread-changed"); return; }
+    const auto room = BbscMod::RelayAuthRoom();
+    const auto owner = BbscMod::RelayAuthOwner();
+    if (session != 3 || !room || !owner || owner != BbscMod::RelayAuthOwnId() ||
+        !BbscMod::RelayAuthPrivate()) { rwOutside(); terminateScope(); return; }
+    frameTid = tid;
+    rwGameThread.store(tid);
+    uint8_t own{}; int32_t slot{}, verifiedHp{};
+    uint64_t world{}, localActor{}, modules{}, data{}, save{};
+    const auto map = bbsc_tick_map.load();
+    if (!read(global + 0x1592,own) || !read(global + 0x1490,slot) ||
+        !read(base + CandidateLocalStatePointerOffset,world) || !read(world + 0x60,localActor) ||
+        !read(actor + 0x3b0,modules) || !read(modules + 0x20,data) || !read(data + 0xf8,verifiedHp) ||
+        rawHp < 0 || rawHp != verifiedHp || actor != localActor || slot < 0 || slot > 9 ||
+        own != 1 || !IsUsablePackedMap(map) || GetLocalPlayerType() != 0) {
+        rwScopeLost();
+        if (scope.load()) { lost("host-frame-unreadable"); terminateScope(); }
+        return;
+    }
+    {
+        std::unique_lock lock(bbsc_active_save_mutex,std::try_to_lock);
+        if (!lock) { rwScopeLost(); if (scope.load()) { lost("slot-witness-busy"); terminateScope(); } return; }
+        save = bbsc_active_save_generation;
+    }
+    Identity id{room,owner,world,global,actor,bbsc_relay_selection_generation.load(),
+        uint64_t(bbsc_leave_event_ms.load()),bbsc_character_reload_generation.load(),save,map,slot};
+    const auto time = GetTickCount64();
+    const bool rwSuccessor = rwFrame(id, time);
+    if (!scope.load() || lastIdentity != id) {
+        terminateScope(rwSuccessor && rwAdmit());
+        ++generation; window = 0; lastIdentity = id; actionActor.store(actor);
+        scope.store(uint64_t(generation) << 32);
+        emit("scope",actor,map,global,world,slot,id.reload);
+        emit("scope-witness",id.save,id.relay,id.leave);
+    }
+    ++frames;
+    if (lastFrameTick) {
+        const uint64_t gap = time - lastFrameTick;
+        if (gap > maxFrameGap.load()) maxFrameGap.store(gap);
+        if (gap > 500) emit("frame-gap",gap,actor);
+    }
+    lastFrameTick = time;
+    if (rawHp == 0 && previousHp > 0) {
+        ++window;
+        scope.store((uint64_t(generation) << 32) | window);
+        emit("dead",actor,previousHp,map);
+        actionCheckpoint("act-hp-zero",actor);
+        queueSnapshot();
+        if (window == 2) reportAfter.store(time + 27'000);
+    } else if (rawHp > 0 && previousHp == 0) {
+        emit("alive",actor,rawHp,map);
+        actionCheckpoint("act-hp-alive",actor);
+    } else if (!rawHp && previousHp < 0) {
+        lost("first-observation-already-dead");
+    }
+    if (!lastBeat || time - lastBeat >= 400 || previousHp < 0) {
+        if (rawHp==0 && previousHp==0) actionCheckpoint("act-hp-sample",actor);
+        emit("frame",actor,map,uint32_t(rawHp),frames.load(),id.reload,id.save);
+        lastBeat = time;
+    }
+    previousHp = rawHp;
+}
+void takeover(bool repeat, s64 limit) {
+    if (!roomActive()) return;
+    emit("takeover",repeat,limit,lastIdentity.actor);
+    actionCheckpoint("act-takeover",lastIdentity.actor);
+    queueSnapshot();
+    if (window == 2 && reportAfter.load()) reportAfter.store(GetTickCount64() + 22'000);
+}
+void step(unsigned which, bool skip, uint64_t guestFrame) {
+    if (roomActive()) emit(skip ? "step-skipped" : "step",which,queueVmAt(0,guestFrame));
+}
+void kept(uint64_t guestFrame) { if (roomActive()) emit("native-kept",queueVmAt(0,guestFrame)); }
+void stepInstalled(unsigned which) { stepReceipts.fetch_or(1u << which); }
+void peerLife(u32 peer, u8 dead, u32 seq, bool changed) {
+    if (!roomActive()) return;
+    // This is the field mod's accepted life report, not proof of the private
+    // roster by itself. The control also requires the real host-kept branch.
+    emit("peer-life",peer,dead,seq,changed);
+}
+void PS4_SYSV_ABI nativePoint(u64 tag, const GuestRegisterSnapshot* regs) {
+    if (!regs || !running.load(std::memory_order_relaxed)) return;
+    if (tag == static_cast<u64>(Site::RW_PUBLISH)) { rwBirth(*regs); return; }
+    const auto entry = scope.load(std::memory_order_acquire);
+    if (!entry || tag >= std::size(pins)) return;
+    const auto saved = callbackScope;
+    callbackScope = entry;
+    const auto point = pins[tag].site;
+    if (point == Site::ACTION_TYPE0) actionPoint(*regs);
+    else if (point <= Site::FLAG_RESULT || point == Site::PRIMARY_SEND)
+        primaryPoint(point,*regs);
+    else if (point == Site::TIMER57_EVAL) {
+        uint32_t id{};
+        if (!read(regs->rbx + 0x10,id)) lost("timer57-key-read");
+        else if (id == 4000) {
+            struct State { uint32_t a{}, b{}, unused[2]{}, seconds{}; } s;
+            if (!read(regs->rbx + 0x20,s)) lost("timer57-state");
+            else emit("timer57",regs->rbx,regs->r9,s.a,s.b,s.seconds);
+        }
+    } else
+        queuePoint(point,*regs);
+    if (scope.load(std::memory_order_acquire) != entry) lost("scope-changed-in-callback");
+    callbackScope = saved;
+}
+bool start(uint64_t address) {
+    if (!address || image_base != address || !installed || !allR2Sites || stepReceipts.load() != 31 ||
+        !BbscSpectateEnabled()) return false;
+    wchar_t mode[2]{};
+    if (GetEnvironmentVariableW(L"TH_WIPE_OBSERVE_01",mode,2) != 1) return false;
+    if (mode[0] == L'0') return true;
+    if (mode[0] != L'1' || !openTrace()) return false;
+    base = address;
+    // Check every fixed site before installing the first one. The diagnostic
+    // core aborts the process before guest execution if installation is partial.
+    auto refuse = [](const char* why, size_t i) {
+        char line[160];
+        const int n = std::snprintf(line,sizeof(line),"STOP\t%s\t%zu\n",why,i);
+        writeLine(line,n); FlushFileBuffers(traceFile); CloseHandle(traceFile); return false;
+    };
+    if (!ThOrigin::installed) return refuse("origin-unavailable",0);
+    if (!rwMenuReady.load()) return refuse("return-menu-unavailable",0);
+    for (size_t i=0;i<std::size(pins);++i) {
+        const auto& p = pins[i];
+        if (ThOrigin::hooked(p.offset)) {
+            if (!ThOrigin::agrees(p.offset,{p.bytes.data(),p.count})) return refuse("site-bytes",i);
+            continue;
+        }
