+void record(const TraceSite& site, const GuestRegisterSnapshot& regs) noexcept {
+    if (site.offset != allocated && site.offset != update && site.offset != check_wait &&
+        site.offset != queued && site.offset != leave && site.offset != stop) return;
+    try {
+        std::unique_lock lock{room_mutex};
+        const HostDecode::Memory memory{BbscSaveProofRead};
+        if (site.offset == queued) {
+            selection = {};
+            selection.frame = regs.rbp;
+            flight = {};
+            flight.frame = regs.rbp;
+            flight.owner = regs.rbx;
+            return;
+        }
+        if (site.offset == leave) { retire(regs.rdi); return; }
+        if (site.offset == stop) {
+            u64 controller{};
+            if (memory.get(regs.rdi, 0x18, controller)) retire(controller);
+            return;
+        }
+        const u64 manager = GetSummonManager();
+        if (manager < 0x10000 || manager > std::numeric_limits<u64>::max() - 0x140) return;
+        const u64 task = manager + 0x58;
+        if (site.offset == allocated) {
+            // This instruction has not yet stored RAX or copied the caller's bytes.
+            if (regs.r12 != manager) return;
+            if (regs.rax < 0x10000 || regs.r15 < 14 || regs.r15 > capacity ||
+                regs.rax > std::numeric_limits<u64>::max()-(regs.r15-1)) {
+                active_claim.reset(); allocation.reset(); emitted.reset(); selection = {}; flight = {};
+                return;
+            }
+            const Attempt next{task, regs.rax, static_cast<u32>(regs.r13), static_cast<u32>(regs.r15)};
+            allocation = Allocation{next, observe_holder(memory)};
+            allocated_claim(regs, memory, next);
+            emitted.reset(); // also separates genuine allocator reuse of the identical tuple
+            return;
+        }
+
+        const u32 expected_state = site.offset == update ? 2 : 3;
+        Attempt active{};
+        if (regs.rdi != task || !read_active(memory, task, expected_state, active)) return;
+        const bool functional = active_claim && matches(active, active_claim->key) &&
+                                !active_claim->origin.digest.empty();
+        const bool first = emitted != active;
+        if (!functional && !first) return;
+
+        std::array<u8, capacity> bytes{};
+        const bool copied = memory.bytes(active.buffer, 0, bytes.data(), active.length);
+        const bool saw_magic = copied && std::memcmp(bytes.data() + 8, "NXRV", 4) == 0;
+        Attempt after{};
+        if (GetSummonManager() != manager || !read_active(memory, task, expected_state, after) ||
+            after != active) return;
+
+        const std::string digest = copied ? BbscSaveProofHash(std::span{bytes}.first(active.length)) : "";
+        if (digest.empty() && site.offset == update) return; // retry on a later Update or CheckWait
+        const auto handoff = verify_copy(active, digest);
+        if (!first) {
+            lock.unlock();
+            log_handoff(handoff);
+            return;
+        }
+        const auto holder = observe_holder(memory);
+        const bool matched_allocation = allocation && allocation->attempt == active;
+        const bool own = active_claim && matches(active, active_claim->key) && matched_allocation;
+        const auto prior = matched_allocation ? allocation->holder : std::nullopt;
+        const char* comparison = "unavailable";
+        if (prior && prior->controller && holder && holder->controller) {
+            comparison = *prior == *holder ? "same_observed" : "different_observed";
+        }
+
+        std::ostringstream row;
+        row << ",\"site\":\"" << (site.offset == update ? "CSRequestSummon.Update" : "CSRequestSummon.CheckWait")
+            << "\",\"task\":";
+        WriteHex(row, task);
+        row << ",\"selection_key\":";
+        WriteHex(row, active.key);
+        row << ",\"buffer\":";
+        WriteHex(row, active.buffer);
+        row << ",\"native_length\":" << active.length << ",\"copy_status\":\""
+            << (!copied ? "unreadable" : digest.empty() ? "hash_unavailable" : "complete")
+            << "\",\"nxrv_at_8\":" << (!copied ? "null" : saw_magic ? "true" : "false")
+            << ",\"buffer_sha256\":";
+        if (digest.empty()) row << "null";
+        else row << '"' << digest << '"';
+        row << ",\"allocation_seen\":" << (matched_allocation ? "true" : "false") << ",\"at_allocation\":";
+        write_holder(row, prior);
+        row << ",\"at_active\":";
+        write_holder(row, holder);
+        row << ",\"controller_comparison\":\"" << comparison << "\",\"incarnation\":";
+        if (own) row << '"' << active_claim->key.incarnation << '"';
+        else row << "null";
+        row << ",\"descriptor_verified\":" << (own && active_claim->bytes_verified ? "true" : "false")
+            << ",\"create_callback_bound\":"
+            << (own && complete.contains(active_claim->key.incarnation) ? "true" : "false");
+        emitted = active;
+        lock.unlock();
+        log_handoff(handoff);
+        log_row("host_room_evidence", row.str());
+    } catch (...) {
+        // A failed diagnostic must not unwind through the guest trace callback.
+    }
+}
