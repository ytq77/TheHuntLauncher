diff --git a/emulator/mod/claim_transport.hpp b/emulator/mod/claim_transport.hpp
new file mode 100644
--- /dev/null
+++ b/emulator/mod/claim_transport.hpp
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <atomic>
+#include <cstdlib>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace TheHunt::Summon {
+
+inline bool BoundClaimsEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("THEHUNT_JOIN_CLAIM_V1");
+        return value && std::string_view(value) == "1";
+    }();
+    return enabled;
+}
+
+struct ClaimHeaders {
+    std::string origin;
+    std::string placement;
+};
+
+// The HTTP layer holds this object from CreateRequest through DeleteRequest.
+// Each native creation gets a distinct object even if its integer ID is reused.
+class ClaimRequest {
+public:
+    const ClaimHeaders* headers() const noexcept {
+        return ready_.load(std::memory_order_acquire) ? &headers_ : nullptr;
+    }
+
+private:
+    friend class ClaimCall;
+    ClaimHeaders headers_;
+    std::atomic<bool> ready_{false};
+};
+
+// One synchronous CSRequestSummon serializer invocation on the calling thread.
+// A missing return, nested replacement or multiple request creations cannot
+// publish headers. The network worker may send later on another thread.
+class ClaimCall {
+public:
+    void begin(std::uint64_t frame, std::uint64_t task, std::optional<ClaimHeaders> headers) {
+        *this = {};
+        if (!frame || !task || !headers || headers->origin.empty() || headers->placement.empty()) return;
+        frame_ = frame;
+        task_ = task;
+        headers_ = std::move(*headers);
+    }
+
+    std::shared_ptr<ClaimRequest> created() {
+        if (!frame_) return {};
+        if (request_) {
+            *this = {}; // Two private /request creations in the same invocation are ambiguous.
+            return {};
+        }
+        request_ = std::make_shared<ClaimRequest>();
+        return request_;
+    }
+
+    void returned(std::uint64_t frame, std::uint64_t task) noexcept {
+        if (request_ && frame_ == frame && task_ == task) {
+            request_->headers_ = std::move(headers_);
+            request_->ready_.store(true, std::memory_order_release);
+        }
+        *this = {};
+    }
+
+private:
+    std::uint64_t frame_{};
+    std::uint64_t task_{};
+    ClaimHeaders headers_;
+    std::shared_ptr<ClaimRequest> request_;
+};
+
+ClaimCall& NativeClaimCall() noexcept;
+std::string_view HostRunId() noexcept;
+} // namespace TheHunt::Summon
