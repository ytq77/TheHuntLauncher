<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Hunt Server" Width="1160" Height="800" MinWidth="1000" MinHeight="740"
        Background="#121113" Foreground="#E4DFD4" FontSize="13"
        WindowStartupLocation="CenterScreen" x:Name="MainWindow">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4DFD4"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1F1E22"/><Setter Property="Foreground" Value="#9A958A"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#2E2C31"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#1A191C"/><Setter Property="Foreground" Value="#E4DFD4"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2A251D"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="#242226" BorderThickness="0,0,0,1"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Body" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="#252328" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,30,18,22">
        <StackPanel DockPanel.Dock="Bottom" Margin="6,0">
          <Border Style="{StaticResource Divider}" Margin="0,0,0,16"/>
          <TextBlock Text="iytq" Style="{StaticResource Display}" FontStyle="Italic" FontSize="19" Foreground="#BDB6A6" Margin="0,0,0,10"/>
          <TextBlock Text="服务与游戏独立运行" FontSize="11.5" Foreground="#8F8A7F"/>
          <TextBlock Text="关闭此窗口会停止服务" FontSize="11.5" Foreground="#6F6B64" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="THE HUNT" Style="{StaticResource Display}" FontSize="26" Foreground="#D2BE93" HorizontalAlignment="Center"/>
          <Grid Margin="8,10,8,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Height="1" Background="#5E5340" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="◆" FontSize="7" Foreground="#BBA47A" Margin="8,0"/>
            <Border Grid.Column="2" Height="1" Background="#5E5340" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="本 地 开 服 管 理" FontSize="11" Foreground="#8F8A7F" HorizontalAlignment="Center" Margin="0,9,0,30"/>
          <RadioButton x:Name="ConnectionNav" Content="连接信息" Tag="&#xE71B;" GroupName="ServerNavigation" IsChecked="True" Style="{StaticResource NavigationButton}" Margin="0,0,0,4"/>
          <RadioButton x:Name="AccountsNav" Content="联机账号" Tag="&#xE716;" GroupName="ServerNavigation" Style="{StaticResource NavigationButton}"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,26,32,20" MaxWidth="1200">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Banner}">
        <Grid>
          <Grid.Background><ImageBrush ImageSource="@assets/artwork/banner-hosting.jpg" Stretch="UniformToFill" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0.33,1,0.47"/></Grid.Background>
          <Border Background="{StaticResource BannerShade}"/><Border Background="{StaticResource BannerFloor}"/>
          <StackPanel VerticalAlignment="Center" Margin="30,0"><TextBlock Text="本地开服" Style="{StaticResource PageTitle}"/><TextBlock Text="选择本机地址、启动无缝服务，为每位玩家创建账号。" Style="{StaticResource PageSubtitle}"/></StackPanel>
          <TextBlock x:Name="VersionText" Text="Windows 原生服务" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#A99F8A" FontSize="11.5" Margin="0,14,16,0"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,16">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="● 未启动" VerticalAlignment="Center" Foreground="#A8A397" FontSize="15" Style="{StaticResource Display}"/>
            <TextBlock Text="BBSC 无缝联机" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="监听地址" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#BDB7AA"/>
              <TextBox x:Name="AddressBox" Width="205" Text="127.0.0.1" MaxLength="15" FontFamily="{StaticResource MonoFont}"/>
              <Button x:Name="ChooseAddress" Content="本机地址 ▾" Margin="8,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="StartButton" Content="启动服务" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="14,0,8,0"/>
            <Button Grid.Column="2" x:Name="StopButton" Content="停止服务" IsEnabled="False"/>
          </Grid>
          <TextBlock x:Name="AddressHint" Text="仅限本机连接。双机游玩时，先选择这台电脑的局域网或 VPN 地址。" Foreground="#D9BE8A" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12.5"/>
        </StackPanel>
      </Border>
      <TabControl Grid.Row="2" x:Name="MainTabs"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="连接信息">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock Text="给同伴的连接信息" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ClientHint" Text="填写位置：The Hunt → 游戏与联机。两位玩家使用不同账号，地址填写同一套。" Style="{StaticResource Caption}" Margin="0,8,0,14" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="shadNet 合作服务器" VerticalAlignment="Center" Foreground="#BDB7AA"/><TextBox Grid.Column="1" x:Name="CoopAddress" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                  <Button Grid.Column="2" x:Name="CopyCoop" Content="复制" Margin="10,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="shadNet WebAPI" VerticalAlignment="Center" Foreground="#BDB7AA"/><TextBox Grid.Column="1" x:Name="WebAddress" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                  <Button Grid.Column="2" x:Name="CopyWeb" Content="复制" Margin="10,0,0,0"/>
                </Grid>
                <Grid x:Name="GameRow" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="BBSC 游戏服务器" VerticalAlignment="Center" Foreground="#BDB7AA"/><TextBox Grid.Column="1" x:Name="GameAddress" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                  <Button Grid.Column="2" x:Name="CopyGame" Content="复制" Margin="10,0,0,0"/>
                </Grid>
                <Grid x:Name="RelayRow" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="BBSC Relay" VerticalAlignment="Center" Foreground="#BDB7AA"/><TextBox Grid.Column="1" x:Name="RelayAddress" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                  <Button Grid.Column="2" x:Name="CopyRelay" Content="复制" Margin="10,0,0,0"/>
                </Grid>
                <Button x:Name="CopyAll" Content="复制全部连接信息" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                <TextBlock x:Name="PortHint" Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="联机账号">
          <Border Style="{StaticResource Card}" Margin="0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,14">
                <TextBlock Text="联机账号" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="新建账号前请先启动服务。改名、重置和删除前请停止此模式；每次修改前自动备份数据库。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
              <DataGrid Grid.Row="1" x:Name="AccountGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                        SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" BorderBrush="#2E2C31" BorderThickness="1" Background="#161518" RowHeight="40">
                <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                  <DataGridTextColumn Header="账号" Binding="{Binding Name}" Width="180"/>
                  <DataGridTextColumn Header="邮箱字段" Binding="{Binding Email}" Width="*"/>
                  <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/></DataGrid.Columns>
              </DataGrid>
              <WrapPanel Grid.Row="2" Margin="0,14,0,0" x:Name="AccountButtons">
                <Button x:Name="CreateAccount" Content="新建账号" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
                <Button x:Name="RenameAccount" Content="改名" Margin="0,0,8,6"/>
                <Button x:Name="ResetAccount" Content="重置密码" Margin="0,0,8,6"/>
                <Button x:Name="VerifyAccount" Content="验证密码" Margin="0,0,8,6"/>
                <Button x:Name="DeleteAccount" Content="删除账号" Style="{StaticResource DangerButton}" Margin="0,0,8,6"/>
                <Button x:Name="RefreshAccounts" Content="刷新" Margin="0,0,0,6"/>
              </WrapPanel>
            </Grid>
          </Border>
        </TabItem>
      </TabControl>
      <Border Grid.Row="3" BorderBrush="#29272C" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,16,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="MessageText" Text="选择本机地址，即可开始开服。" TextWrapping="Wrap" Margin="0,0,12,4"/>
            <TextBlock Text="关闭此窗口会停止本窗口启动的服务。" Foreground="#7D7A73" FontSize="11.5"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="CheckUpdates" Content="检查更新" Margin="0,0,8,0"/>
            <Button x:Name="OpenLogs" Content="日志" Margin="0,0,8,0"/>
            <Button x:Name="OpenBackups" Content="备份"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
