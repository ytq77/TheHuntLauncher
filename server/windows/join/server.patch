+// Map, the four IEEE-754 bit patterns, and signed area, as compared by COMP.
+static std::optional<std::array<qint64,6>> ParsePlacement(const QByteArray& text) {
+    if (text.isEmpty() || text.size() > 128) return {};
+    const auto fields = text.split(',');
+    if (fields.size() != 7 || fields[0] != "1") return {};
+    std::array<qint64,6> values;
+    for (int i = 1; i <= 5; ++i) {
+        const auto& field = fields[i];
+        if (field.isEmpty() || field.size() > 8) return {};
+        for (char c : field)
+            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) return {};
+        bool ok = false;
+        const quint32 bits = field.toUInt(&ok,16);
+        if (!ok) return {};
+        if (i == 1) {
+            if (!bits || bits == std::numeric_limits<quint32>::max()) return {};
+        } else if (!std::isfinite(std::bit_cast<float>(bits))) {
+            return {};
+        }
+        values[i-1] = bits;
+    }
+    const auto& area = fields[6];
+    if (area.isEmpty() || area.size() > 11) return {};
+    for (qsizetype i = 0; i < area.size(); ++i) {
+        if (i == 0 && area[i] == '-') continue;
+        if (area[i] < '0' || area[i] > '9') return {};
+    }
+    bool ok = false;
+    values[5] = area.toInt(&ok,10);
+    if (!ok) return {};
+    return values;
